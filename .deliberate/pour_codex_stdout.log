    let t_i = th_temp(ph_i, cf_i);
    let c_i = th_capacity(ph_i, pos[i].w);

    var q_sum = 0.0;
    let xi = pos[i].xyz;
    let base = cell_coord(xi);
    for (var dz = -1; dz <= 1; dz = dz + 1) {
        for (var dy = -1; dy <= 1; dy = dy + 1) {
