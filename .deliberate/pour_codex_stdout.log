    var sdf_mag = 0.0;
    var sdf_mu = params.floor_mu;
    if (params.num_solids > 0u) {
        let hit = solid_union(proposed, phase[i]);
        if (hit.dist < contact) {
            sdf_mag = contact - hit.dist;
            proposed = proposed + sdf_mag * hit.grad;
            sdf_n = hit.grad;
            sdf_mu = hit.friction;
        }
