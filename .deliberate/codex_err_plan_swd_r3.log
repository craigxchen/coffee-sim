  1280	    /// Fine-sweep split around the coarse correction: pre-smooth half the budget (≥1 — the
  1281	    /// residual restriction needs the boundary-spike content absorbed first, see
  1282	    /// pressure.wgsl), post-smooth the rest. Seed-off runs everything as post-smoothing.
  1283	    fn smooth_split(&self) -> (u32, u32) {
  1284	        let pre = if self.coarse_sweeps > 0 && self.fine_sweeps > 0 {
  1285	            (self.fine_sweeps / 2).max(1)
  1286	        } else {
  1287	            0
  1288	        };
  1289	        (pre, self.fine_sweeps - pre)
  1290	    }
