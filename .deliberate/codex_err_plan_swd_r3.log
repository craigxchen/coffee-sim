  1303	    /// Sample per-pass GPU timestamps into the cache that `profile()` returns. Blocks
  1304	    /// (dev/test/periodic only) — the explicit cache point, so the getters never stall.
  1305	    pub fn sample_diagnostics(&mut self) {
  1306	        if let Some(ts) = &self.ts {
  1307	            if ts.count >= 2 {
  1308	                let size = (ts.count as u64) * 8;
  1309	                let slice = ts.readback.slice(0..size);
  1310	                let (tx, rx) = std::sync::mpsc::channel();
  1311	                slice.map_async(wgpu::MapMode::Read, move |r| {
  1312	                    let _ = tx.send(r);
  1313	                });
  1314	                let _ = self.device.poll(wgpu::PollType::Wait {
  1315	                    submission_index: None,
  1316	                    timeout: None,
  1317	                });
  1318	                rx.recv().unwrap().unwrap();
  1319	                let times: Vec<u64> = bytemuck::cast_slice(&slice.get_mapped_range()).to_vec();
  1320	                ts.readback.unmap();
  1321	                let mut passes = Vec::new();
  1322	                for (idx, label) in ts.labels.iter().enumerate() {
  1323	                    let b = times[idx * 2];
  1324	                    let e = times[idx * 2 + 1];
  1325	                    let us = (e.saturating_sub(b)) as f32 * ts.period_ns / 1000.0;
  1326	                    passes.push((label.clone(), us));
  1327	                }
  1328	                self.cached_passes = passes;
  1329	            }
  1330	        }
  1331	        self.sample_brew_diagnostics();
  1332	    }
  1333	
  1334	    /// Refresh the brew metrics (free-water-above-bed → drawdown latch, occupancy proxy) from a
  1335	    /// position/phase snapshot (blocking reads — folded into `sample_diagnostics`). The
  1336	    /// drawdown event latches `sim_time` when the pond above the seeded bed surface first
  1337	    /// drains below a small fraction of its peak; water-only / bed-less scenes never pond, so
  1338	    /// drawdown stays 0. Evenness/yield/TDS remain placeholders (extraction deferred).
  1339	    fn sample_brew_diagnostics(&mut self) {
  1340	        // Read the live particle prefix only (the dormant tail is parked, phase noise-free).
  1341	        let live = (self.water_count + self.solid_count) as usize;
  1342	        if live == 0 {
  1343	            return;
  1344	        }
  1345	        let pos = self.read_positions();
  1346	        let phase = self.read_phases();
  1347	        let n = live.min(pos.len()).min(phase.len());
  1348	        let bed_top = self.bed_top_seed;
  1349	        let mut above = 0u32;
  1350	        let mut max_y_grain = f32::NEG_INFINITY;
  1351	        for i in 0..n {
  1352	            let p = pos[i];
  1353	            if phase[i] == 0 {
  1354	                // Live water carries pos.w (moisture lane) > 0; parked slots are at the corner.
  1355	                if p[3] > 0.0 && p[1] > bed_top {
  1356	                    above += 1;
  1357	                }
  1358	            } else {
  1359	                max_y_grain = max_y_grain.max(p[1]);
  1360	            }
  1361	        }
  1362	        // Occupancy proxy: peak node mass / rest density (the dense-region indicator; cheap,
  1363	        // no extra GPU pass — read from the float grid the last project wrote).
  1364	        let max_occ = self
  1365	            .read_grid_velocities()
  1366	            .iter()
  1367	            .map(|v| v[3])
  1368	            .fold(0.0f32, f32::max)
  1369	            / self.params.extra[0].max(1.0e-6);
  1370	
  1371	        let mut diag = self.cached_diag;
  1372	        diag.free_water_above_bed = above;
  1373	        diag.evenness = 1.0; // placeholder until extraction lands
  1374	        diag.max_occupancy = max_occ;
  1375	        // Drawdown latch: only meaningful on a bedded scene (a real surface above the floor).
  1376	        // Track the peak pond, latch when it first falls below 10% of that peak with grains
  1377	        // present (the pond has drained through/around the bed).
  1378	        if self.solid_count > 0 && max_y_grain.is_finite() {
  1379	            self.pond_peak = self.pond_peak.max(above);
  1380	            if diag.drawdown_time == 0.0
  1381	                && self.pond_peak >= 4
  1382	                && (above as f32) < 0.10 * self.pond_peak as f32
  1383	            {
  1384	                diag.drawdown_time = self.sim_time;
  1385	            }
  1386	        }
  1387	        self.cached_diag = diag;
  1388	    }
