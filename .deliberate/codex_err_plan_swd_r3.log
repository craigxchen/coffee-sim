   131	const FP_SCALE: f32 = 262144.0; // 2^18
   132	// Largest f32 ≤ i32::MAX (2^31 − 1 = 2147483647 is not representable; nearest-below is 2147483520).
   133	const FP_CLAMP: f32 = 2147483520.0;
