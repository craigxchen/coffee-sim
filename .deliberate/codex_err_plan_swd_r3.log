     1	// APIC water transfers (U2): grid_clear → p2g_water → grid_update → g2p_water, once per frame
     2	// (substeps fixed at 1 for now — a CFL-driven substep policy is a later-unit decision; with the
     3	// default cell h = 2·spacing and the velocity cap, v·dt/h ≈ 50/60/2 ≈ 0.42 worst-case).
     4	//
     5	// Update order (the solver's OWN discrete recurrence — tests/twofield_water.rs derives its
     6	// free-fall reference from exactly this):
     7	//   P2G scatters m and m·(v + C·d) at the OLD positions; grid_update divides to velocity;
     8	//   drag_fold (coupling.wgsl, U6 — it owns the grid forces so the exponential drag fold can
     9	//   integrate the gravity source exactly) applies gravity (v_i ← v_i + g·dt on drag-free
    10	//   nodes), the drag pair update, then the boundary conditions; G2P gathers the new particle
    11	//   velocity and advects with it. In free air (no BC active) the per-frame closed form is
    12	//     v ← v + g·dt ;  x ← x + v_new·dt            (semi-implicit Euler)
    13	//   because the B-spline weights partition unity (velocity gather is exact for a uniform field)
    14	//   and Σ_k w_k·x_k = x_p (linear consistency keeps C at zero in a uniform field).
    15	//
    16	// Only the WATER range [0, water_count) is touched here — the U6 solid-mass P2G and the drag
    17	// fold live in coupling.wgsl (KTD-1 phase-range dispatches, no per-particle phase branch).
    18	
    19	// Zero the fixed-point water-field lanes (mass + momentum), the solid-volume lane (U6), and
    20	// the per-cell particle counts for this frame's scatter (cells < nodes, so the node-sized
    21	// dispatch covers both).
    22	@compute @workgroup_size(256)
    23	fn grid_clear(@builtin(global_invocation_id) gid: vec3<u32>) {
    24	    let n = gid.x;
    25	    if (n >= params.grid_dims.w) {
    26	        return;
    27	    }
    28	    atomicStore(&grid_fp[n * 4u + 0u], 0);
    29	    atomicStore(&grid_fp[n * 4u + 1u], 0);
    30	    atomicStore(&grid_fp[n * 4u + 2u], 0);
    31	    atomicStore(&grid_fp[n * 4u + 3u], 0);
    32	    atomicStore(&grid_sfp[n], 0);
    33	    // U5 solid momentum lanes (read only in dynamic mode; clearing is mode-independent).
    34	    atomicStore(&grid_sm[n * 4u + 0u], 0);
    35	    atomicStore(&grid_sm[n * 4u + 1u], 0);
    36	    atomicStore(&grid_sm[n * 4u + 2u], 0);
    37	    atomicStore(&grid_sm[n * 4u + 3u], 0);
    38	    // U9 moisture lanes (read only when absorption is on; cleared unconditionally).
    39	    atomicStore(&grid_moist[n * 2u + 0u], 0);
    40	    atomicStore(&grid_moist[n * 2u + 1u], 0);
    41	    if (n < num_fine_cells()) {
    42	        atomicStore(&cell_cnt[n], 0u);
    43	    }
