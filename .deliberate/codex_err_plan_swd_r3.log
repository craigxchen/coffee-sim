   226	fn xsph(@builtin(global_invocation_id) gid: vec3<u32>) {
   227	    let i = gid.x;
   228	    if (i >= params.particle_count) { return; }
   229	    // Viscosity is a fluid term; grains pass through unchanged (so the vel_smoothed→vel copy in a
   230	    // mixed scene doesn't clobber grain velocities).
   231	    if (phase[i] != PHASE_WATER) {
   232	        vel_smoothed[i] = vel[i];
   233	        return;
   234	    }
   235	    let h = params.h;
   236	    let xi = pos[i].xyz;
   237	    let vi = vel[i].xyz;
   238	    var dv = vec3<f32>(0.0);
   239	    // Per-particle volume V_w = m/ρ₀ normalizes the kernel sum (standard XSPH: Δv = c·Σ (m_j/ρ_j)
   240	    // (v_j−v_i) W). Without it, Σ W_poly6 ∝ 1/h³ grows as the resolution refines, so a fixed xsph_c
   241	    // overshoots (amplifies velocity instead of smoothing it) at fine spacing — a resolution-dependent
   242	    // eruption. With it, Σ V_w·W ≈ 1 (dimensionless), so xsph_c behaves consistently at any spacing.
   243	    let v_w = params.particle_mass / params.rest_density;
   244	
   245	    let base = cell_coord(xi);
   246	    for (var dz = -1; dz <= 1; dz = dz + 1) {
   247	        for (var dy = -1; dy <= 1; dy = dy + 1) {
   248	            for (var dx = -1; dx <= 1; dx = dx + 1) {
   249	                let nc = base + vec3<i32>(dx, dy, dz);
   250	                if (nc.x < 0 || nc.y < 0 || nc.z < 0) { continue; }
   251	                let dims = vec3<i32>(params.grid_dims.xyz);
   252	                if (nc.x >= dims.x || nc.y >= dims.y || nc.z >= dims.z) { continue; }
   253	                let cid = cell_id(nc);
   254	                let lo = cell_start[cid];
   255	                let hi = cell_start[cid + 1u];
   256	                for (var s = lo; s < hi; s = s + 1u) {
   257	                    let j = sorted_indices[s];
   258	                    if (j == i) { continue; }
   259	                    let d = xi - pos[j].xyz;
   260	                    let r = length(d);
   261	                    if (r >= h) { continue; }
   262	                    dv = dv + (vel[j].xyz - vi) * (w_poly6(r, h) * v_w);
   263	                }
   264	            }
   265	        }
   266	    }
   267	    vel_smoothed[i] = vec4<f32>(vi + params.xsph_c * dv, 0.0);
   268	}

