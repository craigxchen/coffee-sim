    46	// Quadratic B-spline scatter of mass + APIC momentum m·(v + C·(x_i − x_p)) via fixed-point
    47	// atomics (order-independent integer sums → bit-deterministic accumulation).
    48	@compute @workgroup_size(256)
    49	fn p2g_water(@builtin(global_invocation_id) gid: vec3<u32>) {
