   287	/// CPU twin of `coupling.wgsl::drag_rate_blended` (KTD-3): Kozeny-Carman packed-bed rate
   288	/// (mirrors `models::permeability` — β = drag_scale/k) blended toward a Wen-Yu-Stokes dilute
   289	/// rate (coefficient 18, voidage correction omitted) below φ_s = 0.2 via the Huilin-Gidaspow
   290	/// arctan transition (slope 262.5 = 150·1.75). The pair-momentum gate pins the WGSL against
   291	/// this twin.
   292	pub fn blended_drag_rate(d: f32, phi_f: f32, drag_scale: f32) -> f32 {
   293	    let phi_s = 1.0 - phi_f;
   294	    let packed = drag_scale / crate::models::permeability::kozeny_carman(d, phi_f).max(1.0e-9);
   295	    let dilute = drag_scale * 18.0 * phi_s / (d * d).max(1.0e-8);
   296	    let psi = (262.5 * (phi_s - 0.2)).atan() / std::f32::consts::PI + 0.5;
   297	    psi * packed + (1.0 - psi) * dilute
   298	}
