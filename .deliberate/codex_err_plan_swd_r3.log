    85	/// Free-fall: a small water block far from any wall matches the solver's own discrete
    86	/// recurrence (derived in the header comment) within the documented f32 budget over 120
    87	/// frames, and is discriminably DIFFERENT from the continuous ½gt² form.
    88	#[test]
    89	fn freefall_matches_discrete_recurrence_not_continuous() {
    90	    let Some(gpu) = GpuContext::new_headless() else {
    91	        eprintln!("twofield_water: no GPU adapter; skipping.");
    92	        return;
    93	    };
    94	    const GRAVITY: [f32; 3] = [0.0, -20.0, 0.0];
    95	    const V0: [f32; 3] = [2.0, 20.0, 0.0]; // up + sideways keeps the excursion bounded (~10 units)
    96	    const FRAMES: u32 = 120;
    97	    let scene = water_scene(
    98	        [-12.0, -12.0, -12.0],
    99	        [12.0, 28.0, 12.0],
   100	        GRAVITY,
   101	        [-1.0, -1.0, -1.0],
   102	        [1.0, 1.0, 1.0], // 3³ block centered at the origin
   103	    );
   104	    let cfg = Config {
   105	        seed_jitter: 0.0, // exact lattice seed: per-particle reference = seed + shared offset
   106	        ..Config::default()
   107	    };
   108	    let mut solver = TwofieldSolver::build(&scene, &Materials::default(), &cfg, &gpu);
   109	    let seed = solver.read_positions();
   110	    assert_eq!(seed.len(), 27, "3³ water block");
   111	    solver.write_velocities_for_test(&vec![[V0[0], V0[1], V0[2], 0.0]; seed.len()]);
   112	
   113	    let input = EmissionInput::default();
   114	    let (v0, g) = (f64v(V0), f64v(GRAVITY));
   115	    for f in 1..=FRAMES {
   116	        solver.step(DT, &input);
   117	        if f % 30 != 0 {
   118	            continue;
   119	        }
   120	        // Every particle shares the same offset/velocity: reference from x0 = 0 is the offset.
   121	        let (dpos, rvel) = freefall_reference([0.0; 3], v0, g, DT as f64, 1, f);
   122	        let pos = solver.read_positions();
   123	        let vel = solver.read_velocities();
   124	        for (i, (p, s)) in pos.iter().zip(&seed).enumerate() {
   125	            // Regime guard: no box clamp may fire, else we'd compare a corrected trajectory.
   126	            for a in 0..3 {
   127	                assert!(
   128	                    p[a] > scene.box_min[a] + 1.0 && p[a] < scene.box_max[a] - 1.0,
   129	                    "f={f} particle {i} left the interior on axis {a}: {}",
   130	                    p[a]
   131	                );
   132	            }
   133	            let expect = [
   134	                s[0] as f64 + dpos[0],
   135	                s[1] as f64 + dpos[1],
   136	                s[2] as f64 + dpos[2],
   137	            ];
   138	            assert_close3(
   139	                xyz(*p),
   140	                expect,
   141	                POS_ABS_TOL,
   142	                REL_TOL,
   143	                &format!("pos f={f} i={i}"),
   144	            );
   145	            assert_close3(
   146	                xyz(vel[i]),
   147	                rvel,
   148	                VEL_ABS_TOL,
   149	                REL_TOL,
   150	                &format!("vel f={f} i={i}"),
   151	            );
   152	        }
   153	    }
   154	
   155	    // Discrimination gap: the observed trajectory must be far (≫ budget) from the continuous
   156	    // ½gt² form — the gap at 120 frames is ½·g·dt²·m ≈ 0.33 sim-units on y.
   157	    let (dpos, _) = freefall_reference([0.0; 3], v0, g, DT as f64, 1, FRAMES);
   158	    let cont = continuous_reference([0.0; 3], v0, g, DT as f64, FRAMES);
   159	    let observed_dy = solver.read_positions()[0][1] as f64 - seed[0][1] as f64;
   160	    assert!(
   161	        (observed_dy - dpos[1]).abs() <= POS_ABS_TOL,
   162	        "matches discrete"
   163	    );
   164	    let gap = (observed_dy - cont[1]).abs();
   165	    assert!(
   166	        gap > 0.1,
   167	        "continuous ½gt² is only {gap} from observed — the test no longer discriminates"
   168	    );
   169	}
   170	
   171	/// P2G round trip (gravity off): the grid totals equal the particle totals — mass to the
   172	/// documented per-contribution rounding bound, momentum likewise — the integer accumulation
   173	/// itself is exact (bit-identical across a reset/rerun, unlike float atomics), and the
   174	/// one-step G2P result pins to the CPU twin.
   175	#[test]
   176	fn p2g_g2p_round_trip_conserves_mass_and_momentum() {
   177	    let Some(gpu) = GpuContext::new_headless() else {
   178	        eprintln!("twofield_water: no GPU adapter; skipping.");
   179	        return;
   180	    };
   181	    let scene = water_scene(
   182	        [0.0; 3], [32.0; 3],
   183	        [0.0; 3], // gravity OFF: grid momentum must equal particle momentum
   184	        [13.0; 3], [18.0; 3], // 6³ randomized (seed_jitter) block, interior
   185	    );
   186	    let cfg = Config::default();
   187	    let mats = Materials::default();
   188	    let mut solver = TwofieldSolver::build(&scene, &mats, &cfg, &gpu);
   189	    // This gate pins the TRANSFER kernels against a pressureless CPU twin (a random interior
   190	    // velocity field is far from divergence-free, so the U3 projection would rightly change
   191	    // it). Zero sweeps make the frame U2-equivalent: the projection applies a zero pressure
   192	    // field. The projection itself is gated in tests/twofield_pressure.rs.
   193	    solver.set_pressure_budget_for_test(4, 0, 0);
   194	    let seed = solver.read_positions();
   195	    let n = seed.len();
   196	    assert_eq!(n, 216);
   197	
   198	    // Seeded random velocities, well under the cap (no scatter clamp may fire here).
   199	    let mut rng = Rng::new(0xA11CE);
   200	    let vels: Vec<[f32; 4]> = (0..n)
   201	        .map(|_| {
   202	            [
   203	                rng.next_f32() * 10.0 - 5.0,
   204	                rng.next_f32() * 10.0 - 5.0,
   205	                rng.next_f32() * 10.0 - 5.0,
   206	                0.0,
   207	            ]
   208	        })
   209	        .collect();
   210	    solver.write_velocities_for_test(&vels);
   211	    solver.step(DT, &EmissionInput::default());
   212	
   213	    // Quantization bound: each particle scatters 27 contributions, each rounded to the nearest
   214	    // count (≤ 0.5 counts of error), so each total lane is within n·27·0.5 counts of the exact
   215	    // value. The SUM itself is exact integer arithmetic — fixed point is what makes that true.
   216	    let bound = n as f64 * 27.0 * 0.5 / FP_SCALE;
   217	    let (mass, mom) = solver.read_grid_mass_momentum();
   218	    let m = mats.particle_mass as f64;
   219	    assert!(
   220	        (mass - n as f64 * m).abs() <= bound,
   221	        "grid mass {mass} vs Σm {} (bound {bound})",
   222	        n as f64 * m
   223	    );
   224	    let mut expect_mom = [0.0f64; 3];
   225	    for v in &vels {
   226	        for a in 0..3 {
   227	            expect_mom[a] += m * v[a] as f64;
   228	        }
   229	    }
   230	    for a in 0..3 {
   231	        assert!(
   232	            (mom[a] - expect_mom[a]).abs() <= bound,
   233	            "grid momentum axis {a}: {} vs {} (bound {bound})",
   234	            mom[a],
   235	            expect_mom[a]
   236	        );
   237	    }
   238	
   239	    // CPU twin pin: the GPU one-step G2P result (gravity off, interior, C₀ = 0) matches the
   240	    // float-exact CPU reference within a budget covering fixed-point quantization + f32.
   241	    let (origin, h, dims) = solver.grid_spec();
   242	    let (cpu_pos, cpu_vel) = cpu_transfer_step(&seed, &vels, origin, h, dims, m, DT as f64);
   243	    let gpos = solver.read_positions();
   244	    let gvel = solver.read_velocities();
   245	    for i in 0..n {
   246	        assert_close3(
   247	            xyz(gpos[i]),
   248	            cpu_pos[i],
   249	            5e-3,
   250	            1e-4,
   251	            &format!("twin pos {i}"),
   252	        );
   253	        assert_close3(
   254	            xyz(gvel[i]),
   255	            cpu_vel[i],
   256	            5e-3,
   257	            1e-4,
   258	            &format!("twin vel {i}"),
   259	        );
   260	    }

