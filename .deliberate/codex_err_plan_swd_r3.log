   165	/// Run `frames` settling steps with zero pour and EVERY-FRAME KE/max|v| sampling. Returns
   166	/// (ke trace, max|v| trace). The pool starts from the seeded zero-velocity rest state.
   167	fn settle_trace(solver: &mut TwofieldSolver, frames: usize) -> (Vec<f64>, Vec<f64>) {
   168	    let quiet = EmissionInput::default();
   169	    let mut ke = Vec::with_capacity(frames);
   170	    let mut mv = Vec::with_capacity(frames);
   171	    for _ in 0..frames {
   172	        solver.step(DT, &quiet);
   173	        ke.push(total_ke(solver));
   174	        mv.push(max_speed(solver));
   175	    }
   176	    (ke, mv)
   177	}
