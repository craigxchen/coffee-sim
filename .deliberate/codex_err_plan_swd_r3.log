   742	    /// Blocking GPU→CPU read-back of the first `bytes` of `src` (dev/test only — stalls).
   743	    fn read_bytes(&self, src: &wgpu::Buffer, bytes: u64) -> Vec<u8> {
   744	        if bytes == 0 {
   745	            return Vec::new();
   746	        }
   747	        let mut enc = self
   748	            .device
   749	            .create_command_encoder(&wgpu::CommandEncoderDescriptor {
   750	                label: Some("twofield-readback"),
   751	            });
   752	        enc.copy_buffer_to_buffer(src, 0, &self.readback, 0, bytes);
   753	        self.queue.submit(Some(enc.finish()));
   754	        let slice = self.readback.slice(0..bytes);
   755	        let (tx, rx) = std::sync::mpsc::channel();
   756	        slice.map_async(wgpu::MapMode::Read, move |r| {
   757	            let _ = tx.send(r);
   758	        });
   759	        let _ = self.device.poll(wgpu::PollType::Wait {
   760	            submission_index: None,
   761	            timeout: None,
   762	        });
   763	        rx.recv().unwrap().unwrap();
   764	        let data = slice.get_mapped_range().to_vec();
   765	        self.readback.unmap();
   766	        data
   767	    }
