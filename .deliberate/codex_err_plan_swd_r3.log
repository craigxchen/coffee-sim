   156	fn max_speed(solver: &TwofieldSolver) -> f64 {
   157	    let nw = solver.phase_counts().0 as usize;
   158	    let vel = solver.read_velocities();
   159	    vel[..nw]
   160	        .iter()
   161	        .map(|v| ((v[0] as f64).powi(2) + (v[1] as f64).powi(2) + (v[2] as f64).powi(2)).sqrt())
   162	        .fold(0.0, f64::max)
   163	}
