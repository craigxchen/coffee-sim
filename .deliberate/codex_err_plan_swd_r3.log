  1292	    /// Which ping-pong buffer holds the final pressure (0 = pf_a) — mirrors step()'s parity.
  1293	    fn pressure_parity(&self) -> usize {
  1294	        let (pre, post) = self.smooth_split();
  1295	        let mut par = (pre % 2) as usize;
  1296	        if self.coarse_sweeps > 0 {
  1297	            par ^= 1; // prolong_add flips
  1298	        }
  1299	        par ^= (post % 2) as usize;
  1300	        par
  1301	    }
