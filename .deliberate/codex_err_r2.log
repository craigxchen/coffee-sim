                    let d = xi - pred[j].xyz;
                    let r = length(d);
                    if (r >= h) { continue; }
                    rho = rho + m * fj * w_poly6(r, h);
                    let gj = m * fj * spiky_grad(d, h, params.spiky_r_min);
