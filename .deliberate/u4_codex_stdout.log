+/// Determinism: two identical pour brews agree on emitted count and aggregate yield.
+#[test]
+fn v60_pour_is_deterministic() {
+    let Some(gpu) = GpuContext::new_headless() else {
+        eprintln!("xpbd_emission: no GPU adapter; skipping.");
+        return;
+    };
+    let run = || {
+        let mut solver = v60_pour_solver(&gpu);
+        for _ in 0..300 {
+            solver.step(DT, &pour([0.0, 2.5, 0.0], 8.0));
+        }
+        solver.sample_diagnostics();
+        (solver.active_count(), solver.metrics().extraction_yield)
+    };
+    let (n1, y1) = run();
+    let (n2, y2) = run();
+    // Emission is CPU-side (deterministic cursor) ⇒ the emitted count is bit-exact.
+    assert_eq!(n1, n2, "emitted count not deterministic");
+    // Yield comes from the GPU mixed solve, which is chaotic/not bit-exact (grid-scatter atomic order
+    // varies, per project notes) — so aggregate metrics match only to a loose band, not bit-exactly.
+    assert!(
+        (y1 - y2).abs() <= 0.03 * y1.abs().max(1.0e-4),
+        "yield not deterministic within tolerance: {y1} vs {y2}"
+    );
+}

