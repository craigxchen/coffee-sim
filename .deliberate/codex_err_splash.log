   195	            velocity_damping: 1.0,
   196	            // Velocity cap as a pure safety backstop, above believable water speeds.
   197	            max_speed: 50.0,
   198	            seed_jitter: 0.1,
   199	            // Granular bed: contacts need more iterations + a tighter penetration tolerance than
