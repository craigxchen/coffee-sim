   164	            max_iters: 20,
   165	            residual_tolerance: 0.01,
   166	            relaxation_eps: 1.0e-3,
   167	            // Under-relax the Jacobi position solve (ω<1) — stabilizes it and keeps
   168	            // per-iteration moves within a grid cell (the grid is rebuilt once/frame).
   169	            position_relaxation: 0.5,
