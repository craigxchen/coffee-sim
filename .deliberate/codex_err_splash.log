   145	fn total_ke(solver: &TwofieldSolver) -> f64 {
   146	    let nw = solver.phase_counts().0 as usize;
   147	    let vel = solver.read_velocities();
   148	    let mut ke = 0.0f64;
   149	    for v in &vel[..nw] {
   150	        let s2 = (v[0] as f64).powi(2) + (v[1] as f64).powi(2) + (v[2] as f64).powi(2);
