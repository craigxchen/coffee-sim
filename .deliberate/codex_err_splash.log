   640	        cfg: Config {
   641	            solid_dynamics: true,
   642	            nozzle_radius: JET_RADIUS as f32,
   643	            tf_wet_cohesion: wet_cohesion, // wet bed → steeper walls (effective-stress cohesion)
   644	            tf_cohesion_speak: 0.4,
   645	            tf_filter_floor: true, // let pour-water drain so the bed doesn't just flood
   646	            ..Config::default()
   647	        },
   648	    };
   649	    let mut bed = build_bed(gpu, &spec);
   650	    bed.solver.set_pic_blend_for_test(blend);
   651	    let quiet = EmissionInput::default();
   652	    // Settle the saturated deformable bed (no pour): establishes the swollen-flat baseline.
   653	    for _ in 0..200 {
   654	        bed.solver.step(DT, &quiet);
   655	    }
   656	    assert!(
   657	        all_finite(&bed.solver.read_positions()),
   658	        "settle non-finite"
   659	    );
   660	    let base_cols = bed_surface_map(&bed.solver);
   661	    let base_center = surface_band(&base_cols, axis, 0.0, 2.0);
   662	    let base_rim = surface_band(&base_cols, axis, 6.0, 9.0);
