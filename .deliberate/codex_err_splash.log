   140	/// Inclusive lattice (mirrors seed_ranges counting: floor(extent/pitch)+1 per axis).
   141	fn lattice(min: [f32; 3], max: [f32; 3], pitch: f32) -> Vec<[f32; 3]> {
   142	    let n = |a: usize| ((max[a] - min[a]) / pitch).floor().max(0.0) as i32;
   143	    let (nx, ny, nz) = (n(0), n(1), n(2));
   144	    let mut out = Vec::new();
   145	    for k in 0..=nz {
   146	        for j in 0..=ny {
   147	            for i in 0..=nx {
   148	                out.push([
   149	                    min[0] + i as f32 * pitch,
   150	                    min[1] + j as f32 * pitch,
   151	                    min[2] + k as f32 * pitch,
   152	                ]);
   153	            }
   154	        }
   155	    }
   156	    out
   157	}
