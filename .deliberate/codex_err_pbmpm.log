   107	/// Least-squares slope of ln(gpu_us) vs ln(n) — the cost exponent k in total_µs ∝ N^k.
   108	fn fit_exponent(rows: &[Row]) -> f32 {
   109	    let pts: Vec<(f32, f32)> = rows
   110	        .iter()
   111	        .filter(|r| r.n > 0 && r.gpu_us > 0.0)
   112	        .map(|r| ((r.n as f32).ln(), r.gpu_us.ln()))
   113	        .collect();
   114	    let m = pts.len() as f32;
   115	    if m < 2.0 {
   116	        return f32::NAN;
   117	    }
   118	    let sx: f32 = pts.iter().map(|p| p.0).sum();
   119	    let sy: f32 = pts.iter().map(|p| p.1).sum();
   120	    let sxx: f32 = pts.iter().map(|p| p.0 * p.0).sum();
   121	    let sxy: f32 = pts.iter().map(|p| p.0 * p.1).sum();
   122	    (m * sxy - sx * sy) / (m * sxx - sx * sx)
   123	}
