   314	// --- water→grain dynamic-pressure impact coupling (the pour crater; KTD-1..5/9) ----------------
   315	// Per-pair velocity delta for particle `i` (`self_phase`), from one opposite-phase neighbor `j`.
   316	// Canonical roles are assigned by PHASE (not i/j order), so the shared scalar `s` is identical no
   317	// matter which pass calls it → the grain (+) and water (−) impulses are exactly equal-and-opposite
   318	// (momentum-conserving). The stability cap is applied to `s` BEFORE the mass split, so capping never
   319	// breaks conservation. Reads `vel_frozen` (the stored pre-finalize velocity, which still carries the
   320	// jet — predict/apply_dp move only `pred`; the cushioning v=(pred−pos)/dt is deferred to finalize).
   321	fn impact_delta_for_pair(i: u32, j: u32, self_phase: u32) -> vec3<f32> {
   322	    var wi = i;
   323	    var gi = j;
   324	    if (self_phase == PHASE_GRAIN) {
   325	        wi = j;
   326	        gi = i;
   327	    }
   328	    let d = pred[gi].xyz - pred[wi].xyz; // water → grain
   329	    let r = length(d);
   330	    // NaN guard (coincident pair → no defined normal) + range cutoff.
   331	    if (r < 1.0e-6 || r >= params.coupling_h) {
   332	        return vec3<f32>(0.0);
   333	    }
   334	    let n = d / r;
   335	    let v_rel = vel_frozen[wi].xyz - vel_frozen[gi].xyz;
   336	    let approach = max(dot(v_rel, n), 0.0); // 0 unless water moves toward grain
   337	    if (approach <= 0.0) {
   338	        return vec3<f32>(0.0);
   339	    }
   340	    // Dynamic pressure ~ρv²: quadratic in approach, smoothly gated above drawdown speed.
   341	    let gate = approach * approach * smoothstep(V_IMPACT_MIN, V_IMPACT_FULL, approach);
   342	    let w = w_poly6(r, params.coupling_h);
   343	    let m_w = max(water_eff_mass(pred[wi].w), params.particle_mass * params.pbf_eps);
   344	    let m_g = grain_eff_mass(pred[gi].w);
   345	    let mm = m_w + m_g;
   346	    let s_raw = params.impact_scale * w * gate * params.dt;
   347	    // Cap the SHARED scalar (KTD-2/5): never reverse approach (min with `approach`), and bound the
   348	    // larger-side |Δv| to k·coupling_h/dt (CFL). Both act on `s` → equal-and-opposite survives.
   349	    let cfl = (IMPACT_CFL_K * params.coupling_h / params.dt) / max(m_w / mm, m_g / mm);
   350	    let s = min(s_raw, min(approach, cfl));
   351	    // Split: grain gets +s·(m_w/M)·n̂ (down+out at the stagnation); water gets −s·(m_g/M)·n̂.
   352	    if (self_phase == PHASE_GRAIN) {
   353	        return (s * m_w / mm) * n;
   354	    }
   355	    return (-s * m_g / mm) * n;
   356	}
