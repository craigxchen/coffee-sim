  1712	    }
  1713	    if iz_val > 0u
  1714	        && select(
  1715	            sample_sdf(cell_center + vec3<f32>(0.0, 0.0, -dx_vec)) >= 0.0,
  1716	            !sdf_class_is_solid(vec3<i32>(i32(ix_val), i32(iy_val), i32(iz_val) - 1)),
  1717	            use_sdf_cache(),
  1718	        ) {
  1719	        vzm = grid_vel[cell_index(ix_val, iy_val, iz_val - 1u)].z;
  1720	    }
  1721	    if iz_val + 1u < gz()
  1722	        && select(
  1723	            sample_sdf(cell_center + vec3<f32>(0.0, 0.0, dx_vec)) >= 0.0,
  1724	            !sdf_class_is_solid(vec3<i32>(i32(ix_val), i32(iy_val), i32(iz_val) + 1)),
  1725	            use_sdf_cache(),
