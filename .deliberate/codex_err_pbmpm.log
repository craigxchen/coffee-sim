  1841	@compute @workgroup_size(64)
  1842	fn pressure_rbgs_red(@builtin(global_invocation_id) gid: vec3<u32>) {
  1843	    let idx = gid.x;
  1844	    if idx >= total_cells() { return; }
  1845	    pressure_update(idx, 0u);
  1846	}
  1847	
  1848	@compute @workgroup_size(64)
  1849	fn pressure_rbgs_black(@builtin(global_invocation_id) gid: vec3<u32>) {
  1850	    let idx = gid.x;
  1851	    if idx >= total_cells() { return; }
  1852	    pressure_update(idx, 1u);
  1853	}
  1854	
  1855	// Sparse RBGS: one workgroup per tile (over-dispatched to tile_count). Inactive
  1856	// tiles return immediately; active tiles map their 64 threads to the 64 cells of
  1857	// the 4x4x4 tile and call the same pressure_update as the dense path. Because a
  1858	// color sweep updates each cell independently of same-color cells, the tiled
  1859	// traversal is bit-identical to the dense linear traversal.
  1860	fn pressure_rbgs_sparse(tile_id: u32, local: u32, parity: u32) {
  1861	    if tile_id >= tile_count() { return; }
  1862	    if atomicLoad(&sparse_tiles[tile_flag_idx(tile_id)]) == 0u { return; }
  1863	
  1864	    let ntx = tile_dim_x();
  1865	    let nty = tile_dim_y();
  1866	    let tz = tile_id / (ntx * nty);
  1867	    let trem = tile_id % (ntx * nty);
  1868	    let ty = trem / ntx;
  1869	    let tx = trem % ntx;
  1870	
  1871	    let lz = local / (TILE_SIZE * TILE_SIZE);
  1872	    let lrem = local % (TILE_SIZE * TILE_SIZE);
  1873	    let ly = lrem / TILE_SIZE;
  1874	    let lx = lrem % TILE_SIZE;
  1875	
  1876	    let ix = tx * TILE_SIZE + lx;
  1877	    let iy = ty * TILE_SIZE + ly;
  1878	    let iz = tz * TILE_SIZE + lz;
  1879	    // Partial edge tiles (e.g. the top Y layer when gy is not a multiple of
  1880	    // TILE_SIZE) over-cover the grid; drop the out-of-bounds lanes.
  1881	    if ix >= gx() || iy >= gy() || iz >= gz() { return; }
  1882	
  1883	    pressure_update(cell_index(ix, iy, iz), parity);
  1884	}
  1885	
  1886	@compute @workgroup_size(64)
  1887	fn pressure_rbgs_red_sparse(
  1888	    @builtin(workgroup_id) wid: vec3<u32>,
  1889	    @builtin(local_invocation_id) lid: vec3<u32>,
  1890	) {
  1891	    pressure_rbgs_sparse(wid.x, lid.x, 0u);
  1892	}
  1893	
  1894	@compute @workgroup_size(64)
  1895	fn pressure_rbgs_black_sparse(
  1896	    @builtin(workgroup_id) wid: vec3<u32>,
  1897	    @builtin(local_invocation_id) lid: vec3<u32>,
  1898	) {
  1899	    pressure_rbgs_sparse(wid.x, lid.x, 1u);
  1900	}
