    66	    #[cfg(target_arch = "wasm32")]
    67	    pub async fn new_web(
    68	        canvas: web_sys::HtmlCanvasElement,
    69	    ) -> Result<(Self, wgpu::Surface<'static>), wasm_bindgen::JsValue> {
