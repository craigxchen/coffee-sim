   123	    // into dormant water-pool slots [n_pond, water_pool_capacity); drop any overflow.
   124	    let n_pond = solver.phase_counts().0;
   125	    let _ = n_water_seed;
   126	    let room = solver.water_pool_capacity().saturating_sub(n_pond) as usize;
