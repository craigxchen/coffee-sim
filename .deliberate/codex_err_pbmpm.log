  1735	        let bed_idx = bed_lookup_load(idx);
  1736	        if bed_idx >= 0 && u32(bed_idx) < num_bed() {
  1737	            let pore_target = bed_pore_projection_target_divergence(
  1738	                u32(bed_idx),
  1739	                cell_center,
  1740	                rest_volume,
  1741	                current_volume,
  1742	            );
