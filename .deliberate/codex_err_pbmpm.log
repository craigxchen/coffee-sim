  1764	// ── pressure_rbgs ──
  1765	
  1766	fn pressure_update(idx: u32, target_parity: u32) {
  1767	    let iz_val = idx / (gx() * gy());
  1768	    let rem = idx % (gx() * gy());
  1769	    let iy_val = rem / gx();
  1770	    let ix_val = rem % gx();
  1771	    if ((ix_val + iy_val + iz_val) & 1u) != target_parity {
  1772	        return;
  1773	    }
  1774	
  1775	    let kind = cell_kind_load(idx);
  1776	    if !is_fluid_kind(kind) {
  1777	        // Non-fluid cells already hold zero pressure: the grid buffer is
  1778	        // cleared each substep and classify_cells zeroes every in-bounds cell
  1779	        // before classifying. Their pressure is never read as a value (the
  1780	        // averaging stencil only sums is_fluid_kind neighbors), so re-zeroing
  1781	        // here is redundant — and it costs a store to every air/solid cell on
  1782	        // every red/black sweep. Skip it.
  1783	        return;
  1784	    }
  1785	
  1786	    var neighbor_count = 0.0;
  1787	    var pressure_sum = 0.0;
  1788	    let self_fill = liquid_fill_fraction(idx, kind);
  1789	    let offsets = array<vec3<i32>, 6>(
  1790	        vec3<i32>(-1, 0, 0),
  1791	        vec3<i32>(1, 0, 0),
  1792	        vec3<i32>(0, -1, 0),
  1793	        vec3<i32>(0, 1, 0),
  1794	        vec3<i32>(0, 0, -1),
  1795	        vec3<i32>(0, 0, 1),
  1796	    );
  1797	
  1798	    for (var n = 0u; n < 6u; n++) {
  1799	        let neighbor = vec3<i32>(i32(ix_val), i32(iy_val), i32(iz_val)) + offsets[n];
  1800	        // Off-grid neighbors act as Neumann (no-flow) — skip from both
  1801	        // numerator and denominator. Preserves existing behavior.
  1802	        if neighbor.x < 0 || neighbor.y < 0 || neighbor.z < 0
  1803	            || u32(neighbor.x) >= gx() || u32(neighbor.y) >= gy() || u32(neighbor.z) >= gz() {
  1804	            continue;
  1805	        }
  1806	
  1807	        let neighbor_idx = cell_index(u32(neighbor.x), u32(neighbor.y), u32(neighbor.z));
  1808	        let neighbor_kind = cell_kind_load(neighbor_idx);
  1809	
  1810	        // Solid neighbor → Neumann BC via ghost-mirror (p_ghost = p_here).
  1811	        // The standard 7-point Laplacian with a mirror ghost drops the
  1812	        // solid face from both the numerator and denominator of the
  1813	        // averaging update, so we `continue` before touching neighbor_count.
  1814	        if is_solid_kind(neighbor_kind) {
  1815	            continue;
  1816	        }
  1817	
  1818	        let face_weight = pressure_face_weight(kind, self_fill, neighbor_idx, neighbor_kind);
  1819	        if face_weight <= 0.0 {
  1820	            continue;
  1821	        }
  1822	
  1823	        neighbor_count += face_weight;
  1824	        // Air neighbor → weighted Dirichlet p=0, contributes 0 to
  1825	        // pressure_sum. Fluid neighbor → weighted pressure contribution.
  1826	        if is_fluid_kind(neighbor_kind) {
  1827	            pressure_sum += face_weight * pressure_load(neighbor_idx);
  1828	        }
  1829	    }
  1830	
  1831	    if neighbor_count <= 0.0 {
  1832	        pressure_store(idx, 0.0);
  1833	        return;
  1834	    }
  1835	
  1836	    let rhs = divergence_load(idx) * self_fill / max(dt(), 1e-6);
  1837	    let p_new = (pressure_sum - dx() * dx() * rhs) / neighbor_count;
  1838	    pressure_store(idx, p_new);
  1839	}
