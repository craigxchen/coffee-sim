  1995	// ── pressure_residual ──
  1996	
  1997	@compute @workgroup_size(64)
  1998	fn pressure_residual(@builtin(global_invocation_id) gid: vec3<u32>) {
  1999	    let idx = gid.x;
  2000	    if idx >= total_cells() { return; }
  2001	
  2002	    let kind = cell_kind_load(idx);
  2003	    if !is_fluid_kind(kind) {
  2004	        return;
  2005	    }
  2006	
  2007	    let iz_val = idx / (gx() * gy());
  2008	    let rem = idx % (gx() * gy());
  2009	    let iy_val = rem / gx();
  2010	    let ix_val = rem % gx();
  2011	    let cell = vec3<i32>(i32(ix_val), i32(iy_val), i32(iz_val));
  2012	    let cell_center = u.grid_origin.xyz
  2013	        + (vec3<f32>(f32(ix_val), f32(iy_val), f32(iz_val)) + vec3<f32>(0.5)) * dx();
  2014	
  2015	    let div = velocity_divergence_with_solid_mirrors(idx, cell, cell_center);
  2016	    let target_divergence = projection_target_divergence_for_cell(idx, kind, cell, cell_center);
  2017	    let abs_residual = abs(div - target_divergence);
  2018	    let fp_max = u32(clamp(abs_residual * metrics_div_fp_scale(), 0.0, f32(0x7fffffffu)));
  2019	    let fp_sum = u32(clamp(
  2020	        abs_residual * metrics_residual_sum_fp_scale(),
  2021	        0.0,
  2022	        f32(0xffffffffu),
  2023	    ));
  2024	    atomicMax(&metrics[METRIC_PROJECTION_RESIDUAL_MAX_IDX], fp_max);
  2025	    atomicAdd(&metrics[METRIC_PROJECTION_RESIDUAL_SUM_IDX], fp_sum);
  2026	    atomicAdd(&metrics[METRIC_PROJECTION_RESIDUAL_CELLS_IDX], 1u);
  2027	}
