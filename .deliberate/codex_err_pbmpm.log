   126	fn residual_reduce(@builtin(local_invocation_id) lid: vec3<u32>) {
   127	    // No early `return` on status.converged here: a return gated on a read_write storage read is
   128	    // non-uniform control flow, and the workgroupBarrier()s below must be reached uniformly by every
   129	    // invocation (WGSL spec). The browser's Tint compiler rejects the early-out — failing the whole
   130	    // module — while native naga tolerates it. Instead we always run the (single-workgroup, cheap)
   131	    // reduction and gate only the bookkeeping write, which leaves `status` untouched once converged —
   132	    // observably identical to the early-out, and valid uniform control flow on both compilers.
   133	    let tid = lid.x;
   134	    var local_max = 0.0;
   135	    var i = tid;
   136	    loop {
   137	        if (i >= params.particle_count) { break; }
   138	        local_max = max(local_max, c_residual[i]);
   139	        i = i + 256u;
   140	    }
   141	    sdata[tid] = local_max;
   142	    workgroupBarrier();
   143	    var stride = 128u;
   144	    loop {
   145	        if (stride == 0u) { break; }
   146	        if (tid < stride) {
   147	            sdata[tid] = max(sdata[tid], sdata[tid + stride]);
   148	        }
   149	        workgroupBarrier();
   150	        stride = stride / 2u;
   151	    }
   152	    if (tid == 0u && status.converged == 0u) {
   153	        let gmax = sdata[0];
   154	        status.residual_bits = bitcast<u32>(gmax);
   155	        status.iters_done = status.iters_done + 1u;
   156	        if (status.iters_done >= params.min_iters && gmax < params.residual_tolerance) {
   157	            status.converged = 1u;
   158	            status.effective_iters = status.iters_done;
   159	        }
   160	    }
   161	}
