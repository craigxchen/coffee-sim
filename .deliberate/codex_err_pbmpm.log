   110	/// Seed the bed pore water onto a sub-lattice so the bed starts saturated (mirrors
   111	/// `tests/twofield_full.rs::build_bed`), using the dormant water-pool headroom.
   112	fn saturate_bed(solver: &mut TwofieldSolver, edge: f32, bed_top: f32) {
   113	    let mut pore: Vec<[f32; 3]> = Vec::new();
   114	    let mut yy = 0.6f32;
   115	    while yy <= bed_top - 0.4 {
   116	        let mut xx = 0.7f32;
   117	        while xx <= edge - 0.7 {
   118	            let mut zz = 0.7f32;
   119	            while zz <= edge - 0.7 {
   120	                pore.push([xx, yy, zz]);
   121	                zz += PORE_PITCH;
   122	            }
   123	            xx += PORE_PITCH;
   124	        }
   125	        yy += PORE_PITCH;
   126	    }
   127	    let n_pond = solver.phase_counts().0;
   128	    let mut pos = solver.read_positions();
   129	    // Pore water fills dormant water-pool slots only [n_pond, water_pool_capacity).
   130	    let room = solver.water_pool_capacity().saturating_sub(n_pond) as usize;
   131	    let take = pore.len().min(room);
   132	    for (i, p) in pore.iter().take(take).enumerate() {
   133	        pos[n_pond as usize + i] = [p[0], p[1], p[2], 1.0];
   134	    }
   135	    solver.write_positions_for_test(&pos);
   136	    solver.set_live_water_for_test(n_pond + take as u32);
   137	}
