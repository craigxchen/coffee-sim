     6	use wgpu::{Adapter, Device, Instance, Queue};
     7	
     8	/// Wraps the `wgpu` device + queue and the data needed to create resources.
     9	///
    10	/// Targets the WebGPU baseline limits except `max_storage_buffers_per_shader_stage`, which is raised
    11	/// to **9** — the count the boundary-force density passes bind (the spec baseline is 8; modern
    12	/// browsers and native both grant ≥9). Requested as a fixed value, not from `adapter.limits()` (which
    13	/// wgpu's web backend over-reports, breaking `request_device`). Requests `TIMESTAMP_QUERY` only when
    14	/// the adapter advertises it. Headless for now: no surface (rendering arrives with `ui`). The same
    15	/// request path compiles to WASM + WebGPU — native only wraps the async init in `pollster::block_on`.
    16	pub struct GpuContext {
    17	    pub instance: Instance,
    18	    pub adapter: Adapter,
    19	    pub device: Device,
    20	    pub queue: Queue,
    21	    /// Whether per-pass `timestamp-query` profiling is available on this device.
    22	    pub timestamps_supported: bool,
    23	}
    24	
    25	impl GpuContext {
    26	    /// Build a headless context. Returns `None` when no adapter is available (e.g. CI
    27	    /// without a GPU) so callers can skip GPU work gracefully instead of failing.
    28	    #[cfg(not(target_arch = "wasm32"))]
    29	    pub fn new_headless() -> Option<Self> {
    30	        let instance = Instance::default();
    31	        pollster::block_on(Self::request(
    32	            instance,
    33	            wgpu::RequestAdapterOptions {
    34	                power_preference: wgpu::PowerPreference::HighPerformance,
    35	                force_fallback_adapter: false,
    36	                compatible_surface: None,
    37	            },
    38	            true,
    39	        ))
    40	    }
    41	
    42	    /// Build a context for an on-screen window and return the matching surface. The adapter
    43	    /// is chosen as surface-compatible; the **solver and renderer share this one context** so
    44	    /// the renderer can read the solver's particle buffers. The caller owns the surface (it
    45	    /// configures/presents). Returns `None` if no adapter/device is available.
    46	    #[cfg(not(target_arch = "wasm32"))]
    47	    pub fn new_windowed(
    48	        window: Arc<winit::window::Window>,
    49	    ) -> Option<(Self, wgpu::Surface<'static>)> {
    50	        let instance = Instance::default();
    51	        let surface = instance.create_surface(window).ok()?;
    52	        let ctx = pollster::block_on(Self::request(
    53	            instance,
    54	            wgpu::RequestAdapterOptions {
    55	                power_preference: wgpu::PowerPreference::HighPerformance,
    56	                force_fallback_adapter: false,
    57	                compatible_surface: Some(&surface),
    58	            },
    59	            true,
    60	        ))?;
