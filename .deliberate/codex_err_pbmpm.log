   157	// DENSITY_RELAX_FRAMES it is a structural const, not a Params slot.
   158	const DENSITY_TARGET_DEADBAND: f32 = 0.0;
   159	// SETTLED-POOL STIRRING — diagnosis (no in-solver fix yet; see twofield_settled.rs).
   160	// A settled pool slowly churns. Isolation (water tank, settled-tail KE): baseline ~67; relief OFF
   161	// ~7.6; 32 fine sweeps (vs 8) ~17; pure PIC (kill the affine C) ~1.3. So the mechanism is a limit
   162	// cycle: the local-Jacobi pressure solve is intentionally UNDER-converged (8+8 sweeps, no global
   163	// Poisson — the real-time design), leaving a standing density error; the density relief faithfully
   164	// converts that error into a velocity each frame; the lossless APIC affine field accumulates it (no
   165	// numerical dissipation); the pool sloshes and re-creates the error. Two clamps were MEASURED and
   166	// rejected: a global G2P APIC→PIC blend quiets the pool but freezes the deformable-bed crater slump
   167	// (which rides on the same agitation — even blend 0.02 froze it); a φ_f-gated relief dead-band does
   168	// not reach the churn (the standing error exceeds a tolerable band). The honest cures all trade a
   169	// pre-registered gate — more fine sweeps (R9 perf), carrier dissipation (the crater) — so the lever
   170	// is a product decision, deferred. The relief below stays the original un-banded feedback.
   171	// Free-surface fill-fraction constants (header: FREE SURFACE; mirrored in twofield/mod.rs).
   172	const SURF_FULL_FRAC: f32 = 0.5;
   173	const SURF_MIN_CORNER: f32 = 0.1;
   174	const NODE_BC_EPS: f32 = 1.0e-4;     // box-face epsilon (matches grid_update)
   175	const SDF_NORMAL_MIN: f32 = 1.0e-3;  // degenerate orthogonalized-normal guard
   176	// SDF no-penetration band in cell sizes: a node within WALL_BAND·h on the FLUID side of a wall
   177	// gets the wall-normal projector (the supporting fluid layer of a non-grid-aligned wall). Mirror
   178	// of `drag_fold`'s velocity BC band in coupling.wgsl — they MUST match for operator consistency.
   179	const WALL_BAND: f32 = 1.0;
   180	// Flood-fill OUTSIDE seed band in cell sizes (surface.wgsl flood_init): an air cell within
   181	// FLOOD_WALL_BAND·h of an SDF wall is seeded OPEN. Wider than WALL_BAND so the seed reaches the
   182	// CENTER of a ~1-cell-wide SDF channel (the V60 cone apex hole, radius 0.42 ≈ 1.3 cells) and
   183	// keeps it conductive — connecting the cup/cone air to the open top. Purely a pocket-detection
   184	// aid (no operator/BC effect), so it carries no operator-consistency constraint.
   185	const FLOOD_WALL_BAND: f32 = 2.0;
   186	
   187	// SDF wall BC mode (params.dbg.y, plan 2026-06-17-002):
   188	//   ≤ 0.5  → WALL_BC_SINGLE (default): the single most-penetrated normal (solid_union) banded over
   189	//            WALL_BAND·h — the original behavior, kept byte-identical here.
