    31	fn max_speed(v: &[[f32; 4]]) -> f32 {
    32	    v.iter()
    33	        .map(|x| (x[0] * x[0] + x[1] * x[1] + x[2] * x[2]).sqrt())
    34	        .fold(0.0, f32::max)
    35	}
    36	
    37	fn span(pos: &[[f32; 4]], axis: usize) -> (f32, f32) {
    38	    pos.iter()
    39	        .fold((f32::INFINITY, f32::NEG_INFINITY), |(lo, hi), p| {
    40	            (lo.min(p[axis]), hi.max(p[axis]))
    41	        })
    42	}
