   212	/// U4 dispatch increment for a grid of `dims`: flood_init + flood sweeps + pocket_mark, plus
   213	/// one single-workgroup bubble-row solve preceding EVERY fine and coarse Jacobi sweep (the
   214	/// KTD-6 identical-representation requirement — the multiplier relaxes WITH the smoother at
   215	/// both levels, so neither level can erode the constraint). Scene-derived through the flood
   216	/// budget (see `flood_sweeps_for`).
   217	pub fn u4_surface_dispatches_for(dims: [u32; 3]) -> u32 {
   218	    2 + flood_sweeps_for(dims) + FINE_SWEEPS_DEFAULT + COARSE_SWEEPS_DEFAULT
   219	}
