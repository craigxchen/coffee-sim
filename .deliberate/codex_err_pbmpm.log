    14	/// Read the `SPACING` env var (particle pitch). Clamped to a floor below which the
    15	/// fixed-bucket neighbor grid would exceed the WebGPU 128 MB buffer-binding limit.
    16	fn parse_spacing() -> f32 {
    17	    const MIN_SPACING: f32 = 0.25;
    18	    let requested: f32 = std::env::var("SPACING")
    19	        .ok()
    20	        .and_then(|s| s.parse().ok())
    21	        .unwrap_or(1.0);
    22	    let spacing = requested.max(MIN_SPACING);
    23	    if spacing != requested {
    24	        eprintln!(
    25	            "SPACING {requested} is too small (grid buffer would exceed the GPU limit); using {spacing}"
    26	        );
    27	    }
    28	    spacing
    29	}
