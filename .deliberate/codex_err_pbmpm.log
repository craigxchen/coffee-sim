   128	    scene: &Scene,
   129	    spacings: &[f32],
   130	    warmup: u32,
   131	    drive: &EmissionInput,
   132	) {
   133	    println!("\n=== {label} ===");
   134	    println!(
   135	        "{:>8} {:>9} {:>8} {:>11} {:>10} {:>8}",
   136	        "spacing", "active", "max_occ", "gpu_us", "us/Kpart", "lam+dp%"
   137	    );
   138	    let mut rows = Vec::new();
   139	    for &s in spacings {
   140	        let r = measure(gpu, scene, s, warmup, 40, drive);
   141	        println!(
   142	            "{:>8.3} {:>9} {:>8} {:>11.1} {:>10.2} {:>7.0}%",
   143	            r.spacing,
   144	            r.n,
   145	            r.max_occ,
   146	            r.gpu_us,
   147	            r.per_kpart,
   148	            r.share * 100.0
   149	        );
   150	        rows.push(r);
   151	    }
   152	    // Fit excludes the smallest point (GPU-underutilized: fixed launch overhead inflates its
   153	    // µs/Kpart and flattens the apparent slope). The headline metric is the µs/Kpart climb over
   154	    // the GPU-saturated range = max/min, which is what the reorder must flatten.
   155	    let saturated: Vec<Row> = rows.iter().skip(1).map(|r| Row { ..*r }).collect();
   156	    let k = fit_exponent(&saturated);
   157	    // Climb over the SATURATED range only (the small-N point is launch-overhead-dominated and would
   158	    // otherwise masquerade as the peak). Flat ⇒ ~1.0; super-linear ⇒ grows with N.
   159	    let kpart_min = saturated
   160	        .iter()
   161	        .map(|r| r.per_kpart)
   162	        .fold(f32::INFINITY, f32::min);
   163	    let kpart_max = saturated.iter().map(|r| r.per_kpart).fold(0.0, f32::max);
   164	    let climb = if kpart_min > 0.0 {
   165	        kpart_max / kpart_min
   166	    } else {
   167	        0.0
   168	    };
   169	    println!(
   170	        "  fit (N≥{}): total_us ∝ N^{k:.3}   |   µs/Kpart climb (max/min): {climb:.2}x   |   N range: {}..{}",
   171	        saturated.first().map(|r| r.n).unwrap_or(0),
   172	        rows.first().map(|r| r.n).unwrap_or(0),
   173	        rows.last().map(|r| r.n).unwrap_or(0),
   174	    );
   175	}
   176	
   177	fn main() {
   178	    let Some(gpu) = GpuContext::new_headless() else {
   179	        eprintln!("scaling_probe: no GPU adapter; cannot run.");
   180	        return;
   181	    };
   182	
   183	    // dam_break (water-only, isolates the density-solve hot path). 16³ block ⇒ N ≈ (16/s)³.
   184	    let idle = EmissionInput {
   185	        kettle_pos: [0.0, 0.0, 0.0],
   186	        flow_rate: 0.0,
   187	        pour_angle: 0.0,
   188	        event: PourEvent::None,
   189	    };
   190	    sweep(
   191	        &gpu,
   192	        "dam_break (water-only)",
   193	        &Scene::dam_break(),
   194	        &[1.27, 0.64, 0.45, 0.34, 0.27],
   195	        180,
   196	        &idle,
   197	    );
   198	}

