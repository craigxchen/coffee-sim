  1902	// ── project_pressure ──
  1903	
  1904	@compute @workgroup_size(64)
  1905	fn project_pressure(@builtin(global_invocation_id) gid: vec3<u32>) {
  1906	    let idx = gid.x;
  1907	    if idx >= total_cells() { return; }
  1908	
  1909	    let gv = grid_vel[idx];
  1910	    if gv.w < 1e-6 { return; }
  1911	
  1912	    let kind = cell_kind_load(idx);
  1913	    if !is_fluid_kind(kind) {
  1914	        return;
  1915	    }
  1916	
  1917	    let iz_val = idx / (gx() * gy());
  1918	    let rem = idx % (gx() * gy());
  1919	    let iy_val = rem / gx();
  1920	    let ix_val = rem % gx();
  1921	
  1922	    let p_here = pressure_load(idx);
  1923	    let self_fill = liquid_fill_fraction(idx, kind);
  1924	    let cell = vec3<i32>(i32(ix_val), i32(iy_val), i32(iz_val));
  1925	    // Solid/off-grid neighbors keep the mirror pressure, while air and fluid
  1926	    // faces blend toward the neighboring pressure by the liquid face weight.
  1927	    let p_xm = pressure_weighted_or_mirror(
  1928	        cell + vec3<i32>(-1, 0, 0),
  1929	        p_here,
  1930	        kind,
  1931	        self_fill,
  1932	    );
  1933	    let p_xp = pressure_weighted_or_mirror(
  1934	        cell + vec3<i32>(1, 0, 0),
  1935	        p_here,
  1936	        kind,
  1937	        self_fill,
  1938	    );
  1939	    let p_ym = pressure_weighted_or_mirror(
  1940	        cell + vec3<i32>(0, -1, 0),
  1941	        p_here,
  1942	        kind,
  1943	        self_fill,
  1944	    );
  1945	    let p_yp = pressure_weighted_or_mirror(
  1946	        cell + vec3<i32>(0, 1, 0),
  1947	        p_here,
  1948	        kind,
  1949	        self_fill,
  1950	    );
  1951	    let p_zm = pressure_weighted_or_mirror(
  1952	        cell + vec3<i32>(0, 0, -1),
  1953	        p_here,
  1954	        kind,
  1955	        self_fill,
  1956	    );
  1957	    let p_zp = pressure_weighted_or_mirror(
  1958	        cell + vec3<i32>(0, 0, 1),
  1959	        p_here,
  1960	        kind,
  1961	        self_fill,
  1962	    );
  1963	
  1964	    // Finite-volume pressure force from the two face pressures in each axis.
  1965	    // This preserves the central gradient for full cells, while fractional
  1966	    // free-surface faces only contribute through their face pressure blend.
  1967	    let grad_p = 0.5 * inv_dx() * vec3<f32>(
  1968	        (p_xp - p_here) + (p_here - p_xm),
  1969	        (p_yp - p_here) + (p_here - p_ym),
  1970	        (p_zp - p_here) + (p_here - p_zm),
  1971	    );
  1972	
  1973	    var v = gv.xyz - dt() * grad_p;
  1974	    if kind == CELL_BED_COUPLED {
  1975	        let bed_idx = bed_lookup_load(idx);
  1976	        if bed_idx >= 0 && u32(bed_idx) < num_bed() {
  1977	            let permeability_m2 = bed_compacted_permeability(u32(bed_idx));
  1978	            let darcy_rate = water_kinematic_viscosity_m2_s() / permeability_m2;
  1979	            let darcy_damping = 1.0 / (1.0 + max(darcy_rate * dt(), 0.0));
  1980	            let bed_cell = vec3<i32>(i32(ix_val), i32(iy_val), i32(iz_val));
  1981	            let bed_v = bed_matrix_velocity_cell(bed_cell);
  1982	            let v_before_darcy = v;
  1983	            v = bed_v + (v - bed_v) * darcy_damping;
  1984	            let water_impulse = gv.w * (v - v_before_darcy);
  1985	            bed_impulse_delta_add_neighborhood(bed_cell, -water_impulse * BED_REACTION_ALPHA);
  1986	        }
  1987	    }
  1988	    let speed = length(v);
  1989	    if speed > vel_cap() {
  1990	        v = v * (vel_cap() / speed);
  1991	    }
  1992	    grid_vel[idx] = vec4<f32>(v, gv.w);
  1993	}
