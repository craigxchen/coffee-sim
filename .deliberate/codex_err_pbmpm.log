  1700	            !sdf_class_is_solid(vec3<i32>(i32(ix_val), i32(iy_val) - 1, i32(iz_val))),
  1701	            use_sdf_cache(),
  1702	        ) {
  1703	        vym = grid_vel[cell_index(ix_val, iy_val - 1u, iz_val)].y;
  1704	    }
  1705	    if iy_val + 1u < gy()
  1706	        && select(
  1707	            sample_sdf(cell_center + vec3<f32>(0.0, dx_vec, 0.0)) >= 0.0,
  1708	            !sdf_class_is_solid(vec3<i32>(i32(ix_val), i32(iy_val) + 1, i32(iz_val))),
  1709	            use_sdf_cache(),
  1710	        ) {
