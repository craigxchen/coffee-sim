   133	// Per-node M̃⁻¹, 2 vec4 per node: [2n] = (xx, xy, xz, yy), [2n+1] = (yz, zz, massy_flag, 0).
   134	@group(0) @binding(9) var<storage, read_write> nm: array<vec4<f32>>;
