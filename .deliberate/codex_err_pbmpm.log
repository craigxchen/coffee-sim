    91	
    92	    /// Request the adapter, device, and queue. Native constructors block on this; the web canvas
    93	    /// constructor awaits it on the JS event loop.
    94	    async fn request(
    95	        instance: Instance,
    96	        options: wgpu::RequestAdapterOptions<'_, '_>,
    97	        allow_timestamp_queries: bool,
    98	    ) -> Option<Self> {
    99	        let adapter = instance.request_adapter(&options).await.ok()?;
   100	        let timestamps_supported =
   101	            allow_timestamp_queries && adapter.features().contains(wgpu::Features::TIMESTAMP_QUERY);
   102	        let required_features = if timestamps_supported {
   103	            wgpu::Features::TIMESTAMP_QUERY
   104	        } else {
   105	            wgpu::Features::empty()
   106	        };
   107	
   108	        // The boundary-force density passes (compute_lambda / compute_dp) bind 9 storage buffers per
   109	        // stage — one above the WebGPU spec baseline of 8. Request EXACTLY that, as a fixed value:
   110	        // modern browsers grant ≥10 (confirmed via navigator.gpu) and native Metal grants 16+, so 9
   111	        // is always within range. NOTE: do NOT derive this from `adapter.limits()` — wgpu's web
   112	        // backend over-reports that field, so requesting it makes request_device fail in the browser
   113	        // ("Device failed at creation"). All other limits stay at the WebGPU baseline for portability.
   114	        const NEEDED_STORAGE_BUFFERS: u32 = 9;
   115	        let (device, queue) = adapter
   116	            .request_device(&wgpu::DeviceDescriptor {
