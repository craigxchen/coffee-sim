   147	// Mirrors twofield::JACOBI_OMEGA (see the symbol-bound derivation there: λ_max(diag⁻¹A) = 8/3
   148	// for this corner family, so ω must be < 0.75; 2/3 is the weighted-Jacobi choice).
   149	const JACOBI_OMEGA: f32 = 0.6666667;
   150	// Density-relief time constant in frames (fixed structural constant, like JACOBI_OMEGA —
   151	// mirrors twofield::DENSITY_RELAX_FRAMES, derivation there: equilibrium compaction drift
   152	// ≈ residual·N·dt ≈ 1% — inside the ±5% band — while keeping the relief of a seeded
   153	// over-density gentle, v ~ Δx/τ, instead of detonating it into slosh).
   154	const DENSITY_RELAX_FRAMES: f32 = 30.0;
   155	// Uncapped density-target dead-band (dbg.w on): density error |e| below this is treated as zero
