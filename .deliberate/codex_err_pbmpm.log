    35	// ======================= PRE-REGISTERED gate constants (FIXED before any run) =================
    36	
    37	/// R9: the hard real-time gate — ≤ 33 ms/frame median at 200k on the reference device. A
    38	/// perfectly linear 90 ms/frame solver still fails; this is an absolute number, not structure.
    39	const REALTIME_MS_GATE: f32 = 33.0;
    40	
    41	/// The pre-registered gate-scene composition (KTD-5 cost bound): ~185–190k water + 10–15k solids
    42	/// at the 200k point. The bed is a thin frictional minority; the pour column + pond + bed pore
    43	/// water are the water majority. Encoded as a box edge + fixed bed/water proportions so the SAME
    44	/// scene grows with N — the gate cannot be passed with a conveniently cheap mix.
    45	const BED_LAYERS: f32 = 4.0; // thin skeleton (the solids minority)
    46	const WATER_COL: f32 = 52.0; // deep pour column / pond (the water majority)
    47	const PORE_PITCH: f32 = 1.6; // sparse bed pore-water lattice
    48	const EDGE_200K: f32 = 61.0; // box edge landing ~205k at the fixed composition
