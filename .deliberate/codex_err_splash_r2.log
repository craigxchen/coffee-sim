   638	/// Seed the scene's regions into the two-field range layout: ALL water particles first
   639	/// (`[0, water_count)`), then all solids. Lattice + seeded jitter per species spacing, with
   640	/// cone-aware SDF rejection (mirrors xpbd's `seed_block`; RNG draws happen per lattice point
   641	/// regardless of rejection, so the layout is deterministic for a given `cfg.seed`). The 4th
   642	/// position lane carries moisture: water = remaining fraction (1 = full), grain = absorbed
   643	/// volume (0 = dry). Returns `(positions, phases, water_count)`.
   644	fn seed_ranges(scene: &Scene, mats: &Materials, cfg: &Config) -> (Vec<[f32; 4]>, Vec<u32>, u32) {
   645	    const SEED_CLEARANCE: f32 = 0.4;
   646	    let mut rng = crate::utils::rng::Rng::new(cfg.seed);
   647	    let mut water: Vec<[f32; 4]> = Vec::new();
   648	    let mut solid: Vec<[f32; 4]> = Vec::new();
   649	    for region in &scene.regions {
   650	        let (lo, hi) = (region.min, region.max);
   651	        let (s, tag, w0) = match region.species {
   652	            Species::Water => (mats.particle_spacing, 0u32, 1.0f32),
   653	            Species::Grain => (mats.grain_diameter, 1u32, 0.0f32),
   654	        };
   655	        let jitter = cfg.seed_jitter * s;
   656	        let nx = (((hi[0] - lo[0]) / s).floor() as i32).max(0);
   657	        let ny = (((hi[1] - lo[1]) / s).floor() as i32).max(0);
   658	        let nz = (((hi[2] - lo[2]) / s).floor() as i32).max(0);
   659	        for k in 0..=nz {
   660	            for j in 0..=ny {
   661	                for i in 0..=nx {
   662	                    let jx = (rng.next_f32() * 2.0 - 1.0) * jitter;
   663	                    let jy = (rng.next_f32() * 2.0 - 1.0) * jitter;
   664	                    let jz = (rng.next_f32() * 2.0 - 1.0) * jitter;
   665	                    let px = lo[0] + i as f32 * s + jx;
   666	                    let py = lo[1] + j as f32 * s + jy;
   667	                    let pz = lo[2] + k as f32 * s + jz;
   668	                    if !scene.solids.is_empty() {
   669	                        let c = crate::utils::sdf::nearest(
   670	                            &scene.solids,
   671	                            glam::Vec3::new(px, py, pz),
   672	                            tag,
   673	                        );
   674	                        if c.signed < SEED_CLEARANCE {
   675	                            continue;
   676	                        }
   677	                    }
   678	                    let p = [px, py, pz, w0];
   679	                    if tag == 0 {
   680	                        water.push(p);
   681	                    } else {
   682	                        solid.push(p);
   683	                    }
   684	                }
   685	            }
   686	        }
   687	    }
   688	    let water_count = water.len() as u32;
   689	    let mut pos = water;
   690	    pos.extend_from_slice(&solid);

