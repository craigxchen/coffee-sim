   301	// ============================ U9 MOISTURE PHASE-CHANGE ABSORPTION (KTD-4c) =====================
   302	// GIC-style: water leaving the fluid phase becomes grain volume, conserved 1:1. Grid-projected,
   303	// atomic-free in the gather pass, deterministic and EXACTLY conserving by construction.
   304	//
   305	// p2g_moisture scatters two fixed-point grid lanes with the SAME quadratic B-spline weights as
   306	// the field transfers: the water SUPPLY S_n = Σ_w w·f_w·V_w and the grain DEMAND
   307	// D_n = Σ_g w·demand_g, demand_g = (V_cap − V_abs)·(1 − e^{−k_abs·dt}) (mirrors
   308	// models::wetting::absorb_demand, capped two-sidedly). The transfer at a node is the two-sided
   309	// cap T_n = min(S_n, D_n). g2p_absorb makes:
   310	//   * each WATER lose its weighted share  Σ_n w·(f_w·V_w)·(T_n/S_n),
   311	//   * each GRAIN gain its weighted share  Σ_n w·(demand_g)·(T_n/D_n).
   312	// Σ over particles at node n: water loses Σ_w w·f_w·V_w·(T_n/S_n) = S_n·(T_n/S_n) = T_n, and
   313	// grains gain D_n·(T_n/D_n) = T_n — EXACTLY equal, per node and globally (the conservation
   314	// gate). f_w / V_abs ride pos.w (U1 lane convention). Bloom (KTD-4b): a dry grain's demand is
   315	// scaled by a contact-time ramp (chem.x accumulates wet contact; ramps 0→1 over bloom_delay) so
   316	// the hydrophobic entry delay falls out. Off by default (k_abs = 0 ⇒ CPU-elided in mod.rs).
   317	
   318	fn wet_v_cap() -> f32 { return params.wet0.y; }
   319	fn wet_v_water() -> f32 { return params.wet0.z; }
   320	fn wet_roundoff() -> f32 { return params.wet0.w; }
   321	fn wet_sat_cutoff() -> f32 { let c = wet_v_cap(); return c - c * wet_roundoff(); }
   322	fn wet_demand(v_abs: f32) -> f32 {
   323	    if (v_abs >= wet_sat_cutoff()) { return 0.0; }
   324	    return (wet_v_cap() - v_abs) * (1.0 - exp(-params.wet0.x * params.dt));
   325	}
   326	// Bloom factor for a grain (KTD-4b): a smooth ramp of its accumulated wet-contact time
   327	// (chem.x, sim seconds) over bloom_delay. No delay ⇒ factor 1 immediately.
   328	fn bloom_factor(contact_t: f32) -> f32 {
   329	    let bd = params.wet1.y;
   330	    if (bd <= 0.0) { return 1.0; }
   331	    let t = clamp(contact_t / bd, 0.0, 1.0);
   332	    return t * t * (3.0 - 2.0 * t); // smoothstep
   333	}
   334	
   335	// =================================== p2g_moisture =============================================
   336	@compute @workgroup_size(256)
   337	fn p2g_moisture(@builtin(global_invocation_id) gid: vec3<u32>) {
   338	    let p = gid.x;
   339	    if (p >= params.particle_count) {
   340	        return;
   341	    }
   342	    // Water range [0, water_count); solid range [particle_count − solid_count, particle_count).
   343	    let is_water = p < params.water_count;
   344	    let is_solid = p >= (params.particle_count - params.solid_count);
   345	    if (!is_water && !is_solid) {
   346	        return; // dormant pool slot — never scatters
   347	    }
   348	    let h = params.grid_origin.w;
   349	    let x = pos[p].xyz;
   350	    // Ballistic escaped particles (open base): don't scatter (mirror the field-transfer guard).
   351	    if (params.coupling.w > 0.5 && x.y < params.box_min.y) {
   352	        return;
   353	    }
   354	    var quantity = 0.0;
   355	    var lane = 0u;
   356	    if (is_water) {
   357	        let f_w = pos[p].w;
   358	        if (f_w <= wet_roundoff()) { return; } // drained water: nothing to supply
   359	        quantity = f_w * wet_v_water();
   360	        lane = 0u; // SUPPLY
   361	    } else {
   362	        let v_abs = pos[p].w;
   363	        let demand = wet_demand(v_abs) * bloom_factor(chem[p].x);
   364	        if (demand <= 0.0) { return; } // saturated / unbloomed grain: no demand
   365	        quantity = demand;
   366	        lane = 1u; // DEMAND
   367	    }
   368	    let xl = (x - params.grid_origin.xyz) / h;
   369	    var base = vec3<i32>(floor(xl - vec3<f32>(0.5)));
   370	    base = clamp(base, vec3<i32>(0), vec3<i32>(params.grid_dims.xyz) - vec3<i32>(3));
   371	    let fx = xl - vec3<f32>(base);
   372	    var w = bspline_w(fx);
   373	    for (var k = 0; k < 3; k = k + 1) {
   374	        for (var j = 0; j < 3; j = j + 1) {
   375	            for (var i = 0; i < 3; i = i + 1) {
   376	                let wijk = w[i].x * w[j].y * w[k].z;
   377	                let node = base + vec3<i32>(i, j, k);
   378	                atomicAdd(&grid_moist[node_index(node) * 2u + lane], fp_encode(quantity * wijk));
   379	            }
   380	        }
   381	    }
   382	}
   383	
   384	// =================================== g2p_absorb ===============================================
   385	// Gather the node drain/fill fractions and apply the conserved transfer (atomic-free: each
   386	// particle writes only its own pos.w / chem.x). Water shrinks f_w; grain grows V_abs and ticks
   387	// its wet-contact timer (the bloom clock).
   388	@compute @workgroup_size(256)
   389	fn g2p_absorb(@builtin(global_invocation_id) gid: vec3<u32>) {
   390	    let p = gid.x;
   391	    if (p >= params.particle_count) {
   392	        return;
   393	    }
   394	    let is_water = p < params.water_count;
   395	    let is_solid = p >= (params.particle_count - params.solid_count);
   396	    if (!is_water && !is_solid) {
   397	        return;
   398	    }
   399	    let h = params.grid_origin.w;
   400	    let x = pos[p].xyz;
   401	    if (params.coupling.w > 0.5 && x.y < params.box_min.y) {
   402	        return; // ballistic escaped water: no transfer
   403	    }
   404	    let xl = (x - params.grid_origin.xyz) / h;
   405	    var base = vec3<i32>(floor(xl - vec3<f32>(0.5)));
   406	    base = clamp(base, vec3<i32>(0), vec3<i32>(params.grid_dims.xyz) - vec3<i32>(3));
   407	    let fx = xl - vec3<f32>(base);
   408	    var w = bspline_w(fx);
   409	
   410	    if (is_water) {
   411	        let f_w = pos[p].w;
   412	        if (f_w <= wet_roundoff()) { return; }
   413	        let my_supply = f_w * wet_v_water();
   414	        var loss = 0.0;
   415	        for (var k = 0; k < 3; k = k + 1) {
   416	            for (var j = 0; j < 3; j = j + 1) {
   417	                for (var i = 0; i < 3; i = i + 1) {
   418	                    let wijk = w[i].x * w[j].y * w[k].z;
   419	                    let n = node_index(base + vec3<i32>(i, j, k));
   420	                    let s_n = fp_decode(atomicLoad(&grid_moist[n * 2u + 0u]));
   421	                    let d_n = fp_decode(atomicLoad(&grid_moist[n * 2u + 1u]));
   422	                    if (s_n > 0.0) {
   423	                        let t_n = min(s_n, d_n);   // node transfer (two-sided cap)
   424	                        loss += (wijk * my_supply) * (t_n / s_n); // my weighted drain share
   425	                    }
   426	                }
   427	            }
   428	        }
   429	        // Volume only leaves via the capped share (loss ≤ my_supply by construction).
   430	        let new_f = max(f_w - loss / wet_v_water(), 0.0);
   431	        pos[p] = vec4<f32>(x, new_f);
   432	    } else {
   433	        let v_abs = pos[p].w;
   434	        let demand = wet_demand(v_abs) * bloom_factor(chem[p].x);
   435	        // Wet-contact clock for the bloom gate: a grain touching water (any local supply) ticks
   436	        // its timer regardless of whether it absorbed this step (it can be saturated yet wet).
   437	        var touching = false;
   438	        var gain = 0.0;
   439	        for (var k = 0; k < 3; k = k + 1) {
   440	            for (var j = 0; j < 3; j = j + 1) {
   441	                for (var i = 0; i < 3; i = i + 1) {
   442	                    let wijk = w[i].x * w[j].y * w[k].z;
   443	                    let n = node_index(base + vec3<i32>(i, j, k));
   444	                    let s_n = fp_decode(atomicLoad(&grid_moist[n * 2u + 0u]));
   445	                    let d_n = fp_decode(atomicLoad(&grid_moist[n * 2u + 1u]));
   446	                    if (s_n > 0.0) { touching = true; }
   447	                    if (demand > 0.0 && d_n > 0.0) {
   448	                        let t_n = min(s_n, d_n);
   449	                        gain += (wijk * demand) * (t_n / d_n); // my weighted fill share
   450	                    }
   451	                }
   452	            }
   453	        }
   454	        pos[p] = vec4<f32>(x, v_abs + gain);
   455	        if (touching) {
   456	            chem[p] = vec4<f32>(chem[p].x + params.dt, chem[p].y, chem[p].z, chem[p].w);
   457	        }
   458	    }
   459	}

 succeeded in 0ms:
     1	// U3 incompressibility (plan 2026-06-09-001, KTD-2): coarse-grid pressure seed + a fixed
     2	// budget of fine local damped-Jacobi sweeps — NO converged Poisson solve anywhere.
     3	//
     4	// ================================ OPERATOR FAMILY =============================================
     5	// ONE discretely consistent family on the U2 collocated grid (velocity at nodes):
     6	//
     7	//   pressure p     : CELL CENTERS (fine cells = grid_dims − 1 per axis)
     8	//   divergence D   : corner-trilinear / finite-volume — for cell c with corner nodes n at
     9	//                    offsets o ∈ {0,1}³ and per-axis signs s(o) = 2o − 1:
    10	//                        (D u)_c = Σ_n  s(o)·u_n / (4h)
    11	//                    (the exact derivative of trilinear interpolation at the cell center;
    12	//                    2nd-order, gated by the MMS sweep). Masked rows: inactive cells ≡ 0.
    13	//   gradient G     : G = −Dᵀ BY CONSTRUCTION — the same sign function, gathered the other way:
    14	//                        (G p)_n = −Σ_{adjacent ACTIVE cells c}  s(o(n,c))·p_c / (4h)
    15	//                    Adjointness identity the gates assert on twins AND GPU readbacks:
    16	//                        u·(G p) = −(D u)·p          for ALL u, p, on ANY masks.
    17	//   mass weighting : per-node symmetric constrained inverse-mass matrix
    18	//                        M̃⁻¹_n = invρ_n·(P_box − n̂ n̂ᵀ),    invρ_n = 1 / max(ρ_n, ρ_floor),
    19	//                    where ρ_n = node mass / h³, P_box zeroes box-face axes (mutually
    20	//                    orthogonal), and n̂ is the SDF wall normal orthogonalized against the box
    21	//                    axes — symmetric PSD, so wall-Neumann rows are part of the operator, not
    22	//                    bolted on. Massless nodes get M̃⁻¹ = 0 (the projection never moves them).
    23	//   Laplacian      : EXISTS ONLY AS THE COMPOSITION  A = −D·M̃⁻¹·G,  evaluated inline in the
    24	//                    Jacobi kernels by literally composing the three loops above. Never a
    25	//                    hand-written stencil — a hand stencil is exactly how main got A ≠ D·G and
    26	//                    a divergence floor no iteration could beat.
    27	//   projection     : v ← v − dt·M̃⁻¹·(G p). The divergence the gates measure afterwards uses
    28	//                    THE SAME D, so post-projection divergence = dt·(solver residual): an
    29	//                    operator-inconsistency floor is impossible by construction, and the
    30	//                    decay gate (tests/twofield_pressure.rs) verifies it empirically.
    31	//
    32	// ================================ FREE SURFACE (U3 minimal form) ==============================
    33	// Ghost-fluid-style fraction weighting, refined (not replaced) by U4's fill-fraction Dirichlet
    34	// + bubbles. Every cell carries a fill fraction f ∈ [0, 1] from GRID MASS (mean fluid-visible
    35	// corner-node density vs SURF_FULL_FRAC·ρ_rest, clamped; cells failing the min-corner
    36	// activity test below are empty, f = 0), and the family is row/column-weighted by F = diag(f):
    37	//     D_f = F·D,   G_f = −D_fᵀ = −Dᵀ·F,   A = D_f·M̃⁻¹·D_fᵀ   (still symmetric PSD, any f).
    38	// Interior cells (ρ̄ ≥ SURF_FULL_FRAC·ρ_rest) have f = 1 exactly — the family is UNCHANGED
    39	// there (the MMS/adjointness/SPD gates pin both regimes; the order-of-accuracy claim is for
    40	// the f = 1 rows, surface rows are first-order by design until U4). The pressure Dirichlet
    41	// p = 0 still lives in empty cells, but the constraint rows taper through the partially
    42	// filled band, so the air-side Dirichlet acts at the mass-weighted surface instead of a
    43	// staircase one full cell off. The previous mask (all 8 corners above a bare epsilon) had
    44	// no surface notion at all: it extended FULL-weight rows one cell into the particle-free
    45	// B-spline smear band — the hovering-lid failure described below — and the settled tank
    46	// pumped itself apart (the independent volume gates caught exactly this).
    47	// SURF_* are fixed structural constants of the family (like JACOBI_OMEGA), not gate knobs:
    48	// SURF_FULL_FRAC = 0.5 puts the f-taper strictly above the mean surface line (a cell cut by
    49	// a flat surface has ρ̄ ≈ 0.5·ρ_rest), so interior rows can never flicker below f = 1.
    50	// ACTIVITY is decided by the MINIMUM corner-node density (≥ SURF_MIN_CORNER·ρ_rest), not by
    51	// the mean fill: the quadratic B-spline smears mass 1.5h past the topmost particles, so the
    52	// first PARTICLE-FREE cell above a settled surface still measures mean fill f ≈ 0.5 (its
    53	// bottom corners share the surface nodes' mass) — indistinguishable from a real surface cell
    54	// by any mean-fill cut. Its far-side corners, however, carry ≤ ~0.05·ρ_rest, while a cell
    55	// containing real fluid keeps ALL corners ≥ ~0.25·ρ_rest: the min-corner test is the sharp
    56	// particle-presence discriminator (the U2 "all corners massy" rule with a physical threshold
    57	// instead of an epsilon). Why smear cells must NOT get pressure rows: their row pins their
    58	// floored-M̃⁻¹ dust mass against gravity — a hovering pressurized lid (p 1/f-amplified,
    59	// observed growing 700→4700 over 50 frames) that blocks settling while the bottom's density
    60	// relief keeps pressurizing; the settled tank pumped itself apart. Below the threshold,
    61	// smear/droplet cells are ballistic (no row, implicit p = 0) — U2 behavior, confined to
    62	// near-massless dust. Min-corner ≥ 0.1·ρ_rest also bounds f ≥ 0.2, i.e. the surface-row
    63	// amplification 1/f ≤ 5.
    64	// U4 refinement (surface.wgsl): the implicit p = 0 holds only for air OPEN to the boundary;
    65	// ENCLOSED air (the pour pocket) is flood-fill detected and inserted as constraint rows with
    66	// fill weight 1, pressure pinned to the shared bubble multiplier λ_b — see the BUBBLE
    67	// REPRESENTATION header in surface.wgsl. cell_meta.w carries the cell category
    68	// (CELL_AIR/CELL_POCKET); the pocket pins live in the Jacobi/prolong kernels below.
    69	//
    70	// ================================ COARSE SEED ================================================
    71	// Coarse grid: REDISCRETIZED same family at H = ratio·h (ratio knob {4, 8}; default 4).
    72	//   Why rediscretized and not Galerkin R·A·P: Galerkin requires materializing an explicit
    73	//   coarse stencil — reintroducing the hand-assembled-operator failure surface KTD-2 forbids.
    74	//   Rediscretization reuses this very code path at spacing H (one family, twin-pinned), and
    75	//   the seed CANNOT ship inconsistency: it only seeds the fine sweeps, the projection applies
    76	//   only the fine G, and the gate divergence uses only the fine D. The two-grid convergence
    77	//   gate decides whether the rediscretized coarse operator is consistent ENOUGH to be useful.
    78	//   Coarse masks: a coarse cell is active iff ANY of its ratio³ children is active (binary —
    79	//   the fine fraction taper is deliberately NOT rediscretized; see coarse_cell_setup). Coarse
    80	//   M̃⁻¹: hat-weighted restriction of the fine M̃⁻¹ field (see coarse_node_setup).
    81	// Transfers: R = masked trilinear-transpose restriction with a FIXED 1/ratio³ volume weight
    82	//   (no mask renormalization — that is what keeps R = Pᵀ/ratio³ exact), P = the same masked
    83	//   hat weights gathered the other way. Gate: ⟨R u, v⟩_c = ⟨u, P v⟩_f (volume-weighted).
    84	// Solve shape per frame (two-grid correction scheme, p₀ = 0 — no warm start):
    85	//   rhs = (s_target − D v)/dt → PRE-SMOOTH (Nf/2 fine sweeps) → residual r = rhs − A·p →
    86	//   restrict r → Nc coarse Jacobi sweeps on A_c·e = r_c from 0 → prolongate-and-ADD the
    87	//   correction → POST-SMOOTH (remaining fine sweeps) → project.
    88	//   Pre-smoothing + RESIDUAL restriction (not raw-rhs restriction) is load-bearing: the
    89	//   production rhs is boundary-concentrated (the hydrostatic source is a one-fine-layer spike
    90	//   at the floor), which a ratio-4 restriction cannot represent consistently — seeding from
    91	//   the raw rhs measurably overshoots and pumps energy (observed: settled tank erupting).
    92	//   Pre-smoothing absorbs the spike locally, so the restricted residual is smooth — the
    93	//   regime where the R/P pair is consistent.
    94	//
    95	// Density relief (volume-conservation feedback): the projection constrains the VELOCITY
    96	// divergence only, so any finite per-frame solve error compacts positions monotonically and
    97	// the rhs never sees it (a fully-compacted tank measures ZERO divergence — the failure the
    98	// independent volume gates exist to catch). The rhs therefore carries a one-sided density
    99	// source — the same projection-RHS plumbing KTD-4 later formalizes as s_net:
   100	//     rhs_c = (s_target − D v)/dt,  s_target = max(ρ̄_c/ρ_rest − 1, 0)/(DENSITY_RELAX·dt),
   101	// with ρ̄_c the mean corner-node density: compression is relieved over a few frames; an
   102	// under-dense (free-surface) cell gets NO suction — surface physics belongs to U4.
   103	//
   104	// ================================ MIXTURE FAMILY (U6, KTD-4) ==================================
   105	// With the U6 solid field present the constraint becomes the mixture continuity
   106	// ∇·(φ_f·v_f + φ_s·v_s) = s with v_s ≡ 0 (rigid skeleton): the divergence weights each
   107	// corner-node velocity by that node's φ_f (the nm b.w lane, from node_setup), and the same
   108	// φ_f scales the node mobility in the operator,
   109	//     A = −D·Φ·M̃⁻¹·G,   Φ = diag(φ_f per node)   (scalar per node ⇒ A stays symmetric PSD),
   110	// while the velocity correction applied by `project` is M̃⁻¹·(G p) WITHOUT φ — per KTD-4 the
   111	// intrinsic-velocity correction is Δv = −(Δt_eff/ρ_w)∇p and φ never scales it. Two more U6
   112	// ingredients live inside M̃⁻¹ itself (node_setup): the node density is the INTRINSIC water
   113	// density ρ_n/φ_f (the bulk pore-water density under-states ρ_w by φ_f), and the matrix is
   114	// scaled by ς = Δt_eff/Δt, the exponential-integrator weight from the drag fold (see
   115	// coupling.wgsl's header for why the plain-Δt split mis-partitions the hydrostatic load).
   116	// All three are exact-passthrough at φ_f = 1, ς = 1 (multiplication/division by exactly 1.0
   117	// is bitwise-identical — the free-water regression gate pins this). cell_classify's density
   118	// census normalizes by the corner φ_f for the same reason: a saturated pore cell at
   119	// ρ̄ = φ_f·ρ_rest is FULL, not a surface cell, and must get neither relief nor suction.
   120	//
   121	// Damped Jacobi: p ← p + ω·(rhs − A p)/diag(A), ω = JACOBI_OMEGA (fixed algorithmic constant,
   122	// mirrored in mod.rs for the CPU twins), diag(A)_c = Σ_n s(o)ᵀ·M̃⁻¹_n·s(o) / (16h²).
   123	//
   124	// Adaptive-Tait predictor (KTD-2 option): STUBBED OFF — deliberately not implemented in U3.
   125	// The knob grid pins Tait ∈ {off}; if a later unit shows an iteration-budget win it ships
   126	// behind an opt-in Config gate, else it is removed (plan: "Deferred to Implementation").
   127	//
   128	// Sparsity: over-dispatch + early-out on inactive cells/empty nodes — NEVER indirect dispatch
   129	// (R8). Tint discipline: no workgroupBarrier anywhere in this family, so the guard returns
   130	// are uniform-control-flow safe. Storage buffers per entry point ≤ 5 (see mod.rs derivation).
   131	
   132	// --- pressure-family bindings (indices continue the global table in common.wgsl) -------------
   133	// Per-node M̃⁻¹, 2 vec4 per node: [2n] = (xx, xy, xz, yy), [2n+1] = (yz, zz, massy_flag, 0).
   134	@group(0) @binding(9) var<storage, read_write> nm: array<vec4<f32>>;
   135	// Per fine cell: (rhs, fill fraction f ∈ [0,1] — 0 = empty/masked, residual/dbg lane, unused).
   136	@group(0) @binding(10) var<storage, read_write> cell_meta: array<vec4<f32>>;
   137	// Fine pressure ping-pong. The shader always reads 11 and writes 12; the alternating bind
   138	// groups swap which buffer sits at which index (pf_a starts as the seed slot).
   139	@group(0) @binding(11) var<storage, read_write> pf_src: array<f32>;
   140	@group(0) @binding(12) var<storage, read_write> pf_dst: array<f32>;
   141	// Coarse mirrors of 9/10/11/12.
   142	@group(0) @binding(13) var<storage, read_write> nm_c: array<vec4<f32>>;
   143	@group(0) @binding(14) var<storage, read_write> cmeta: array<vec4<f32>>;
   144	@group(0) @binding(15) var<storage, read_write> pc_src: array<f32>;
   145	@group(0) @binding(16) var<storage, read_write> pc_dst: array<f32>;
   146	
   147	// Mirrors twofield::JACOBI_OMEGA (see the symbol-bound derivation there: λ_max(diag⁻¹A) = 8/3
   148	// for this corner family, so ω must be < 0.75; 2/3 is the weighted-Jacobi choice).
   149	const JACOBI_OMEGA: f32 = 0.6666667;
   150	// Density-relief time constant in frames (fixed structural constant, like JACOBI_OMEGA —
   151	// mirrors twofield::DENSITY_RELAX_FRAMES, derivation there: equilibrium compaction drift
   152	// ≈ residual·N·dt ≈ 1% — inside the ±5% band — while keeping the relief of a seeded
   153	// over-density gentle, v ~ Δx/τ, instead of detonating it into slosh).
   154	const DENSITY_RELAX_FRAMES: f32 = 30.0;
   155	// Uncapped density-target dead-band (dbg.w on): density error |e| below this is treated as zero
   156	// (no chatter on near-rest cells). Default 0 (no dead-band) until calibration finds a value; like
   157	// DENSITY_RELAX_FRAMES it is a structural const, not a Params slot.
   158	const DENSITY_TARGET_DEADBAND: f32 = 0.0;
   159	// SETTLED-POOL STIRRING — diagnosis (no in-solver fix yet; see twofield_settled.rs).
   160	// A settled pool slowly churns. Isolation (water tank, settled-tail KE): baseline ~67; relief OFF
   161	// ~7.6; 32 fine sweeps (vs 8) ~17; pure PIC (kill the affine C) ~1.3. So the mechanism is a limit
   162	// cycle: the local-Jacobi pressure solve is intentionally UNDER-converged (8+8 sweeps, no global
   163	// Poisson — the real-time design), leaving a standing density error; the density relief faithfully
   164	// converts that error into a velocity each frame; the lossless APIC affine field accumulates it (no
   165	// numerical dissipation); the pool sloshes and re-creates the error. Two clamps were MEASURED and
   166	// rejected: a global G2P APIC→PIC blend quiets the pool but freezes the deformable-bed crater slump
   167	// (which rides on the same agitation — even blend 0.02 froze it); a φ_f-gated relief dead-band does
   168	// not reach the churn (the standing error exceeds a tolerable band). The honest cures all trade a
   169	// pre-registered gate — more fine sweeps (R9 perf), carrier dissipation (the crater) — so the lever
   170	// is a product decision, deferred. The relief below stays the original un-banded feedback.
   171	// Free-surface fill-fraction constants (header: FREE SURFACE; mirrored in twofield/mod.rs).
   172	const SURF_FULL_FRAC: f32 = 0.5;
   173	const SURF_MIN_CORNER: f32 = 0.1;
   174	const NODE_BC_EPS: f32 = 1.0e-4;     // box-face epsilon (matches grid_update)
   175	const SDF_NORMAL_MIN: f32 = 1.0e-3;  // degenerate orthogonalized-normal guard
   176	// SDF no-penetration band in cell sizes: a node within WALL_BAND·h on the FLUID side of a wall
   177	// gets the wall-normal projector (the supporting fluid layer of a non-grid-aligned wall). Mirror
   178	// of `drag_fold`'s velocity BC band in coupling.wgsl — they MUST match for operator consistency.
   179	const WALL_BAND: f32 = 1.0;
   180	// Flood-fill OUTSIDE seed band in cell sizes (surface.wgsl flood_init): an air cell within
   181	// FLOOD_WALL_BAND·h of an SDF wall is seeded OPEN. Wider than WALL_BAND so the seed reaches the
   182	// CENTER of a ~1-cell-wide SDF channel (the V60 cone apex hole, radius 0.42 ≈ 1.3 cells) and
   183	// keeps it conductive — connecting the cup/cone air to the open top. Purely a pocket-detection
   184	// aid (no operator/BC effect), so it carries no operator-consistency constraint.
   185	const FLOOD_WALL_BAND: f32 = 2.0;
   186	
   187	// SDF wall BC mode (params.dbg.y, plan 2026-06-17-002):
   188	//   ≤ 0.5  → WALL_BC_SINGLE (default): the single most-penetrated normal (solid_union) banded over
   189	//            WALL_BAND·h — the original behavior, kept byte-identical here.
   190	//   > 0.5  → WALL_BC_MULTI: the orthonormal-basis projector P = I − Q·Qᵀ over ALL in-band faces
   191	//            (build_constraint_basis in common.wgsl), constraining BOTH surfaces at a concave seam
   192	//            (the cup floor∩wall corner). node_setup builds M̃⁻¹ = invr·P; drag_fold applies
   193	//            v ← P·v from the SAME basis (lockstep — A = D·M̃⁻¹·G holds).
   194	fn wall_bc_multi() -> bool { return params.dbg.y > 0.5; }
   195	
   196	// --- fine-grid cell helpers --------------------------------------------------------------------
   197	fn fine_cells() -> vec3<u32> {
   198	    return params.grid_dims.xyz - vec3<u32>(1u);
   199	}
   200	fn num_fine_cells() -> u32 {
   201	    let c = fine_cells();
   202	    return c.x * c.y * c.z;
   203	}
   204	fn cell_index(c: vec3<i32>) -> u32 {
   205	    let nc = fine_cells();
   206	    return u32(c.x) + nc.x * (u32(c.y) + nc.y * u32(c.z));
   207	}
   208	fn cell_coords(flat: u32) -> vec3<u32> {
   209	    let nc = fine_cells();
   210	    return vec3<u32>(flat % nc.x, (flat / nc.x) % nc.y, flat / (nc.x * nc.y));
   211	}
   212	fn cell_in_range(c: vec3<i32>) -> bool {
   213	    let nc = vec3<i32>(fine_cells());
   214	    return all(c >= vec3<i32>(0)) && all(c < nc);
   215	}
   216	
   217	// --- coarse-grid helpers (same layout at H = ratio·h, same origin) ------------------------------
   218	fn coarse_cells() -> vec3<u32> {
   219	    return params.coarse_dims.xyz;
   220	}
   221	fn num_coarse_cells() -> u32 {
   222	    let c = coarse_cells();
   223	    return c.x * c.y * c.z;
   224	}
   225	fn coarse_nodes() -> vec3<u32> {
   226	    return params.coarse_dims.xyz + vec3<u32>(1u);
   227	}
   228	fn num_coarse_nodes() -> u32 {
   229	    let n = coarse_nodes();
   230	    return n.x * n.y * n.z;
   231	}
   232	fn ccell_index(c: vec3<i32>) -> u32 {
   233	    let nc = coarse_cells();
   234	    return u32(c.x) + nc.x * (u32(c.y) + nc.y * u32(c.z));
   235	}
   236	fn ccell_coords(flat: u32) -> vec3<u32> {
   237	    let nc = coarse_cells();
   238	    return vec3<u32>(flat % nc.x, (flat / nc.x) % nc.y, flat / (nc.x * nc.y));
   239	}
   240	fn ccell_in_range(c: vec3<i32>) -> bool {
   241	    let nc = vec3<i32>(coarse_cells());
   242	    return all(c >= vec3<i32>(0)) && all(c < nc);
   243	}
   244	fn cnode_index(n: vec3<u32>) -> u32 {
   245	    let nn = coarse_nodes();
   246	    return n.x + nn.x * (n.y + nn.y * n.z);
   247	}
   248	
   249	// --- M̃⁻¹ load/apply ----------------------------------------------------------------------------
   250	struct Minv { a: vec4<f32>, b: vec4<f32> }
   251	
   252	fn minv_apply(m: Minv, v: vec3<f32>) -> vec3<f32> {
   253	    return vec3<f32>(
   254	        m.a.x * v.x + m.a.y * v.y + m.a.z * v.z,
   255	        m.a.y * v.x + m.a.w * v.y + m.b.x * v.z,
   256	        m.a.z * v.x + m.b.x * v.y + m.b.y * v.z,
   257	    );
   258	}
   259	
   260	// Corner sign vector for offset o ∈ {0,1}³ (the ONE sign function D, G, and diag(A) share).
   261	fn corner_sign(o: vec3<i32>) -> vec3<f32> {
   262	    return vec3<f32>(o) * 2.0 - vec3<f32>(1.0);
   263	}
   264	
   265	// Per-axis hat weight between fine cell fi and coarse cell ci at ratio r — the single weight
   266	// function R and P share (transpose pair by construction; mirrored by the CPU twin `hat`).
   267	fn hat_w(fi: i32, ci: i32, r: i32) -> f32 {
   268	    let x = f32(fi) + 0.5;
   269	    let xc = f32(ci * r) + f32(r) * 0.5;
   270	    return max(0.0, 1.0 - abs(x - xc) / f32(r));
   271	}
   272	
   273	// =================================== node_setup ================================================
   274	// Build M̃⁻¹ per fine node from this frame's node mass (grid_vel.w) and the wall geometry.
   275	// U6: the matrix carries the intrinsic-density inverse 1/(ρ_n/φ_f) and the ς integrator
   276	// weight from the drag fold (header: MIXTURE FAMILY); b.w carries φ_f for the divergence
   277	// weighting and the cell census (written for EVERY node, massy or not).
   278	@compute @workgroup_size(256)
   279	fn node_setup(@builtin(global_invocation_id) gid: vec3<u32>) {
   280	    let n = gid.x;
   281	    if (n >= params.grid_dims.w) {
   282	        return;
   283	    }
   284	    var a = vec4<f32>(0.0);
   285	    var b = vec4<f32>(0.0);
   286	    let mass = grid_vel[n].w;
   287	    let h = params.grid_origin.w;
   288	    let sig = react[n].w;
   289	    let c = node_coords(n);
   290	    let xp = params.grid_origin.xyz + vec3<f32>(f32(c.x), f32(c.y), f32(c.z)) * h;
   291	    // φ_f from the solid field, wall-truncation-normalized (node_phi_f in coupling.wgsl —
   292	    // skips the vis loop entirely at zero-solid nodes: exact passthrough φ_f = 1.0).
   293	    let phi_f = node_phi_f(n, xp);
   294	    let open_base = params.coupling.w > 0.5;
   295	    // Strictly-outside-the-box nodes are inside the walls: v = 0 in drag_fold, M̃⁻¹ = 0
   296	    // here (the projection never moves them) — one consistent treatment across the family.
   297	    // The open base exempts the below-floor pad layer, mirroring drag_fold's BC.
   298	    var out_lo = xp < params.box_min.xyz - vec3<f32>(NODE_BC_EPS);
   299	    if (open_base) {
   300	        out_lo.y = false;
   301	    }
   302	    let outside = any(out_lo) || any(xp > params.box_max.xyz + vec3<f32>(NODE_BC_EPS));
   303	    if (mass > params.extra.z && !outside) {
   304	        // Intrinsic water density (KTD-4): the node measures the BULK pore-water density
   305	        // φ_f·ρ_w; dividing by φ_f recovers ρ_w so the correction is Δv = −(Δt_eff/ρ_w)∇p.
   306	        let rho = mass / (h * h * h) / phi_f;
   307	
   308	        // Wall-truncated control volume: count the node's 8 adjacent cell slots whose center
   309	        // is inside the box and not inside a solid. A wall/edge/corner node sees only
   310	        // vis/8 of its slots, so BOTH its gathered gradient (G sums those slots) AND its
   311	        // measured density are truncated by the same factor — flooring the density at
   312	        // vis·ρ_rest/8 instead of ρ_rest keeps invρ·(G p) equal to the full physical
   313	        // gradient there. With the global ρ_rest floor, box-EDGE nodes (2 of 8 slots) got a
   314	        // 4×-truncated kick, their columns kept ~half of gravity every frame, and the tank
   315	        // pumped itself into sloshing (observed). Surface nodes are NOT rescaled: air slots
   316	        // are geometrically visible, so vis = 8 and the stable under-kick floor remains.
   317	        let vis = node_vis(xp);
   318	        let invr = 1.0 / max(rho, params.extra.y * max(vis, 1.0) / 8.0);
   319	
   320	        // Box faces: mutually orthogonal axis constraints (exact projector). The open base
   321	        // leaves the y-min face free (the outflow Dirichlet lives in the masked pad cells).
   322	        var d = vec3<f32>(invr);
   323	        if (xp.x <= params.box_min.x + NODE_BC_EPS || xp.x >= params.box_max.x - NODE_BC_EPS) { d.x = 0.0; }
   324	        if ((xp.y <= params.box_min.y + NODE_BC_EPS && !open_base)
   325	            || xp.y >= params.box_max.y - NODE_BC_EPS) { d.y = 0.0; }
   326	        if (xp.z <= params.box_min.z + NODE_BC_EPS || xp.z >= params.box_max.z - NODE_BC_EPS) { d.z = 0.0; }
   327	        a = vec4<f32>(d.x, 0.0, 0.0, d.y);
   328	        b = vec4<f32>(0.0, d.z, 1.0, 0.0);
   329	
   330	        // SDF wall: subtract the dyad of the (box-orthogonalized) unit normal — symmetric PSD.
   331	        // The constraint must engage on the FLUID node layer adjacent to the wall, not only on
   332	        // nodes strictly inside the wall material (hit.dist < 0): an SDF surface (e.g. the cup
   333	        // floor at y = -8) almost never coincides with a node, so the node that actually carries
   334	        // the supporting fluid column sits up to one cell OUTSIDE the wall (hit.dist ∈ [0, h)).
   335	        // With the old `< 0` test that node was left y-FREE, gravity drove the column into the
   336	        // floor unchecked, and it pancaked to 10–20× rest (the V60-cup collapse the box-face
   337	        // floor never showed, because there nodes land exactly on the face). The band is the
   338	        // cell size h — the standard staircase reach of a collocated no-penetration BC. The
   339	        // SAME band is mirrored in drag_fold's velocity BC so the pre-projection field D sees and
   340	        // M̃⁻¹ constrains the SAME axes (operator consistency A = D·M̃⁻¹·G).
   341	        if (params.num_solids > 0u) {
   342	            if (!wall_bc_multi()) {
   343	                // SINGLE-NORMAL (default): the most-penetrated normal, box-orthogonalized, banded.
   344	                let hit = solid_union(xp, PHASE_WATER);
   345	                if (hit.dist < WALL_BAND * h) {
   346	                    var nrm = hit.grad;
   347	                    if (d.x == 0.0) { nrm.x = 0.0; }
   348	                    if (d.y == 0.0) { nrm.y = 0.0; }
   349	                    if (d.z == 0.0) { nrm.z = 0.0; }
   350	                    let len = length(nrm);
   351	                    if (len > SDF_NORMAL_MIN) {
   352	                        nrm = nrm / len;
   353	                        let invc = max(max(d.x, d.y), d.z);
   354	                        a -= invc * vec4<f32>(nrm.x * nrm.x, nrm.x * nrm.y, nrm.x * nrm.z, nrm.y * nrm.y);
   355	                        b -= invc * vec4<f32>(nrm.y * nrm.z, nrm.z * nrm.z, 0.0, 0.0);
   356	                    }
   357	                }
   358	            } else {
   359	                // MULTI-NORMAL: rebuild M̃⁻¹ = invr·(I − Q·Qᵀ) over the active box axes + ALL in-band
   360	                // wall faces (orthonormal basis). Reduces to the single/box paths in their limits;
   361	                // PSD for any normals (even a non-orthogonal poly edge). drag_fold mirrors the SAME
   362	                // basis (lockstep). box_mask matches the box-face axes zeroed in `d` above.
   363	                var box_mask = 0u;
   364	                if (d.x == 0.0) { box_mask = box_mask | 1u; }
   365	                if (d.y == 0.0) { box_mask = box_mask | 2u; }
   366	                if (d.z == 0.0) { box_mask = box_mask | 4u; }
   367	                let faces = wall_binding_faces(xp, PHASE_WATER, WALL_BAND * h);
   368	                let cb = build_constraint_basis(box_mask, faces);
   369	                var pxx = 1.0; var pyy = 1.0; var pzz = 1.0;
   370	                var pxy = 0.0; var pxz = 0.0; var pyz = 0.0;
   371	                for (var i = 0u; i < cb.count; i = i + 1u) {
   372	                    let q = cb.q[i];
   373	                    pxx = pxx - q.x * q.x; pyy = pyy - q.y * q.y; pzz = pzz - q.z * q.z;
   374	                    pxy = pxy - q.x * q.y; pxz = pxz - q.x * q.z; pyz = pyz - q.y * q.z;
   375	                }
   376	                a = invr * vec4<f32>(pxx, pxy, pxz, pyy);
   377	                b = vec4<f32>(invr * pyz, invr * pzz, 1.0, 0.0);
   378	            }
   379	        }
   380	        // ς fold (header: MIXTURE FAMILY): the projection's effective step at a drag node is
   381	        // Δt_eff = ς·Δt, carried INSIDE the matrix so A and `project` stay one family. ×1.0
   382	        // exact at drag-free nodes.
   383	        a = a * sig;
   384	        b.x = b.x * sig;
   385	        b.y = b.y * sig;
   386	    }
   387	    nm[2u * n + 0u] = a;
   388	    nm[2u * n + 1u] = vec4<f32>(b.x, b.y, b.z, phi_f);
   389	}
   390	
   391	// =================================== cell_classify =============================================
   392	// Per fine cell: fill fraction f from grid mass (header: FREE SURFACE — f = 0 masks the cell,
   393	// f < 1 tapers its row through the surface band), rhs = f·(s_target − D(Φv))/dt on fluid rows
   394	// (the U6 MIXTURE divergence — v_s = 0 contributes nothing), and zero both pressure
   395	// ping-pong slots (the deterministic p₀ = 0 — the coarse prolongation overwrites the seed
   396	// when enabled). The density census divides each corner mass by its φ_f so a saturated pore
   397	// cell measures RELATIVE density ≈ 1 (header: MIXTURE FAMILY) — both ×/÷ by exactly 1.0 in
   398	// free water.
   399	@compute @workgroup_size(256)
   400	fn cell_classify(@builtin(global_invocation_id) gid: vec3<u32>) {
   401	    let c = gid.x;
   402	    if (c >= num_fine_cells()) {
   403	        return;
   404	    }
   405	    pf_src[c] = 0.0;
   406	    pf_dst[c] = 0.0;
   407	    let h = params.grid_origin.w;
   408	    let cc = vec3<i32>(cell_coords(c));
   409	    var div = 0.0;
   410	    var mass = 0.0;
   411	    var cnt = 0.0;
   412	    var mmin = 3.402823e38; // f32 max
   413	    for (var oz = 0; oz < 2; oz = oz + 1) {
   414	        for (var oy = 0; oy < 2; oy = oy + 1) {
   415	            for (var ox = 0; ox < 2; ox = ox + 1) {
   416	                let node = cc + vec3<i32>(ox, oy, oz);
   417	                let nflat = node_index(node);
   418	                let gv = grid_vel[nflat];
   419	                let phin = nm[2u * nflat + 1u].w; // φ_f (node_setup runs first)
   420	                let s = corner_sign(vec3<i32>(ox, oy, oz));
   421	                div = div + dot(s, phin * gv.xyz) / (4.0 * h);
   422	                // Corner census for classification: only corners that COULD see fluid count —
   423	                // nodes at/behind the box faces or inside an SDF solid are geometrically
   424	                // truncated (a wall, not a surface) and must not deactivate wall-hugging
   425	                // cells (observed: the min-corner rule silently dropped the box-edge cell
   426	                // columns, whose particles then free-fell, pumping the tank).
   427	                let xp = params.grid_origin.xyz
   428	                    + vec3<f32>(f32(node.x), f32(node.y), f32(node.z)) * h;
   429	                var wallish = any(xp <= params.box_min.xyz + vec3<f32>(NODE_BC_EPS))
   430	                    || any(xp >= params.box_max.xyz - vec3<f32>(NODE_BC_EPS));
   431	                if (!wallish && params.num_solids > 0u) {
   432	                    wallish = solid_union(xp, PHASE_WATER).dist < 0.0;
   433	                }
   434	                if (!wallish) {
   435	                    mass = mass + gv.w / phin;
   436	                    cnt = cnt + 1.0;
   437	                    mmin = min(mmin, gv.w / phin);
   438	                }
   439	            }
   440	        }
   441	    }
   442	    // Fill fraction from the mean fluid-visible RELATIVE corner density (φ-normalized above,
   443	    // so a saturated pore cell reads ≈ ρ_rest); ACTIVITY requires BOTH the min fluid-visible
   444	    // corner density (header: FREE SURFACE) AND particle presence in the cell (cell_cnt —
   445	    // the U4 sharp discriminator; see common.wgsl for the frozen-chimney failure the mass
   446	    // tests alone cannot resolve). Sub-eps nodes were mass-gated to v = 0 by grid_update, so
   447	    // D reads 0 from them — consistent with M̃⁻¹ = 0 there.
   448	    let h3 = h * h * h;
   449	    let rho = mass / (max(cnt, 1.0) * h3);
   450	    var f = clamp(rho / (SURF_FULL_FRAC * params.extra.x), 0.0, 1.0);
   451	    if (cnt == 0.0 || mmin < SURF_MIN_CORNER * params.extra.x * h3
   452	        || atomicLoad(&cell_cnt[c]) == 0u) {
   453	        f = 0.0;
   454	    }
   455	    let center = params.grid_origin.xyz + (vec3<f32>(cc) + vec3<f32>(0.5)) * h;
   456	    var geom_blocked = false;
   457	    if (any(center < params.box_min.xyz) || any(center > params.box_max.xyz)) {
   458	        f = 0.0;
   459	        geom_blocked = true;
   460	    }
   461	    if (!geom_blocked && params.num_solids > 0u) {
   462	        let hit = solid_union(center, PHASE_WATER);
   463	        if (hit.dist < 0.0) {
   464	            f = 0.0;
   465	            geom_blocked = true;
   466	        }
   467	    }
   468	    // U4 category lane (.w): in-box fluid-free cells are AIR — flood-fill candidates for the
   469	    // pocket detection (surface.wgsl); wall/out-of-box cells are never air. pocket_mark
   470	    // upgrades enclosed air to CELL_POCKET (fill weight 1, constraint row). flood_init seeds the
   471	    // OUTSIDE label not only from the open top face but also from every WALL-ADJACENT air cell
   472	    // (see its header): a sub-resolution void at an SDF wall — the gap that opens at the very
   473	    // bottom of a fluid column resting on the non-grid-aligned cup floor, OR a cell at the cone
   474	    // apex pinch — is OPEN (fluid settles into it / it vents through the wall gap), never trapped
   475	    // gas at this resolution. Keeping such cells CELL_AIR (not masked) is what lets the flood
   476	    // CONDUCT through the ~1-cell cone apex hole and reach the cup air below; seeding them OUTSIDE
   477	    // is what stops the bottom-of-column gap from becoming a crushing pocket.
   478	    var cat = 0.0;
   479	    if (f <= 0.0 && !geom_blocked) {
   480	        cat = CELL_AIR;
   481	    }
   482	    // Density relief, over-density half (header: "Density relief"): fluid-visible corner
   483	    // density vs rest. The UNDER-density half (suction) is applied by pocket_mark in
   484	    // surface.wgsl — it needs the air classification of the 6-neighborhood, which does not
   485	    // exist yet in this pass (suction must never act on air-adjacent surface cells, or the
   486	    // surface band pumps itself upward; an interior rarefied region, e.g. the channel a jet
   487	    // tears open, MUST be re-compacted or it stands forever as a frozen void — observed).
   488	    // The mean corner density rides along in .z for that pass (the residual lane, free until
   489	    // `residual` runs).
   490	    // dbg.x gates the relief on/off (1 in production; 0 only in the stirring isolation arm). The
   491	    // relief is the original un-banded volume-conservation feedback. (A φ_f-gated dead-band — clamp
   492	    // the relief in open water to break the settled-pool limit cycle — was MEASURED and rejected:
   493	    // the settled density error the relief tracks exceeds the band, so a 1–2% dead-band does not
   494	    // reach the churn and a band large enough would tolerate that much permanent compression. The
   495	    // churn is pressure under-convergence, not a noise ripple a clamp can cut; see the
   496	    // DENSITY_RELAX_FRAMES header.)
   497	    // Over-density (+) half of the density source. Legacy (dbg.w ≤ 0.5): rate-limited by
   498	    // DENSITY_RELAX_FRAMES. Uncapped path (dbg.w > 0.5): the full predicted error e at
   499	    // density-error dimension (rate e/dt ⇒ rhs e/dt²), dead-banded by DENSITY_TARGET_DEADBAND —
   500	    // full-strength relief driving ρ→ρ₀. Calibration found this is THE over-pack lever, stable
   501	    // because it is a bounded restoring target (a compliance/αI regularization was tried and
   502	    // dropped — it only re-softened the response). Both paths multiply by dbg.x so the
   503	    // stirring-isolation gate (dbg.x = 0) still zeros the source. The under-density (−) half is
   504	    // the interior-gated surface.wgsl pass (KTD5).
   505	    // Temper-K rate divisor for the uncapped path (dbg.z): legacy uses DENSITY_RELAX_FRAMES (=30,
   506	    // slow → mushy); full uncap = K=1 (crisp but pumps energy on coupled scenes); the calibrated
   507	    // sweet spot is K∈(1,30). dbg.z default 0 ⇒ K=1 (full uncap). Smaller K = stiffer/crisper.
   508	    let kfac = max(params.dbg.z, 1.0);
   509	    let e_over = rho / params.extra.x - 1.0;
   510	    var s_target: f32;
   511	    if (params.dbg.w > 0.5) {
   512	        s_target = params.dbg.x * max(e_over - DENSITY_TARGET_DEADBAND, 0.0) / (kfac * params.dt);
   513	    } else {
   514	        s_target = params.dbg.x * max(e_over, 0.0) / (DENSITY_RELAX_FRAMES * params.dt);
   515	    }
   516	    cell_meta[c] = vec4<f32>(select(0.0, f * (s_target - div) / params.dt, f > 0.0), f, rho, cat);
   517	}
   518	
   519	// =================================== coarse setup ==============================================
   520	// Coarse M̃⁻¹ by hat-weighted RESTRICTION of the fine M̃⁻¹ field over the coarse node's
   521	// support (per-axis weight 1 − |Δ|/r, Δ in fine nodes; convex combination of symmetric PSD
   522	// matrices, so the result stays symmetric PSD). NOT point injection from the coincident fine
   523	// node: a coarse surface cell can land its injected corner on a single massless/degenerate
   524	// fine sample, making the coarse row near-singular — observed as intermittent catastrophic
   525	// solve spikes (p ~ −10⁴, nearly constant in depth: a near-nullspace component) whenever the
   526	// moving surface crossed a coarse corner. The restriction is the faithful rediscretization
   527	// and is mirrored by the CPU twin (`coarsen`).
   528	@compute @workgroup_size(256)
   529	fn coarse_node_setup(@builtin(global_invocation_id) gid: vec3<u32>) {
   530	    let n = gid.x;
   531	    if (n >= num_coarse_nodes()) {
   532	        return;
   533	    }
   534	    let nn = coarse_nodes();
   535	    let i = vec3<u32>(n % nn.x, (n / nn.x) % nn.y, n / (nn.x * nn.y));
   536	    let r = i32(params.coarse_dims.w);
   537	    let f0 = vec3<i32>(i) * r;
   538	    let nd = vec3<i32>(params.grid_dims.xyz);
   539	    var wsum = 0.0;
   540	    var sa = vec4<f32>(0.0);
   541	    var sb = vec4<f32>(0.0);
   542	    for (var dz = -(r - 1); dz <= r - 1; dz = dz + 1) {
   543	        for (var dy = -(r - 1); dy <= r - 1; dy = dy + 1) {
   544	            for (var dx = -(r - 1); dx <= r - 1; dx = dx + 1) {
   545	                let fnode = f0 + vec3<i32>(dx, dy, dz);
   546	                if (any(fnode < vec3<i32>(0)) || any(fnode >= nd)) {
   547	                    continue;
   548	                }
   549	                let w = (1.0 - abs(f32(dx)) / f32(r))
   550	                    * (1.0 - abs(f32(dy)) / f32(r))
   551	                    * (1.0 - abs(f32(dz)) / f32(r));
   552	                let fidx = node_index(fnode);
   553	                sa = sa + w * nm[2u * fidx + 0u];
   554	                sb = sb + w * nm[2u * fidx + 1u];
   555	                wsum = wsum + w;
   556	            }
   557	        }
   558	    }
   559	    let inv = 1.0 / max(wsum, 1.0e-20);
   560	    nm_c[2u * n + 0u] = sa * inv;
   561	    nm_c[2u * n + 1u] = sb * inv;
   562	}
   563	
   564	// Coarse cell mask: SATURATED fractions (binary — active iff any active child). The fine
   565	// taper is deliberately NOT rediscretized to the coarse level: under A = F·L·F the exact
   566	// pressure at an f ≪ 1 row is legitimately 1/f-amplified (it is level- and cell-LOCAL; only
   567	// f·p is physical), so prolongating a tapered-coarse-row correction onto neighboring f = 1
   568	// fine cells injects 1/f_C-amplified garbage into the bulk (observed: ~1e5-scale corrections
   569	// from f_C ~ 0.003 coarse cells erupting the settled tank within frames). The taper band is
   570	// thinner than a coarse cell anyway — surface rows are smoothed at fine level only. Also
   571	// restricts the rhs (R = masked trilinear transpose with the fixed 1/ratio³ volume weight)
   572	// and zeroes the coarse pressure ping-pong.
   573	@compute @workgroup_size(256)
   574	fn coarse_cell_setup(@builtin(global_invocation_id) gid: vec3<u32>) {
   575	    let c = gid.x;
   576	    if (c >= num_coarse_cells()) {
   577	        return;
   578	    }
   579	    pc_src[c] = 0.0;
   580	    pc_dst[c] = 0.0;
   581	    let cc = vec3<i32>(ccell_coords(c));
   582	    let r = i32(params.coarse_dims.w);
   583	
   584	    var fc = 0.0;
   585	    var has_fluid = false;
   586	    var has_pocket = false;
   587	    for (var dz = 0; dz < r; dz = dz + 1) {
   588	        for (var dy = 0; dy < r; dy = dy + 1) {
   589	            for (var dx = 0; dx < r; dx = dx + 1) {
   590	                let f = cc * r + vec3<i32>(dx, dy, dz);
   591	                if (cell_in_range(f)) {
   592	                    let cm = cell_meta[cell_index(f)];
   593	                    if (cm.y > 0.0) {
   594	                        fc = 1.0;
   595	                        if (cm.w == CELL_POCKET) {
   596	                            has_pocket = true;
   597	                        } else {
   598	                            has_fluid = true;
   599	                        }
   600	                    }
   601	                }
   602	            }
   603	        }
   604	    }
   605	    // U4 pocket-coarse flag: EVERY active child a pocket cell (mixed boundary cells stay
   606	    // fluid rows — the same rediscretization doctrine as the un-rediscretized surface taper;
   607	    // the restricted residual carries the boundary content and the fine sweeps smooth it).
   608	    var cw = 0.0;
   609	    if (has_pocket && !has_fluid) {
   610	        cw = CELL_POCKET;
   611	        // U8 R9 fix: append to the compacted coarse pocket list (slot 0 = count); bubble_coarse
   612	        // strides this list instead of all coarse cells. flood_init reset the counter this frame.
   613	        let slot = atomicAdd(&pocket_c[0], 1u);
   614	        atomicStore(&pocket_c[slot + 1u], c);
   615	    }
   616	
   617	    var sum = 0.0;
   618	    if (fc > 0.0) {
   619	        let lo = cc * r - vec3<i32>(r / 2);
   620	        for (var dz = 0; dz < 2 * r; dz = dz + 1) {
   621	            for (var dy = 0; dy < 2 * r; dy = dy + 1) {
   622	                for (var dx = 0; dx < 2 * r; dx = dx + 1) {
   623	                    let f = lo + vec3<i32>(dx, dy, dz);
   624	                    if (!cell_in_range(f)) {
   625	                        continue;
   626	                    }
   627	                    let cm = cell_meta[cell_index(f)];
   628	                    if (cm.y <= 0.0) {
   629	                        continue;
   630	                    }
   631	                    let w = hat_w(f.x, cc.x, r) * hat_w(f.y, cc.y, r) * hat_w(f.z, cc.z, r);
   632	                    sum = sum + w * cm.z; // .z = the residual written by `residual`
   633	                }
   634	            }
   635	        }
   636	        sum = sum / f32(r * r * r);
   637	    }
   638	    cmeta[c] = vec4<f32>(sum, fc, 0.0, cw);
   639	}
   640	
   641	// =================================== residual ==================================================
   642	// r = rhs − A·p into cell_meta.z (the field the coarse stage restricts). Same composition
   643	// loops as jacobi_fine, no update — the restricted field and the smoother share one operator.
   644	@compute @workgroup_size(256)
   645	fn residual(@builtin(global_invocation_id) gid: vec3<u32>) {
   646	    let c = gid.x;
   647	    if (c >= num_fine_cells()) {
   648	        return;
   649	    }
   650	    var cm = cell_meta[c];
   651	    var r = 0.0;
   652	    if (cm.y > 0.0) {
   653	        let h = params.grid_origin.w;
   654	        let cc = vec3<i32>(cell_coords(c));
   655	        var acc = 0.0;
   656	        for (var oz = 0; oz < 2; oz = oz + 1) {
   657	            for (var oy = 0; oy < 2; oy = oy + 1) {
   658	                for (var ox = 0; ox < 2; ox = ox + 1) {
   659	                    let o = vec3<i32>(ox, oy, oz);
   660	                    let node = cc + o;
   661	                    let nidx = node_index(node);
   662	                    let m = Minv(nm[2u * nidx + 0u], nm[2u * nidx + 1u]);
   663	                    var gp = vec3<f32>(0.0);
   664	                    for (var qz = 0; qz < 2; qz = qz + 1) {
   665	                        for (var qy = 0; qy < 2; qy = qy + 1) {
   666	                            for (var qx = 0; qx < 2; qx = qx + 1) {
   667	                                let c2 = node - vec3<i32>(1) + vec3<i32>(qx, qy, qz);
   668	                                if (!cell_in_range(c2)) {
   669	                                    continue;
   670	                                }
   671	                                let ci2 = cell_index(c2);
   672	                                let f2 = cell_meta[ci2].y;
   673	                                if (f2 <= 0.0) {
   674	                                    continue;
   675	                                }
   676	                                let s2 = corner_sign(vec3<i32>(1) - vec3<i32>(qx, qy, qz));
   677	                                gp = gp - s2 * f2 * pf_src[ci2] / (4.0 * h);
   678	                            }
   679	                        }
   680	                    }
   681	                    let s = corner_sign(o);
   682	                    // φ_f node weight (header: MIXTURE FAMILY) — A = −D·Φ·M̃⁻¹·G.
   683	                    acc = acc + m.b.w * dot(s, minv_apply(m, gp)) / (4.0 * h);
   684	                }
   685	            }
   686	        }
   687	        r = cm.x - (-acc * cm.y);
   688	    }
   689	    cm.z = r;
   690	    cell_meta[c] = cm;
   691	}
   692	
   693	// =================================== Jacobi sweeps =============================================
   694	// One damped Jacobi sweep on the FINE grid. A p is evaluated as the literal composition
   695	// D(M̃⁻¹(G p)): for each corner node, gather (G p) from its 8 adjacent active cells, apply
   696	// M̃⁻¹, and accumulate the divergence sign — never a pre-derived stencil.
   697	@compute @workgroup_size(256)
   698	fn jacobi_fine(@builtin(global_invocation_id) gid: vec3<u32>) {
   699	    let c = gid.x;
   700	    if (c >= num_fine_cells()) {
   701	        return;
   702	    }
   703	    let cm = cell_meta[c];
   704	    // U4 pocket pin: the pocket slot is a Dirichlet copy of the bubble multiplier λ_b — the
   705	    // row is relaxed as ONE aggregate by bubble_fine (surface.wgsl), never per cell, so the
   706	    // fine sweeps cannot relax the constraint away (the named KTD-6 failure).
   707	    if (cm.w == CELL_POCKET) {
   708	        pf_dst[c] = bubble[0];
   709	        return;
   710	    }
   711	    if (cm.y <= 0.0) {
