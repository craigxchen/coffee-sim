   165	// --- SDF cavity geometry (mirrors utils/sdf.rs; interior positive, gradient toward the cavity) --
   166	// Byte-identical to the Rust `Primitive` (64 bytes). Cone radii in `a` are OUTER wall radii.
   167	struct Primitive {
   168	    kind: u32,          // 0 = cone, 1 = cylinder, 2 = poly-cup
   169	    species_mask: u32,
   170	    friction: f32,
   171	    flags: u32,         // bit0 = apex_open
   172	    a: vec4<f32>,       // cone:(apex_y, apex_r, top_y, top_r)  cyl:(floor_y, rim_y, radius, _)  poly:(floor_y, rim_y, apothem, sides)
   173	    b: vec4<f32>,       // cone:(thickness, hole_radius, center_x, center_z)  cyl/poly:(center_x, center_z, _, _)
   174	    c: vec4<f32>,       // reserved
   175	};
   176	@group(0) @binding(8) var<storage, read> solids: array<Primitive>;
   177	
   178	const SDF_EPS: f32 = 1.0e-6;
   179	const SDF_FREE: f32 = 1.0e30;
   180	
   181	struct SolidHit { dist: f32, grad: vec3<f32>, friction: f32 };
   182	struct SegCP { p: vec2<f32>, interior: bool };
   183	
   184	fn sdf_normalize2(v: vec2<f32>) -> vec2<f32> {
   185	    let len = length(v);
   186	    if (len > SDF_EPS) { return v / len; }
   187	    return vec2<f32>(0.0, 0.0);
   188	}
   189	fn sdf_normalize3(v: vec3<f32>) -> vec3<f32> {
   190	    let len = length(v);
   191	    if (len > SDF_EPS) { return v / len; }
   192	    return vec3<f32>(0.0, 0.0, 0.0);
   193	}
   194	fn sdf_closest_on_segment(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> SegCP {
   195	    let ab = b - a;
   196	    let len2 = dot(ab, ab);
   197	    if (len2 < SDF_EPS) { return SegCP(a, false); }
   198	    let t = dot(p - a, ab) / len2;
   199	    let tc = clamp(t, 0.0, 1.0);
   200	    return SegCP(a + ab * tc, t > SDF_EPS && t < 1.0 - SDF_EPS);
   201	}
   202	
   203	fn cone_cavity(prim: Primitive, p: vec3<f32>) -> SolidHit {
   204	    let apex_y = prim.a.x;
   205	    let apex_r = prim.a.y;
   206	    let top_y = prim.a.z;
   207	    let top_r = prim.a.w;
   208	    let thickness = prim.b.x;
   209	    let hole_radius = prim.b.y;
   210	    let center = vec2<f32>(prim.b.z, prim.b.w);
   211	    let apex_open = (prim.flags & 1u) != 0u;
   212	
   213	    let rel = vec2<f32>(p.x - center.x, p.z - center.y);
   214	    let r = length(rel);
   215	    let y = p.y;
   216	    var rhat = vec2<f32>(0.0, 0.0);
   217	    if (r >= SDF_EPS) { rhat = rel / r; } // axis guard before building the 3D gradient
   218	
   219	    if (y > top_y) { return SolidHit(SDF_FREE, vec3<f32>(0.0, 1.0, 0.0), prim.friction); }
   220	    if (apex_open && y < apex_y) { return SolidHit(SDF_FREE, vec3<f32>(0.0, -1.0, 0.0), prim.friction); }
   221	
   222	    let inner_apex = max(apex_r - thickness, hole_radius);
   223	    let inner_top = max(top_r - thickness, hole_radius);
   224	    let a2 = vec2<f32>(inner_apex, apex_y);
   225	    let b2 = vec2<f32>(inner_top, top_y);
   226	    let cp = sdf_closest_on_segment(vec2<f32>(r, y), a2, b2);
   227	    let d2d = length(vec2<f32>(r, y) - cp.p);
   228	
   229	    let height = top_y - apex_y;
   230	    var t = 0.0;
   231	    if (height > SDF_EPS) { t = (y - apex_y) / height; }
   232	    let inner = max(mix(apex_r, top_r, t) - thickness, hole_radius);
   233	    let inside = (y >= apex_y) && (r <= inner);
   234	    var dist = -d2d;
   235	    if (inside) { dist = d2d; }
   236	
   237	    let dir = vec2<f32>(r, y) - cp.p;
   238	    var n2d = vec2<f32>(0.0, 0.0);
   239	    if (length(dir) > SDF_EPS) {
   240	        if (inside) { n2d = sdf_normalize2(dir); } else { n2d = sdf_normalize2(-dir); }
   241	    } else if (cp.interior) {
   242	        let ab = b2 - a2;
   243	        n2d = sdf_normalize2(vec2<f32>(-ab.y, ab.x)); // smooth-wall analytic normal (never zero here)
   244	    }
   245	    let grad = sdf_normalize3(vec3<f32>(n2d.x * rhat.x, n2d.y, n2d.x * rhat.y));
   246	    return SolidHit(dist, grad, prim.friction);
   247	}
   248	
   249	fn cyl_cavity(prim: Primitive, p: vec3<f32>) -> SolidHit {
   250	    let floor_y = prim.a.x;
   251	    let rim_y = prim.a.y;
   252	    let radius = prim.a.z;
   253	    let center = vec2<f32>(prim.b.x, prim.b.y);
   254	    let rel = vec2<f32>(p.x - center.x, p.z - center.y);
   255	    let r = length(rel);
   256	    let y = p.y;
   257	    if (y > rim_y) { return SolidHit(SDF_FREE, vec3<f32>(0.0, 1.0, 0.0), prim.friction); }
   258	    let d_side = radius - r;
   259	    let d_floor = y - floor_y;
   260	    if (d_side <= d_floor) {
   261	        var rhat = vec2<f32>(0.0, 0.0);
   262	        if (r >= SDF_EPS) { rhat = rel / r; }
   263	        return SolidHit(d_side, sdf_normalize3(vec3<f32>(-rhat.x, 0.0, -rhat.y)), prim.friction);
   264	    }
   265	    return SolidHit(d_floor, vec3<f32>(0.0, 1.0, 0.0), prim.friction);
   266	}
   267	
   268	// DIAGNOSTIC: regular N-gon prism cup (mirror of sdf.rs::poly_cavity). Face normals at 2πk/N
   269	// (k=0 → +x), so sides=4 is an axis-aligned square. Inner side dist = apothem − max_k(rel·n_k).
   270	fn poly_cavity(prim: Primitive, p: vec3<f32>) -> SolidHit {
   271	    let floor_y = prim.a.x;
   272	    let rim_y = prim.a.y;
   273	    let apothem = prim.a.z;
   274	    let sides = max(u32(prim.a.w), 3u);
   275	    let center = vec2<f32>(prim.b.x, prim.b.y);
   276	    let rel = vec2<f32>(p.x - center.x, p.z - center.y);
   277	    let y = p.y;
   278	    if (y > rim_y) { return SolidHit(SDF_FREE, vec3<f32>(0.0, 1.0, 0.0), prim.friction); }
   279	    var maxproj = -1.0e30;
   280	    var bestn = vec2<f32>(1.0, 0.0);
   281	    let tau = 6.28318530718;
   282	    for (var k = 0u; k < sides; k = k + 1u) {
   283	        let ang = tau * f32(k) / f32(sides);
   284	        let nk = vec2<f32>(cos(ang), sin(ang));
   285	        let proj = dot(rel, nk);
   286	        if (proj > maxproj) { maxproj = proj; bestn = nk; }
   287	    }
   288	    let d_side = apothem - maxproj;
   289	    let d_floor = y - floor_y;
   290	    if (d_side <= d_floor) {
   291	        return SolidHit(d_side, sdf_normalize3(vec3<f32>(-bestn.x, 0.0, -bestn.y)), prim.friction);
   292	    }
   293	    return SolidHit(d_floor, vec3<f32>(0.0, 1.0, 0.0), prim.friction);
   294	}
   295	
   296	fn solid_cavity(prim: Primitive, p: vec3<f32>) -> SolidHit {
   297	    if (prim.kind == 0u) { return cone_cavity(prim, p); }
   298	    if (prim.kind == 2u) { return poly_cavity(prim, p); }
   299	    return cyl_cavity(prim, p);
   300	}
   301	
   302	// Species-filtered union: the most-penetrated (min signed-distance) solid that blocks `ph`.
   303	fn solid_union(p: vec3<f32>, ph: u32) -> SolidHit {
   304	    var best = SolidHit(SDF_FREE, vec3<f32>(0.0, 0.0, 0.0), 0.0);
   305	    let n = params.num_solids;
   306	    for (var i = 0u; i < n; i = i + 1u) {
   307	        let prim = solids[i];
   308	        if ((prim.species_mask & (1u << ph)) == 0u) { continue; }
   309	        let hit = solid_cavity(prim, p);
   310	        if (hit.dist < best.dist) { best = hit; }
   311	    }
   312	    return best;
   313	}
   314	
   315	// MULTI-NORMAL wall BC (plan 2026-06-17-002): all cavity FACES within `band` of p, generalizing
   316	// solid_union's single most-penetrated pick. At a concave seam (cup floor∩wall) two faces are
   317	// in-band and BOTH must be constrained — solid_union would return only one, leaving the other
   318	// direction free (the corner over-pack). `band` is passed in (= WALL_BAND·h; WALL_BAND lives in
   319	// pressure.wgsl, concatenated after this file). Floor face is pushed FIRST per primitive so the
   320	// rank-aware basis build (build_constraint_basis) never drops it. cone stays single-normal (it is
   321	// one smooth converging surface, not discrete faces). Cap WF_MAX candidates.
   322	const WF_MAX: u32 = 4u;
   323	struct WallFaces { n: array<vec3<f32>, 4>, count: u32 };
   324	
   325	fn wf_push(wf: ptr<function, WallFaces>, nrm: vec3<f32>) {
   326	    let c = (*wf).count;
   327	    if (c < WF_MAX && length(nrm) > SDF_EPS) {
   328	        (*wf).n[c] = sdf_normalize3(nrm);
   329	        (*wf).count = c + 1u;
   330	    }
   331	}
   332	
   333	// Orthonormal constraint basis Q (≤3 columns) for the MULTI-NORMAL wall BC: the active box-face
   334	// axes plus the in-band SDF wall normals, orthonormalized by modified Gram-Schmidt. The projector
   335	// is P = I − Q·Qᵀ — a TRUE orthogonal projector (PSD for ANY normals, even a non-orthogonal poly
   336	// vertical edge, where a raw Σ n̂n̂ᵀ would be non-PSD and break A = D·M̃⁻¹·G). `node_setup` builds
   337	// M̃⁻¹ = invr·P and `drag_fold` applies v ← P·v from the SAME basis (lockstep). box_mask bits:
   338	// 1 = x axis constrained, 2 = y, 4 = z (the axes node_setup/drag_fold zero on box faces). Rank-aware:
   339	// box axes first, then wall faces residualized + dropped if near-dependent, stop at rank 3 — so a
   340	// floor normal is never crowded out (the floor face is pushed first by wall_binding_faces).
   341	const CB_RESIDUAL_MIN: f32 = 1.0e-3;
   342	struct CBasis { q: array<vec3<f32>, 3>, count: u32 };
   343	
   344	fn cb_push_ortho(cb: ptr<function, CBasis>, v: vec3<f32>) {
   345	    if ((*cb).count >= 3u) { return; }
   346	    var r = v;
   347	    for (var j = 0u; j < (*cb).count; j = j + 1u) {
   348	        r = r - (*cb).q[j] * dot((*cb).q[j], r);
   349	    }
   350	    let len = length(r);
   351	    if (len > CB_RESIDUAL_MIN) {
   352	        (*cb).q[(*cb).count] = r / len;
   353	        (*cb).count = (*cb).count + 1u;
   354	    }
   355	}
   356	
   357	fn build_constraint_basis(box_mask: u32, faces: WallFaces) -> CBasis {
   358	    var cb: CBasis;
   359	    cb.count = 0u;
   360	    if ((box_mask & 1u) != 0u) { cb_push_ortho(&cb, vec3<f32>(1.0, 0.0, 0.0)); }
   361	    if ((box_mask & 2u) != 0u) { cb_push_ortho(&cb, vec3<f32>(0.0, 1.0, 0.0)); }
   362	    if ((box_mask & 4u) != 0u) { cb_push_ortho(&cb, vec3<f32>(0.0, 0.0, 1.0)); }
   363	    for (var i = 0u; i < faces.count; i = i + 1u) {
   364	        cb_push_ortho(&cb, faces.n[i]);
   365	    }
   366	    return cb;
   367	}
   368	
   369	// Apply P = I − Q·Qᵀ to a vector (Q orthonormal ⇒ subtract each column's projection of the
   370	// ORIGINAL v). Used by drag_fold for the velocity BC; node_setup builds the matrix form inline.
   371	fn cbasis_project_vec(cb: CBasis, v: vec3<f32>) -> vec3<f32> {
   372	    var out = v;
   373	    for (var i = 0u; i < cb.count; i = i + 1u) {
   374	        out = out - cb.q[i] * dot(cb.q[i], v);
   375	    }
   376	    return out;
   377	}
   378	
   379	fn wall_binding_faces(p: vec3<f32>, ph: u32, band: f32) -> WallFaces {
   380	    var wf: WallFaces;
   381	    wf.count = 0u;
   382	    let ns = params.num_solids;
   383	    for (var i = 0u; i < ns; i = i + 1u) {
   384	        let prim = solids[i];
   385	        if ((prim.species_mask & (1u << ph)) == 0u) { continue; }
   386	        if (prim.kind == 0u) {
   387	            // cone: single smooth surface — one nearest normal, in-band only.
   388	            let hit = cone_cavity(prim, p);
   389	            if (hit.dist < band) { wf_push(&wf, hit.grad); }
   390	        } else if (prim.kind == 2u) {
   391	            // poly cup: floor + every in-band side face (vertical edges yield 2 sides).
   392	            let floor_y = prim.a.x; let rim_y = prim.a.y; let apothem = prim.a.z;
   393	            let sides = max(u32(prim.a.w), 3u);
   394	            let center = vec2<f32>(prim.b.x, prim.b.y);
   395	            let rel = vec2<f32>(p.x - center.x, p.z - center.y);
   396	            if (p.y <= rim_y) {
   397	                if ((p.y - floor_y) < band) { wf_push(&wf, vec3<f32>(0.0, 1.0, 0.0)); }
   398	                let tau = 6.28318530718;
   399	                for (var k = 0u; k < sides; k = k + 1u) {
   400	                    let ang = tau * f32(k) / f32(sides);
   401	                    let nk = vec2<f32>(cos(ang), sin(ang));
   402	                    if ((apothem - dot(rel, nk)) < band) {
   403	                        wf_push(&wf, vec3<f32>(-nk.x, 0.0, -nk.y));
   404	                    }
   405	                }
   406	            }
   407	        } else {
   408	            // cylinder cup: floor + radial side face when in-band.
   409	            let floor_y = prim.a.x; let rim_y = prim.a.y; let radius = prim.a.z;
   410	            let center = vec2<f32>(prim.b.x, prim.b.y);
   411	            let rel = vec2<f32>(p.x - center.x, p.z - center.y);
   412	            let r = length(rel);
   413	            if (p.y <= rim_y) {
   414	                if ((p.y - floor_y) < band) { wf_push(&wf, vec3<f32>(0.0, 1.0, 0.0)); }
   415	                if ((radius - r) < band && r >= SDF_EPS) {
   416	                    let rh = rel / r;
   417	                    wf_push(&wf, vec3<f32>(-rh.x, 0.0, -rh.y));
   418	                }
   419	            }
   420	        }
   421	    }
   422	    return wf;
   423	}

