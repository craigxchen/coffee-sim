   572	/// Orthonormal disc basis perpendicular to a (unit) pour direction `dir` (mirrors xpbd).
   573	fn disc_basis(dir: [f32; 3]) -> ([f32; 3], [f32; 3]) {
   574	    let cross = |a: [f32; 3], b: [f32; 3]| {
   575	        [
   576	            a[1] * b[2] - a[2] * b[1],
   577	            a[2] * b[0] - a[0] * b[2],
   578	            a[0] * b[1] - a[1] * b[0],
   579	        ]
   580	    };
   581	    let norm = |v: [f32; 3]| {
   582	        let l = (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt().max(1.0e-9);
   583	        [v[0] / l, v[1] / l, v[2] / l]
   584	    };
   585	    let refv = if dir[1].abs() < 0.9 {
   586	        [0.0, 1.0, 0.0]
   587	    } else {
   588	        [1.0, 0.0, 0.0]
   589	    };
   590	    let u = norm(cross(dir, refv));
   591	    let w = cross(dir, u);
   592	    (u, w)
   593	}
