   552	/// Pour-emission state + spout parameters (host-side; mirrors the xpbd `Inflow`). Turns
   553	/// `EmissionInput` into activated water-pool particles via the volume-consistent
   554	/// arclength-credit emitter: the volume accumulator (flow/V_w·dt) is the master count budget;
   555	/// layers release one `particle_spacing` of stream travel apart, each filling a golden-angle
   556	/// disc, so the inlet packs to the fluid's rest density.
   557	struct Inflow {
   558	    // Static (from Config/Materials at build).
   559	    nozzle_radius: f32,
   560	    discharge_coeff: f32,
   561	    spacing: f32,
   562	    v_w: f32,
   563	    pour_t: f32,
   564	    // State.
   565	    accumulator: f32, // volume budget in particles (carries the sub-particle fraction)
   566	    axial: f32,       // arclength credit (scene units) toward the next layer
   567	    last_exit_speed: f32, // drains backlog at the last cadence when flow drops to 0
   568	    cursor: u64,      // golden-angle determinism across all emitted particles
   569	    emitted_mass: f32, // running total emitted water mass (conservation accounting)
   570	}
