   117	// --- fixed-point encoding (KEEP.md §3 pattern, headroom re-validated for U2) -----------------
   118	//
   119	// FP_SCALE = 2^18. i32 range is ±2^31, so an encoded node lane overflows at |value| ≥ 2^13 = 8192.
   120	//   mass lane:      Σ_p m·w per node. Unit-mass water at rest loads an interior node with
   121	//                   Σ m·w ≈ (particles per cell volume) = (h/spacing)³ = 8 → overflow needs
   122	//                   ≈ 1000× rest packing on one node. Unreachable.
   123	//   momentum lanes: every scattered contribution is magnitude-clamped to max_speed (50 by
   124	//                   default — Config::max_speed, the same cap G2P enforces), so |Σ m·w·v_aff| ≤
   125	//                   (Σ m·w)·max_speed → overflow needs Σ m·w ≥ 8192/50 ≈ 164 mass units on one
   126	//                   node ≈ 20× rest compression with EVERY particle at the cap. The overflow
   127	//                   probe gate (tests/twofield_water.rs) exercises a capped, pancaked worst case.
   128	// COUPLED to the velocity cap: raising max_speed shrinks the momentum headroom linearly —
   129	// change one, re-derive the other. fp_encode also saturates (clamp before convert) as a
   130	// backstop so a pathological state degrades bounded instead of wrapping.
   131	const FP_SCALE: f32 = 262144.0; // 2^18
   132	// Largest f32 ≤ i32::MAX (2^31 − 1 = 2147483647 is not representable; nearest-below is 2147483520).
   133	const FP_CLAMP: f32 = 2147483520.0;
   134	
   135	fn fp_encode(x: f32) -> i32 {
   136	    return i32(clamp(round(x * FP_SCALE), -FP_CLAMP, FP_CLAMP));
   137	}
   138	fn fp_decode(c: i32) -> f32 {
   139	    return f32(c) / FP_SCALE;
   140	}
   141	
   142	// --- quadratic B-spline weights (KEEP.md §3 validated math) -----------------------------------
   143	// Per axis, around base = floor(x/h − 0.5) with fx = x/h − base ∈ [0.5, 1.5]; node offset
   144	// k ∈ {0,1,2} gets w[k]. Weights sum to 1 and Σ_k w[k]·(base+k) = x/h (linear consistency —
   145	// what makes the free-fall recurrence exact and keeps APIC's C zero in a uniform field).
   146	fn bspline_w(fx: vec3<f32>) -> array<vec3<f32>, 3> {
   147	    var w: array<vec3<f32>, 3>;
   148	    w[0] = 0.5 * (1.5 - fx) * (1.5 - fx);
   149	    w[1] = 0.75 - (fx - 1.0) * (fx - 1.0);
   150	    w[2] = 0.5 * (fx - 0.5) * (fx - 0.5);
   151	    return w;
   152	}
   153	
   154	// --- grid indexing -----------------------------------------------------------------------------
   155	// Flat node index, x-fastest. Node world position = grid_origin + (i,j,k)·h.
   156	fn node_index(n: vec3<i32>) -> u32 {
   157	    return u32(n.x) + params.grid_dims.x * (u32(n.y) + params.grid_dims.y * u32(n.z));
   158	}
   159	fn node_coords(flat: u32) -> vec3<u32> {
   160	    let nx = params.grid_dims.x;
   161	    let ny = params.grid_dims.y;
   162	    return vec3<u32>(flat % nx, (flat / nx) % ny, flat / (nx * ny));
   163	}
