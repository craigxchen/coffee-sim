    85	    let packed = scale / max(kozeny_carman(d, phi_f), 1.0e-9);
    86	    let dilute = scale * WEN_YU_COEFF * phi_s / max(d * d, 1.0e-8);
    87	    let psi = atan(HUILIN_SLOPE * (phi_s - PHI_S_BLEND)) / PI_F32 + 0.5;
    88	    return psi * packed + (1.0 - psi) * dilute;
    89	}
    90	
    91	// Decoded solid volume at a node (the φ_s carrier).
    92	fn solid_volume_at(n: u32) -> f32 {
    93	    return fp_decode(atomicLoad(&grid_sfp[n]));
    94	}
    95	
    96	// Wall-truncated control volume of a node: how many of its 8 adjacent cell slots are inside
    97	// the box and outside the SDF solids (the node_setup truncation rule, shared so φ_s and the
    98	// density floor normalize identically).
    99	fn node_vis(xp: vec3<f32>) -> f32 {
   100	    var vis = 0.0;
   101	    let h = params.grid_origin.w;
   102	    for (var oz = 0; oz < 2; oz = oz + 1) {
   103	        for (var oy = 0; oy < 2; oy = oy + 1) {
   104	            for (var ox = 0; ox < 2; ox = ox + 1) {
   105	                let cs = corner_sign(vec3<i32>(ox, oy, oz));
   106	                let cc = xp + cs * (0.5 * h);
   107	                var ok = all(cc >= params.box_min.xyz) && all(cc <= params.box_max.xyz);
   108	                if (ok && params.num_solids > 0u) {
   109	                    ok = solid_union(cc, PHASE_WATER).dist >= 0.0;
   110	                }
   111	                if (ok) {
   112	                    vis = vis + 1.0;
   113	                }
   114	            }
   115	        }
   116	    }
   117	    return vis;
   118	}
   119	
   120	// φ_f at a node: the B-spline-scattered solid volume over the VISIBLE control volume
   121	// (vis/8·h³). Without the truncation normalization, wall/floor nodes in a wall-flush bed
   122	// read φ_s ≈ half the interior value, the drag there drops ~4× (Kozeny-Carman is quadratic
   123	// in φ_s), and the column drains through an artificial low-drag wall annulus — measured 2–5×
   124	// the Darcy prediction before this fix. Zero-solid nodes skip everything (exact-zero
   125	// passthrough: φ_f = 1.0 bitwise, no vis loop cost in water-only scenes).
   126	fn node_phi_f(n: u32, xp: vec3<f32>) -> f32 {
   127	    let sv = solid_volume_at(n);
   128	    if (sv <= 0.0) {
   129	        return 1.0;
   130	    }
   131	    let h = params.grid_origin.w;
   132	    let vis = max(node_vis(xp), 1.0);
   133	    return 1.0 - min(sv / (h * h * h * vis / 8.0), PHI_S_MAX);
   134	}
   135	
   136	// =================================== p2g_solid =================================================
   137	// Thin solid-mass P2G: scatter each (frozen) grain's sphere volume with the same quadratic
   138	// B-spline weights as the water field, into the single-lane fixed-point solid field. No
   139	// momentum lanes — the skeleton is kinematically frozen in U6 (v_s ≡ 0); the full solid
   140	// field with stress arrives in U5/U7. Budget: one extra binding pair (grid_sfp) instead of
   141	// four more atomic lanes in grid_fp — documented against the KTD-7 vec4-packing rule because
   142	// mass-only needs one lane, not four.
   143	@compute @workgroup_size(256)
   144	fn p2g_solid(@builtin(global_invocation_id) gid: vec3<u32>) {
   145	    let i = gid.x;
   146	    if (i >= params.solid_count) {
   147	        return;
   148	    }
   149	    // Solid range sits AFTER the (pool-padded) water range — KTD-1 layout.
   150	    let p = params.particle_count - params.solid_count + i;
   151	    let h = params.grid_origin.w;
   152	    let x = pos[p].xyz;
   153	    let xl = (x - params.grid_origin.xyz) / h;
   154	    var base = vec3<i32>(floor(xl - vec3<f32>(0.5)));
   155	    base = clamp(base, vec3<i32>(0), vec3<i32>(params.grid_dims.xyz) - vec3<i32>(3));
   156	    let fx = xl - vec3<f32>(base);
   157	    var w = bspline_w(fx);
   158	    // U9 swelling (KTD-8): the EFFECTIVE grain volume is the dry sphere volume π/6·d³ plus the
   159	    // absorbed water volume V_abs (pos.w on grains — models::wetting effective_volume), so a
   160	    // saturating grain raises the local φ_s and lowers K(φ) as it swells. With absorption off
   161	    // V_abs ≡ 0 and this is bit-identical to the U6 constant params.coupling.z.
   162	    let vg = params.coupling.z + max(pos[p].w, 0.0);
   163	    for (var k = 0; k < 3; k = k + 1) {
   164	        for (var j = 0; j < 3; j = j + 1) {
   165	            for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
   166	                let wijk = w[i2].x * w[j].y * w[k].z;
   167	                let node = base + vec3<i32>(i2, j, k);
   168	                atomicAdd(&grid_sfp[node_index(node)], fp_encode(vg * wijk));
   169	            }
   170	        }
   171	    }
   172	}
   173	
   174	// =================================== drag_fold =================================================
   175	// Grid forces + the exponential drag fold + the grid-node boundary conditions (header).
   176	@compute @workgroup_size(256)
   177	fn drag_fold(@builtin(global_invocation_id) gid: vec3<u32>) {
   178	    let n = gid.x;
   179	    if (n >= params.grid_dims.w) {
   180	        return;
   181	    }
   182	    let gv = grid_vel[n];
   183	    let mass = gv.w;
   184	    if (mass <= params.extra.z) {
   185	        // Empty node (v already 0 from grid_update's mass gate): plain-Δt family, no impulse.
   186	        react[n] = vec4<f32>(0.0, 0.0, 0.0, 1.0);
   187	        return;
   188	    }
   189	    var v = gv.xyz;
   190	    var g = params.gravity.xyz;
   191	    let c = node_coords(n);
   192	    let xp = params.grid_origin.xyz + vec3<f32>(f32(c.x), f32(c.y), f32(c.z)) * params.grid_origin.w;
   193	    let sv = solid_volume_at(n);
   194	    // U9 wetting-front capillary suction (KTD-4b, Green-Ampt body force): on water nodes INSIDE
   195	    // the bed (sv > 0) that sit at the unsaturated front — water present here but the node one
   196	    // cell BELOW carries less water mass (the dry advancing front) — add a downward acceleration
   197	    // a_suction (mapped from ψ_f; see tests/twofield_infiltration.rs UNIT MAPPING). Folded into
   198	    // the gravity source g so the exponential drag integrator carries it exactly (same as
   199	    // gravity). a_suction = 0 (Config default) is exact passthrough (no front detection cost).
   200	    let a_suction = params.wet1.x;
   201	    if (a_suction > 0.0 && sv > 0.0 && mass > params.extra.z) {
   202	        let h = params.grid_origin.w;
   203	        let below = vec3<i32>(c) - vec3<i32>(0, 1, 0);
   204	        var drier_below = true; // domain edge counts as "open below" (front at the base)
   205	        if (below.y >= 0) {
   206	            let mb = grid_vel[node_index(below)].w;
   207	            drier_below = mb < mass * 0.5; // the cell below carries < half this node's water
   208	        }
   209	        if (drier_below) {
   210	            g = g - vec3<f32>(0.0, a_suction, 0.0); // pull water down into the dry front
   211	        }
   212	    }
   213	    var sig = 1.0;
   214	    var imp = vec3<f32>(0.0);
   215	    if (sv > 0.0) {
   216	        let phi_f = node_phi_f(n, xp); // truncation-normalized (see node_phi_f)
   217	        let phi_s = 1.0 - phi_f;
   218	        let beta = drag_rate_blended(phi_s, phi_f);
   219	        let a = beta * params.dt;
   220	        let e = exp(-a);
   221	        var srcf: f32;
   222	        if (a < 1.0e-3) {
   223	            srcf = params.dt * (1.0 - 0.5 * a); // series guard: (1−e)/β without cancellation
   224	        } else {
   225	            srcf = (1.0 - e) / beta;
   226	        }
   227	        let naive = v + g * params.dt; // the no-drag path (what the ledger is measured against)
   228	        v = v * e + g * srcf;          // forced exponential integrator, v_s = 0
   229	        sig = srcf / params.dt;
   230	        imp = mass * (naive - v);      // pair-update impulse absorbed by the frozen skeleton
   231	    } else {
   232	        v = v + g * params.dt; // exact-zero passthrough: byte-identical pre-U6 gravity path
   233	    }
   234	
   235	    // --- grid-node BC (moved verbatim from U2's grid_update; see its original comments) -------
   236	    let eps = 1.0e-4;
   237	    let open_base = params.coupling.w > 0.5;
   238	
   239	    // Nodes strictly OUTSIDE the domain box are inside the walls (zero velocity, M̃⁻¹ = 0 in
   240	    // node_setup). The open base exempts the below-floor pad layer: it carries the outflow's
   241	    // B-spline smear and must keep its velocity or near-floor particles gather a zero-drag
   242	    // brake (the same edge-column artifact the original comment records).
   243	    var out_lo = xp < params.box_min.xyz - vec3<f32>(eps);
   244	    if (open_base) {
   245	        out_lo.y = false;
   246	    }
   247	    if (any(out_lo) || any(xp > params.box_max.xyz + vec3<f32>(eps))) {
   248	        grid_vel[n] = vec4<f32>(vec3<f32>(0.0), mass);
   249	        react[n] = vec4<f32>(imp, sig);
   250	        return;
   251	    }
   252	    // Wall BC. The box-face normal components are removed (free slip tangentially), matching the
   253	    // constrained M̃⁻¹; the SDF wall adds its in-band normal(s). Both modes share the SAME basis
   254	    // node_setup builds (operator consistency A = D·M̃⁻¹·G; a one-sided BC here was tried and
   255	    // reverted). The open base keeps the y-min face open for the water field.
   256	    if (!wall_bc_multi()) {
   257	        // SINGLE-NORMAL (default): box-face axis zeroing + the most-penetrated SDF normal, banded,
   258	        // box-orthogonalized — byte-identical to the original BC.
   259	        if (xp.x <= params.box_min.x + eps || xp.x >= params.box_max.x - eps) { v.x = 0.0; }
   260	        if ((xp.y <= params.box_min.y + eps && !open_base) || xp.y >= params.box_max.y - eps) { v.y = 0.0; }
   261	        if (xp.z <= params.box_min.z + eps || xp.z >= params.box_max.z - eps) { v.z = 0.0; }
   262	        if (params.num_solids > 0u) {
   263	            let hit = solid_union(xp, PHASE_WATER);
   264	            if (hit.dist < WALL_BAND * params.grid_origin.w) {
   265	                var nrm = hit.grad;
   266	                if (xp.x <= params.box_min.x + eps || xp.x >= params.box_max.x - eps) { nrm.x = 0.0; }
   267	                if ((xp.y <= params.box_min.y + eps && !open_base) || xp.y >= params.box_max.y - eps) { nrm.y = 0.0; }
   268	                if (xp.z <= params.box_min.z + eps || xp.z >= params.box_max.z - eps) { nrm.z = 0.0; }
   269	                let len = length(nrm);
   270	                if (len > SDF_NORMAL_MIN) {
   271	                    nrm = nrm / len;
   272	                    v = v - dot(v, nrm) * nrm;
   273	                }
   274	            }
   275	        }
   276	    } else {
   277	        // MULTI-NORMAL: v ← P·v with P = I − Q·Qᵀ over the active box axes + ALL in-band wall faces
   278	        // — the IDENTICAL basis node_setup builds for M̃⁻¹ = invr·P (exact lockstep). box_mask
   279	        // matches the single path's box-face conditions; faces empty when no solids.
   280	        var box_mask = 0u;
   281	        if (xp.x <= params.box_min.x + eps || xp.x >= params.box_max.x - eps) { box_mask = box_mask | 1u; }
   282	        if ((xp.y <= params.box_min.y + eps && !open_base) || xp.y >= params.box_max.y - eps) { box_mask = box_mask | 2u; }
   283	        if (xp.z <= params.box_min.z + eps || xp.z >= params.box_max.z - eps) { box_mask = box_mask | 4u; }
   284	        var faces: WallFaces;
   285	        faces.count = 0u;
   286	        if (params.num_solids > 0u) {
   287	            faces = wall_binding_faces(xp, PHASE_WATER, WALL_BAND * params.grid_origin.w);
   288	        }
   289	        let cb = build_constraint_basis(box_mask, faces);
   290	        v = cbasis_project_vec(cb, v);
   291	    }
   292	    // Speed-cap backstop (couples to the FP headroom math in common.wgsl).
   293	    let s = length(v);
   294	    if (s > params.max_speed) {
   295	        v = v * (params.max_speed / s);
   296	    }
   297	    grid_vel[n] = vec4<f32>(v, mass);
   298	    react[n] = vec4<f32>(imp, sig);
   299	}
