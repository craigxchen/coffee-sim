   696	/// Grid dimensions for a scene: cell size `h = CELL_SIZE_FACTOR · particle_spacing`, node 0 one
   697	/// cell OUTSIDE `box_min` (a pad layer), `ceil(extent/h) + 3` nodes per axis. With the pad, a
   698	/// particle anywhere in the box — including exactly on a face after the G2P clamp — has its
   699	/// full 3-node B-spline support in range: `xl = (x − origin)/h ∈ [1, 1 + extent/h]`, so
   700	/// `base = floor(xl − 0.5) ∈ [0, dims − 3]`. The node layer at exactly `box_min` always exists
   701	/// (origin + h = box_min), which is what the grid box-face BC keys on.
   702	pub fn grid_spec_for(scene: &Scene, mats: &Materials) -> ([f32; 3], f32, [u32; 3]) {
   703	    let h = CELL_SIZE_FACTOR * mats.particle_spacing;
   704	    let origin = [
   705	        scene.box_min[0] - h,
   706	        scene.box_min[1] - h,
   707	        scene.box_min[2] - h,
   708	    ];
   709	    let mut dims = [0u32; 3];
   710	    for (a, d) in dims.iter_mut().enumerate() {
   711	        let extent = (scene.box_max[a] - scene.box_min[a]).max(0.0);
   712	        *d = (extent / h).ceil() as u32 + 3;
   713	    }
   714	    (origin, h, dims)
   715	}
   716	
   717	/// Coarse CELL counts at `ratio` fine cells per coarse cell per axis (fine cells = node dims
   718	/// − 1; partial coarse cells at the high end clamp their children to the fine range).
   719	fn coarse_dims_for(dims: [u32; 3], ratio: u32) -> [u32; 3] {
   720	    [
   721	        (dims[0] - 1).div_ceil(ratio),
   722	        (dims[1] - 1).div_ceil(ratio),
   723	        (dims[2] - 1).div_ceil(ratio),
   724	    ]
   725	}

