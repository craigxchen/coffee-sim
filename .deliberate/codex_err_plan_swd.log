   198	/// Build a DEFORMABLE saturated bed: grains seeded by the scene (pitch d, wall margin d/2),
   199	/// pore water repositioned onto the local pore lattice over the saturated fraction, an optional
   200	/// pond at rest density above the bed, surplus water parked dormant. `solid_dynamics` is ON, so
   201	/// the bed is a live Klar elastoplastic skeleton coupled to the water. Mirrors
   202	/// tests/twofield_coupling.rs::build_column (self-contained — test binaries don't share helpers).
   203	fn build_bed(gpu: &GpuContext, spec: &BedSpec) -> DefBed {
   204	    let mats = Materials {
   205	        grain_diameter: spec.d,
   206	        ..Materials::default()
   207	    };
   208	    let cfg = Config {
   209	        drag_scale: spec.drag_scale,
   210	        ..spec.cfg.clone()
   211	    };
   212	    let bx = spec.box_max;
   213	    let inset = 0.5f32;
   214	    let h_bed = (spec.bed_top - inset) as f64;
   215	    let sat_top = inset as f64 + h_bed * spec.sat_frac as f64;
   216	    let phi_f = (1.0 - PHI_S_LATTICE).clamp(0.05, 1.0);
   217	    let pitch = (1.0 / phi_f).powf(1.0 / 3.0) as f32;
   218	    let mut bed_water: Vec<[f32; 3]> = Vec::new();
   219	    let mut y = inset as f64 + 0.1;
   220	    while y <= sat_top - 0.1 {
   221	        bed_water.extend(lattice(
   222	            [0.7, y as f32, 0.7],
   223	            [bx[0] - 0.7, y as f32 + 0.01, bx[2] - 0.7],
   224	            pitch,
   225	        ));
   226	        y += pitch as f64;
   227	    }
   228	    let pond = if spec.pond_layers > 0 {
   229	        lattice(
   230	            [0.7, spec.bed_top + 0.6, 0.7],
   231	            [
   232	                bx[0] - 0.7,
   233	                spec.bed_top + 0.6 + (spec.pond_layers as f32 - 1.0) + 0.05,
   234	                bx[2] - 0.7,
   235	            ],
   236	            1.0,
   237	        )
   238	    } else {
   239	        Vec::new()
   240	    };
   241	    let needed = bed_water.len() + pond.len();
   242	    let per_layer = ((((bx[0] - 0.9) / 1.0).floor() as usize) + 1).pow(2);
   243	    let layers = needed.div_ceil(per_layer).max(1);
   244	    let scene = Scene {
   245	        gravity: [0.0, -(GRAV as f32), 0.0],
   246	        box_min: [0.0; 3],
   247	        box_max: bx,
   248	        pour_water_ml: spec.pour_ml,
   249	        regions: vec![
   250	            SeedRegion {
   251	                min: [0.5, spec.bed_top + 1.0, 0.5],
   252	                max: [
   253	                    bx[0] - 0.4,
   254	                    spec.bed_top + 1.0 + (layers as f32 - 1.0) + 0.1,
   255	                    bx[2] - 0.4,
   256	                ],
   257	                species: Species::Water,
   258	            },
   259	            SeedRegion {
   260	                min: [0.5 * spec.d, 0.5 * spec.d, 0.5 * spec.d],
   261	                max: [
   262	                    bx[0] - 0.5 * spec.d + 0.01,
   263	                    spec.bed_top,
   264	                    bx[2] - 0.5 * spec.d + 0.01,
   265	                ],
   266	                species: Species::Grain,
   267	            },
   268	        ],
   269	        solids: Vec::new(),
   270	        ..Scene::default()
   271	    };
   272	    let mut solver = TwofieldSolver::build(&scene, &mats, &cfg, gpu);
   273	    let (water_seed, solid_count) = solver.phase_counts();
   274	    assert!(solid_count > 0, "bed scene seeds grains");
   275	    assert!(
   276	        needed as u32 <= water_seed,
   277	        "water seed pool {water_seed} too small for {needed} repositioned particles"
   278	    );
   279	    let mut pos = solver.read_positions();
   280	    for (i, p) in bed_water.iter().chain(pond.iter()).enumerate() {
   281	        pos[i] = [p[0], p[1], p[2], 1.0];
   282	    }
   283	    for slot in pos.iter_mut().take(water_seed as usize).skip(needed) {
   284	        *slot = [0.0, 0.0, 0.0, 0.0];
   285	    }
   286	    solver.write_positions_for_test(&pos);
   287	    let zeros = vec![[0.0f32; 4]; pos.len()];
   288	    solver.write_velocities_for_test(&zeros);
   289	    solver.set_live_water_for_test(needed as u32);
   290	    DefBed {
   291	        solver,
   292	        n_water: needed as u32,
   293	        n_grain: solid_count,
   294	        bed_top: spec.bed_top as f64,
   295	        box_max: bx,
   296	    }
   297	}
