   421	    // flat across bins; a single-particle wall SHELL spikes the OUTERMOST bin's density past the
   422	    // bulk mean. This is the direct ring discriminator (a pinned shell pushes it to 4–10×; a
   423	    // smooth pool with a thin physical contact layer sits near ~2×).
   424	    let nbins = 10usize;
