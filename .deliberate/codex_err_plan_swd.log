    58	const GRAV: f64 = 20.0;
    59	const REST: f64 = 1.0; // particle_mass / spacing³ at the defaults
    60	const PHI_S_LATTICE: f64 = std::f64::consts::PI / 6.0; // unit-pitch grain lattice φ_s ≈ 0.524
