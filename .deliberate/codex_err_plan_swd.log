   218	            absorb_roundoff: 1.0e-3,
   219	            pbf_eps: 0.05,
   220	            // Extraction/thermal OFF by default (step 5; like absorb_rate): a brew scene opts in.
   221	            extract_rate: 0.0,
   222	            // Fines OFF by default (step 6; like extract_rate): a brew scene opts in.
   223	            fines_rate: 0.0,
   224	            // Pour spout: a thin stream by default; a pour scene tunes these to its grind/flow.
