    97	        allow_timestamp_queries: bool,
    98	    ) -> Option<Self> {
    99	        let adapter = instance.request_adapter(&options).await.ok()?;
   100	        let timestamps_supported =
   101	            allow_timestamp_queries && adapter.features().contains(wgpu::Features::TIMESTAMP_QUERY);
   102	        let required_features = if timestamps_supported {
   103	            wgpu::Features::TIMESTAMP_QUERY
