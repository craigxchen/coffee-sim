    63	
    64	// --- CRATER (the L3 physics gate) ---
    65	// Center pour: jet radius and pour momentum fixed BEFORE implementation.
    66	const JET_RADIUS: f64 = 1.5; // = Config::nozzle_radius for the gate scene
    67	const JET_FLOW: f32 = 70.0; // units³/s — a vigorous pour-strength jet (under the cap)
    68	                            // CRATER depth floor: the jet must dig a signed center-vs-rim depression of at least HALF a jet
    69	                            // radius BELOW the swollen-flat surface. Derivation: the cavity gate (tests/twofield_cavity.rs)
    70	                            // committed ≥ 1 jet radius for an OPEN POOL; a saturated DEFORMABLE BED resists more (it is a
    71	                            // frictional skeleton, not free water), so the bed-crater floor is set at half that open-pool
    72	                            // floor — still a clear, multi-cell signed depression, comfortably above the documented
    73	                            // main/xpbd ≈ 0 baselines, and below the open-pool number so it cannot be vacuous. The metric
    74	                            // is measured AGAINST the swelling lift (the swollen baseline), so a positive value is a true
    75	                            // depression below the raised surface, not a swelling artifact.
    76	const CRATER_DEPTH_FLOOR: f64 = 0.5 * JET_RADIUS; // 0.75 su
    77	                                                  // CRATER PERSISTENCE: when the jet stops the wet bed HOLDS the poured crater (wet-sand
    78	                                                  // plasticity — a real pour-over bed retains the pour topography; the Rao Spin exists precisely
    79	                                                  // because an un-agitated bed does NOT self-level). The crater must persist to ≥ this fraction
    80	                                                  // of its peak depth after a long drain — the OPPOSITE of the old collapse target, which rewarded
    81	                                                  // the numerical-agitation slump. Measured on the absolute pit displacement (rim-swell-corrected)
    82	                                                  // AND the rim−center differential; U4 calibrates the final value from the measured held depth.
    83	const PERSIST_RESIDUAL_FRAC: f64 = 0.8; // "holds almost fully"; measured hold 97–100%, slump (blend 0) 14%
    84	
    85	// --- NO FLUIDIZATION ---
    86	// Saturated bed under sustained pour does not fluidize: the skeleton holds — the xpbd-style
    87	// gate. The center dimples (the crater) and the rim mounds (grains pushed outward/up), so bulk
    88	// grain mean-y is NOT the discriminator (it conflates the crater-rim lift with fluidization).
    89	// The true fluidization signature is GRAINS SUSPENDED IN THE WATER COLUMN — carried far above
    90	// the bed. Gate: the fraction of grains lofted above bed_top + a margin stays small (a held
    91	// skeleton keeps its grains within the bed; a fluidized one sprays them up into the pour).
    92	const FLUIDIZE_LOFT_FRAC_MAX: f64 = 0.05; // ≤ 5% of grains lofted > bed_top + 2 su
    93	
    94	// --- TERZAGHI 1D consolidation ---
    95	// U(T) consolidation ratio band against the analytic series, at TWO drainage lengths so the
    96	// T = c_v·t/H² collapse verifies scaling. Coarse-grid u-p MPM with explicit drag is a loose
    97	// match — the band is generous (the standard caveat: the discrete operator + drag fold is not
    98	// the textbook 1D PDE), and the load-sharing + Skempton arms are the sharper checks.
    99	const TERZAGHI_U_BAND: (f64, f64) = (0.3, 1.0); // U at the mid sample, both lengths
   100	                                                // Skempton B (undrained pore-pressure ratio) on the DEFORMABLE skeleton: for near-incompressible
   101	                                                // constituents B ≈ 1; the discrete fold loses a little to the βΔt split, so accept a band.
   102	const SKEMPTON_B_MIN: f64 = 0.7;
   103	// Load-sharing (effective + pore = applied total): the basal pore-pressure response carries the
   104	// bulk of the surcharge in the undrained limit (the deformable-skeleton version of the U6 frozen
   105	// undrained gate) — reuse the U6 band shape.
   106	const LOADSHARE_BAND: (f64, f64) = (0.6, 1.25);
   107	
   108	// --- STRESS-PARTITION AUDIT ---
   109	// Static saturated column: total vertical stress = effective stress + pore pressure within
   110	// tolerance (KTD-5 single-counting). Measured as a relative residual of the partition.
   111	const PARTITION_RESIDUAL_MAX: f64 = 0.20; // 20% of the total vertical stress
   112	
   113	// --- INTEGRATED WET-AND-DRAIN (the owner-ruling gate, the deferred U9 gate) ---
   114	// An actively-wetting DEFORMABLE saturated bed drains end-to-end with NO permanent clog: the
   115	// pond reaches ≤ 10% within a generous band AND φ_f does not collapse toward 0 and stay there
   116	// (the frozen-lattice clog from U9 must NOT recur — the deformable bed relieves it).
   117	const WETDRAIN_FRAMES_MAX: u32 = 2400; // generous band (U9's mapped band was 488–977 frozen)
   118	const WETDRAIN_PHI_F_FLOOR: f64 = 0.10; // φ_f must stay above this (no K→0 clog)
   119	
   120	// --- L2 RE-RUN ON DEFORMABLE BED ---
   121	// The U9 pond/drain band re-run with the bed deformable (swelling + plastic compaction shift K).
   122	// The band may shift; we verify drainage completes and document the frame count.
   123	const L2_DEFORM_FRAMES_MAX: u32 = 2400;
   124	
   125	// --- REDUCED DIVERGENCE RE-CHECK ---
   126	const DIV_TOL: f64 = 0.5; // reduced check on the deformable bed (looser than U3's 0.3)
   127	const INTERIOR_MARGIN: i64 = 2;
   128	
   129	// --- COMBINED CONSERVATION ---
   130	const VOL_DRIFT_TOL: f64 = 0.02; // 2% over the full V60 pour run (pour + drain + swelling)
