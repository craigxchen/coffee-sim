   179	            s_corr_dq_ratio: 0.2,
   180	            spiky_r_min_ratio: 0.01,
   181	            // Compression-only correction (λ ≤ 0): resist over-density but apply NO cohesive
   182	            // pull on under-dense surface particles — that pull is PBF's implicit surface
