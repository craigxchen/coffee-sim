    61	flowchart TD
    62	    A["g2p_water: gather v_grid = Σ w·grid_v (local average)<br/>+ velocity gradient B (→ ∇·v = trace C)<br/>+ m_local density (secondary)"] --> B{"c = smooth_strength<br/>(primary: ∇·v sign; secondary: density)"}
    63	    B -->|"compressive ∇·v<0 (merging into pool)<br/>OR bulk-dense: c→1"| C["v = v_grid<br/>(dissipate → calm pool,<br/>NO drip-stir; ≡ current in bulk)"]
