   124	                trace: wgpu::Trace::default(),
   125	                experimental_features: wgpu::ExperimentalFeatures::disabled(),
   126	            })
   127	            .await
   128	            .ok()?;
   129	
   130	        Some(Self {
   131	            instance,
   132	            adapter,
   133	            device,
   134	            queue,
   135	            timestamps_supported,
   136	        })
   137	    }
