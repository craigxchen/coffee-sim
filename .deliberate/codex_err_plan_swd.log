   427	        let r = ((p[0] as f64).powi(2) + (p[2] as f64).powi(2)).sqrt();
   428	        let b = ((r / CUP_RADIUS) * nbins as f64).floor() as usize;
   429	        counts[b.min(nbins - 1)] += 1;
