   560	/// CPU reference of one transfer step (gravity off, no boundaries, C₀ = 0): P2G mass/momentum
   561	/// in f64 (no fixed-point quantization), node velocity = momentum/mass, G2P gather + advect.
   562	/// Valid for interior particles only (no clamps modeled).
   563	fn cpu_transfer_step(
   564	    pos: &[[f32; 4]],
   565	    vel: &[[f32; 4]],
   566	    origin: [f32; 3],
   567	    h: f32,
   568	    dims: [u32; 3],
   569	    m: f64,
   570	    dt: f64,
   571	) -> (Vec<[f64; 3]>, Vec<[f64; 3]>) {
   572	    let (nx, ny, nz) = (dims[0] as usize, dims[1] as usize, dims[2] as usize);
   573	    let idx = |i: usize, j: usize, k: usize| i + nx * (j + ny * k);
   574	    let mut mass = vec![0.0f64; nx * ny * nz];
   575	    let mut mom = vec![[0.0f64; 3]; nx * ny * nz];
   576	
   577	    let weights_of = |p: &[f32; 4]| {
   578	        let mut base = [0usize; 3];
   579	        let mut w = [[0.0f64; 3]; 3];
   580	        for a in 0..3 {
   581	            let xl = (p[a] - origin[a]) as f64 / h as f64;
   582	            let b = (xl - 0.5).floor();
   583	            base[a] = b as usize;
   584	            w[a] = bspline_w(xl - b);
   585	        }
   586	        (base, w)
   587	    };
   588	
   589	    for (p, v) in pos.iter().zip(vel) {
   590	        let (base, w) = weights_of(p);
   591	        for k in 0..3 {
   592	            for j in 0..3 {
   593	                for i in 0..3 {
   594	                    let wijk = w[0][i] * w[1][j] * w[2][k];
   595	                    let n = idx(base[0] + i, base[1] + j, base[2] + k);
   596	                    mass[n] += m * wijk;
   597	                    for a in 0..3 {
   598	                        mom[n][a] += m * wijk * v[a] as f64;
   599	                    }
   600	                }
   601	            }
   602	        }
   603	    }
   604	
   605	    let mut out_pos = Vec::with_capacity(pos.len());
   606	    let mut out_vel = Vec::with_capacity(pos.len());
   607	    for p in pos {
   608	        let (base, w) = weights_of(p);
   609	        let mut vp = [0.0f64; 3];
   610	        for k in 0..3 {
   611	            for j in 0..3 {
   612	                for i in 0..3 {
   613	                    let wijk = w[0][i] * w[1][j] * w[2][k];
   614	                    let n = idx(base[0] + i, base[1] + j, base[2] + k);
   615	                    if mass[n] > 0.0 {
   616	                        for a in 0..3 {
   617	                            vp[a] += wijk * mom[n][a] / mass[n];
   618	                        }
   619	                    }
   620	                }
   621	            }
   622	        }
   623	        out_pos.push([
   624	            p[0] as f64 + vp[0] * dt,
   625	            p[1] as f64 + vp[1] * dt,
   626	            p[2] as f64 + vp[2] * dt,
   627	        ]);
   628	        out_vel.push(vp);
   629	    }
   630	    (out_pos, out_vel)
   631	}
   632	
   633	fn mass_center(pos: &[[f32; 4]]) -> [f32; 3] {
   634	    let n = pos.len() as f32;
   635	    let mut c = [0.0f32; 3];
   636	    for p in pos {
   637	        for a in 0..3 {
   638	            c[a] += p[a];
   639	        }
   640	    }
   641	    [c[0] / n, c[1] / n, c[2] / n]
   642	}
   643	
   644	/// Total angular momentum about +y through the current mass center (unit particle mass).
   645	fn angular_momentum_y(pos: &[[f32; 4]], vel: &[[f32; 4]]) -> f64 {
   646	    let c = mass_center(pos);
   647	    pos.iter()
   648	        .zip(vel)
   649	        .map(|(p, v)| ((p[2] - c[2]) * v[0] - (p[0] - c[0]) * v[2]) as f64)
   650	        .sum()
   651	}

