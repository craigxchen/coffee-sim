   247	async fn wait_animation_frames(frames: u32) -> Result<(), JsValue> {
   248	    for _ in 0..frames {
   249	        let promise = js_sys::Promise::new(&mut |resolve, reject| {
   250	            let Some(window) = web_sys::window() else {
   251	                let _ = resolve.call0(&JsValue::NULL);
   252	                return;
   253	            };
   254	            let callback = Closure::once_into_js(move |_timestamp: f64| {
   255	                let _ = resolve.call0(&JsValue::NULL);
   256	            });
   257	            if let Err(err) = window.request_animation_frame(callback.unchecked_ref()) {
   258	                let _ = reject.call1(&JsValue::NULL, &err);
   259	            }
   260	        });

