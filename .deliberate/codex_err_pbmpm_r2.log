    40	/// Device limits required by the MPM compute pipeline.
    41	///
    42	/// The MPM bind group holds 9 storage buffers (particles, affine, grid,
    43	/// grid_vel, render_data, bed_extract, bed_lookup, bed_delta, metrics) plus
    44	/// one SDF texture. This stays within the 10-buffer cap that some WebGPU
    45	/// adapters enforce. Any
    46	/// `request_device` site that uses this pipeline must use these limits, and
    47	/// `mpm_pipelines_fit_within_required_limits` pins the invariant.
    48	pub(crate) fn required_limits() -> wgpu::Limits {
    49	    wgpu::Limits {
    50	        max_storage_buffers_per_shader_stage: 10,
    51	        ..wgpu::Limits::default()
    52	    }
    53	}
