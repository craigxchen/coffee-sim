   178	    rec: &mut FrameRecorder<'_>,
   179	    bind_group: &wgpu::BindGroup,
   180	    label: &'static str,
   181	    pipeline: &wgpu::ComputePipeline,
   182	    workgroups: u32,
   183	) {
   184	    let timestamp_writes = rec.writes(label);
   185	    let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
   186	        label: Some(label),
   187	        timestamp_writes,
   188	    });
   189	    pass.set_bind_group(0, bind_group, &[]);
   190	    pass.set_pipeline(pipeline);
   191	    pass.dispatch_workgroups(workgroups, 1, 1);
   192	}
