     1	// Water/bed coupling (XPBD step 3, mechanical subset). Concatenated after common/water/bed.
     2	//
     3	// Two mechanisms, both active only in mixed (water+grain) scenes:
     4	//  1. compute_fractions — per-particle solid fraction α_s = Σ_grain V_g W (clamped to the packing
     5	//     limit). The water density solve (water.wgsl) reads it and targets ρ₀·(1−α_s), so pore water
     6	//     packs to the pore fraction (drainage-ready) instead of full ρ₀ (which would be expelled).
     7	//  2. capped-pair Darcy drag — symmetric frozen-velocity gathers using local Kozeny-Carman
     8	//     porosity rates and the opposite-phase neighbor count. The same pair scale is used by both
     9	//     phases, so each pair impulse is equal-and-opposite to float tolerance.
    10	//  3. buoyancy / pressure-gradient lift — symmetric gathers over the converged water λ field.
    11	//     PBF λ is non-positive under compression in this solver, so pressure is −λ. The grain pass
    12	//     applies +J/m_g and the water pass applies −J/m_w for the same pair, avoiding float atomics.
    13	
    14	@compute @workgroup_size(256)
    15	fn compute_fractions(@builtin(global_invocation_id) gid: vec3<u32>) {
    16	    let i = gid.x;
    17	    if (i >= params.particle_count) { return; }
    18	    let h = params.coupling_h;
    19	    let xi = pred[i].xyz;
    20	    var a_s = 0.0;
    21	    var fines_dev = 0.0; // Σ_j (lodged fines − uniform baseline)·W from grain neighbors (Phase 6)
    22	    let base = cell_coord(xi);
    23	    for (var dz = -1; dz <= 1; dz = dz + 1) {
    24	        for (var dy = -1; dy <= 1; dy = dy + 1) {
    25	            for (var dx = -1; dx <= 1; dx = dx + 1) {
    26	                let nc = base + vec3<i32>(dx, dy, dz);
    27	                if (nc.x < 0 || nc.y < 0 || nc.z < 0) { continue; }
    28	                let dims = vec3<i32>(params.grid_dims.xyz);
    29	                if (nc.x >= dims.x || nc.y >= dims.y || nc.z >= dims.z) { continue; }
    30	                let cid = cell_id(nc);
    31	                let lo = cell_start[cid];
    32	                let hi = cell_start[cid + 1u];
    33	                for (var s = lo; s < hi; s = s + 1u) {
    34	                    let j = sorted_indices[s];
    35	                    if (j == i) { continue; }
    36	                    if (phase[j] != PHASE_GRAIN) { continue; } // solid fraction from grains only
    37	                    let r = length(xi - pred[j].xyz);
    38	                    if (r >= h) { continue; }
    39	                    // Swollen grains occupy more space: use the effective volume V_eff = V_dry + V_abs
    40	                    // (grain pred.w = V_abs). Dry grains (V_abs=0) ⇒ params.grain_volume, unchanged.
    41	                    let w = w_poly6(r, h);
