    50	    // lodged fines fill the pore space the packing limit leaves open, so accumulation can push α_s
    51	    // above packing_limit (toward the φ_f floor) while erosion opens channels. Baseline-relative, so
    52	    // fines_rate=0 leaves α_s exactly min(a_s, packing_limit) — byte-unchanged.
    53	    var result = min(a_s, params.packing_limit);
