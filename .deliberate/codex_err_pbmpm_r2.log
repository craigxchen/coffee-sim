   765	fn volume_projection_target_divergence(rest_volume: f32, current_volume: f32) -> f32 {
   766	    let cell_volume = dx() * dx() * dx();
   767	    let rest_volume_eps = max(cell_volume * 1e-5, p_vol() * 1e-3);
