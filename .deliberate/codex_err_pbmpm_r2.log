    87	@compute @workgroup_size(256)
    88	fn compute_coupling_scale(@builtin(global_invocation_id) gid: vec3<u32>) {
    89	    let i = gid.x;
    90	    if (i >= params.particle_count) { return; }
    91	    let ph_i = phase[i];
    92	    let xi = pred[i].xyz;
    93	    var a_scan = 0.0;
    94	    var n = 0.0;
    95	    var sum_vw = vec3<f32>(0.0); // Σ opposite-phase (water) neighbor velocity — grain wake signal (KTD-9)
    96	
    97	    let base = cell_coord(xi);
    98	    for (var dz = -1; dz <= 1; dz = dz + 1) {
    99	        for (var dy = -1; dy <= 1; dy = dy + 1) {
   100	            for (var dx = -1; dx <= 1; dx = dx + 1) {
   101	                let nc = base + vec3<i32>(dx, dy, dz);
   102	                if (nc.x < 0 || nc.y < 0 || nc.z < 0) { continue; }
   103	                let dims = vec3<i32>(params.grid_dims.xyz);
   104	                if (nc.x >= dims.x || nc.y >= dims.y || nc.z >= dims.z) { continue; }
   105	                let cid = cell_id(nc);
   106	                let lo = cell_start[cid];
   107	                let hi = cell_start[cid + 1u];
   108	                for (var s = lo; s < hi; s = s + 1u) {
   109	                    let j = sorted_indices[s];
   110	                    if (j == i) { continue; }
   111	                    let r = length(xi - pred[j].xyz);
   112	                    if (r >= params.coupling_h) { continue; }
   113	                    if (phase[j] == PHASE_GRAIN) {
   114	                        a_scan = a_scan + grain_eff_volume(pred[j].w) * w_poly6(r, params.coupling_h);
   115	                    }
   116	                    if (phase[j] != ph_i) {
   117	                        n = n + 1.0;
   118	                        if (ph_i == PHASE_GRAIN) { sum_vw = sum_vw + vel[j].xyz; }
   119	                    }
   120	                }
   121	            }
   122	        }
   123	    }
   124	
   125	    let a_from_neighbors = min(a_scan, params.packing_limit);
