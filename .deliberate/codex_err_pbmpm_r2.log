   146	fn drag_delta_for_pair(i: u32, j: u32, self_phase: u32) -> vec3<f32> {
   147	    let cs_i = coupling_scale[i];
   148	    let cs_j = coupling_scale[j];
   149	    let beta_pair = harmonic_pair(cs_i.x, cs_j.x);
   150	    let cap_pair = params.drag_beta_max / max(max(cs_i.y, cs_j.y), 1.0);
   151	    let v_pair = harmonic_pair(
   152	        particle_volume(self_phase, pred[i].w),
   153	        particle_volume(phase[j], pred[j].w),
   154	    );
   155	    let s = min(cap_pair, max(beta_pair, 0.0) * v_pair * params.dt);
   156	    // Effective masses (swelling) keep momentum conserved.
