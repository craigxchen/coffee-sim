   769	        return 0.0;
   770	    }
   771	
   772	    let j_cell = current_volume / rest_volume;
   773	    let compressed_error = clamp(1.0 - j_cell, 0.0, 0.75);
   774	    let expanded_error = clamp(j_cell - 1.0, 0.0, 0.75);
   775	    var target_div = compressed_error * projection_j_alpha()
   776	        - expanded_error * projection_j_expand_alpha();
   777	
   778	    // A cell can have an acceptable per-particle J yet contain too much
   779	    // material because many particle kernels overlap there. Treat overpacked
   780	    // cells as an independent positive expansion target, including cells whose
