    62	// ======================= shared scene machinery (self-contained per test) =====================
    63	
    64	fn build_scene(edge: f32) -> Scene {
    65	    let bed_top = BED_LAYERS;
    66	    let water_lo = bed_top + 1.0;
    67	    let water_hi = water_lo + WATER_COL;
