    70	        dose_g: 0.0,
    71	        water_ml: 0.0,
    72	        pour_water_ml: 6000.0,
    73	        gravity: [0.0, -20.0, 0.0],
    74	        box_min: [0.0, 0.0, 0.0],
    75	        box_max: [edge, y, edge],
    76	        solids: Vec::new(),
    77	        regions: vec![
    78	            SeedRegion {
    79	                min: [0.5, 0.5, 0.5],
    80	                max: [edge - 0.5, bed_top, edge - 0.5],
    81	                species: Species::Grain,
    82	            },
    83	            SeedRegion {
    84	                min: [0.7, water_lo, 0.7],
    85	                max: [edge - 0.7, water_hi, edge - 0.7],
    86	                species: Species::Water,
    87	            },
    88	        ],
    89	    }
    90	}
