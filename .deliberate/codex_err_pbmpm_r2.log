   146	    /// Reserve a begin/end timestamp pair for a compute pass labeled `label`.
   147	    fn writes(&mut self, label: &'static str) -> Option<wgpu::ComputePassTimestampWrites<'a>> {
   148	        let qs = self.qs?;
