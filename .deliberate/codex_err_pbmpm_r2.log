   107	    /// Map the readback buffer, return per-slot tick values for `0..used`.
   108	    fn read_ticks(&self, device: &wgpu::Device, used: u32) -> Vec<u64> {
   109	        let bytes = (used as u64) * 8;
   110	        let slice = self.read_buf.slice(0..bytes);
   111	        let (tx, rx) = mpsc::channel();
   112	        slice.map_async(wgpu::MapMode::Read, move |r| {
   113	            let _ = tx.send(r);
   114	        });
   115	        let _ = device.poll(wgpu::PollType::wait_indefinitely());
   116	        rx.recv()
   117	            .expect("timestamp map recv")
   118	            .expect("timestamp map");
   119	        let ticks = {
   120	            let data = slice.get_mapped_range();
   121	            // `slice` spans exactly `used * 8` bytes, so the cast yields exactly
   122	            // `used` ticks — nothing to trim.
   123	            cast_slice::<u8, u64>(&data).to_vec()
   124	        };
   125	        self.read_buf.unmap();
   126	        ticks
   127	    }
