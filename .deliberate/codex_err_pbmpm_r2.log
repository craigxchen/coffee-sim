    34	                power_preference: wgpu::PowerPreference::HighPerformance,
    35	                force_fallback_adapter: false,
    36	                compatible_surface: None,
    37	            },
    38	            true,
    39	        ))
    40	    }
    41	
    42	    /// Build a context for an on-screen window and return the matching surface. The adapter
    43	    /// is chosen as surface-compatible; the **solver and renderer share this one context** so
    44	    /// the renderer can read the solver's particle buffers. The caller owns the surface (it
    45	    /// configures/presents). Returns `None` if no adapter/device is available.
    46	    #[cfg(not(target_arch = "wasm32"))]
    47	    pub fn new_windowed(
    48	        window: Arc<winit::window::Window>,
    49	    ) -> Option<(Self, wgpu::Surface<'static>)> {
    50	        let instance = Instance::default();
    51	        let surface = instance.create_surface(window).ok()?;
    52	        let ctx = pollster::block_on(Self::request(
    53	            instance,
    54	            wgpu::RequestAdapterOptions {
    55	                power_preference: wgpu::PowerPreference::HighPerformance,
    56	                force_fallback_adapter: false,
    57	                compatible_surface: Some(&surface),
    58	            },
    59	            true,
    60	        ))?;
    61	        Some((ctx, surface))
    62	    }
    63	
    64	    /// Build a WebGPU context for a browser canvas and return the matching surface. The caller owns
    65	    /// the surface and configures/presents it in the browser frame loop.
    66	    #[cfg(target_arch = "wasm32")]
    67	    pub async fn new_web(
    68	        canvas: web_sys::HtmlCanvasElement,
    69	    ) -> Result<(Self, wgpu::Surface<'static>), wasm_bindgen::JsValue> {
    70	        let instance = Instance::new(wgpu::InstanceDescriptor {
    71	            backends: wgpu::Backends::BROWSER_WEBGPU,
    72	            ..wgpu::InstanceDescriptor::new_without_display_handle()
    73	        });
    74	        let surface = instance
    75	            .create_surface(wgpu::SurfaceTarget::Canvas(canvas))
    76	            .map_err(js_error)?;
    77	        let ctx = Self::request(
    78	            instance,
    79	            wgpu::RequestAdapterOptions {
    80	                power_preference: wgpu::PowerPreference::HighPerformance,
    81	                force_fallback_adapter: false,
    82	                compatible_surface: Some(&surface),
    83	            },
    84	            false,
    85	        )
    86	        .await
    87	        .ok_or_else(|| wasm_bindgen::JsValue::from_str("No WebGPU adapter/device available."))?;
    88	
    89	        Ok((ctx, surface))
    90	    }
    91	
    92	    /// Request the adapter, device, and queue. Native constructors block on this; the web canvas
    93	    /// constructor awaits it on the JS event loop.
    94	    async fn request(
    95	        instance: Instance,
    96	        options: wgpu::RequestAdapterOptions<'_, '_>,
    97	        allow_timestamp_queries: bool,
    98	    ) -> Option<Self> {
    99	        let adapter = instance.request_adapter(&options).await.ok()?;
   100	        let timestamps_supported =
   101	            allow_timestamp_queries && adapter.features().contains(wgpu::Features::TIMESTAMP_QUERY);
   102	        let required_features = if timestamps_supported {
   103	            wgpu::Features::TIMESTAMP_QUERY
   104	        } else {
   105	            wgpu::Features::empty()
   106	        };
   107	
   108	        // The boundary-force density passes (compute_lambda / compute_dp) bind 9 storage buffers per
   109	        // stage — one above the WebGPU spec baseline of 8. Request EXACTLY that, as a fixed value:
   110	        // modern browsers grant ≥10 (confirmed via navigator.gpu) and native Metal grants 16+, so 9
   111	        // is always within range. NOTE: do NOT derive this from `adapter.limits()` — wgpu's web
   112	        // backend over-reports that field, so requesting it makes request_device fail in the browser
   113	        // ("Device failed at creation"). All other limits stay at the WebGPU baseline for portability.
   114	        const NEEDED_STORAGE_BUFFERS: u32 = 9;
   115	        let (device, queue) = adapter
   116	            .request_device(&wgpu::DeviceDescriptor {
   117	                label: Some("coffee-sim device"),
   118	                required_features,
   119	                required_limits: wgpu::Limits {
   120	                    max_storage_buffers_per_shader_stage: NEEDED_STORAGE_BUFFERS,
   121	                    ..wgpu::Limits::default()
   122	                },
   123	                memory_hints: wgpu::MemoryHints::Performance,
   124	                trace: wgpu::Trace::default(),
   125	                experimental_features: wgpu::ExperimentalFeatures::disabled(),
   126	            })
   127	            .await
   128	            .ok()?;
   129	
   130	        Some(Self {
   131	            instance,
   132	            adapter,
   133	            device,
   134	            queue,
   135	            timestamps_supported,
   136	        })
   137	    }
   138	}
   139	
   140	#[cfg(target_arch = "wasm32")]
   141	fn js_error(error: impl ToString) -> wasm_bindgen::JsValue {
   142	    wasm_bindgen::JsValue::from_str(&error.to_string())
   143	}

