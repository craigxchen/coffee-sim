    57	/// Tile grid dimensions (ceil-divided) for a cell grid.
    58	fn tile_dims(grid_dims: [u32; 3]) -> [u32; 3] {
    59	    [
    60	        grid_dims[0].div_ceil(TILE_SIZE),
    61	        grid_dims[1].div_ceil(TILE_SIZE),
    62	        grid_dims[2].div_ceil(TILE_SIZE),
    63	    ]
    64	}
