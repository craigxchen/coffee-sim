   208	fn metrics_snapshot_from_raw(raw: &[u32], has_bed: bool) -> Option<MetricsSnapshot> {
   209	    if raw.len() < METRICS_SLOT_COUNT {
   210	        return None;
   211	    }
   212	
   213	    let active_water_mass =
   214	        raw[state::METRIC_ACTIVE_WATER_MASS_IDX] as f32 / state::METRICS_MASS_FP_SCALE;
   215	    let active_solute_mass =
   216	        raw[state::METRIC_ACTIVE_SOLUTE_MASS_IDX] as f32 / state::METRICS_SOLUTE_FP_SCALE;
   217	    let cup_water_mass =
   218	        raw[state::METRIC_CUP_WATER_MASS_IDX] as f32 / state::METRICS_MASS_FP_SCALE;
   219	    let cup_solute_mass =
   220	        raw[state::METRIC_CUP_SOLUTE_MASS_IDX] as f32 / state::METRICS_SOLUTE_FP_SCALE;
   221	    let projection_residual_cells = raw[state::METRIC_PROJECTION_RESIDUAL_CELLS_IDX];
   222	    let projection_residual_sum = raw[state::METRIC_PROJECTION_RESIDUAL_SUM_IDX] as f32
   223	        / state::METRICS_RESIDUAL_SUM_FP_SCALE;
   224	
   225	    Some(MetricsSnapshot {
   226	        max_abs_div: raw[state::METRIC_MAX_ABS_DIV_IDX] as f32 / METRICS_DIV_FP_SCALE,
   227	        fluid_cells: raw[state::METRIC_FLUID_CELLS_IDX],
   228	        div_clamp_fires: raw[state::METRIC_DIV_CLAMP_FIRES_IDX],
   229	        pressure_clamp_fires: raw[state::METRIC_PRESSURE_CLAMP_FIRES_IDX],
   230	        mass_overflow_fires: raw[state::METRIC_MASS_OVERFLOW_FIRES_IDX],
   231	        projection_residual_max_abs_div: raw[state::METRIC_PROJECTION_RESIDUAL_MAX_IDX] as f32
   232	            / METRICS_DIV_FP_SCALE,
   233	        projection_residual_mean_abs_div: projection_residual_sum
   234	            / (projection_residual_cells as f32).max(1.0),
   235	        projection_residual_cells,
   236	        mean_tds: active_solute_mass / active_water_mass.max(1e-6),
   237	        cup_tds: cup_solute_mass / cup_water_mass.max(1e-6),
   238	        extraction_yield: if has_bed {
   239	            active_solute_mass / (DEFAULT_BREW.coffee_dose_g * MASS_UNITS_PER_ML)
   240	        } else {
   241	            0.0
   242	        },
   243	    })
   244	}
