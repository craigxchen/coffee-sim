    60	fn drag_alpha_for_particle_from_alpha(i: u32, ph_i: u32, base_alpha: f32) -> f32 {
    61	    var a = base_alpha;
    62	    // α_s excludes self to keep the water density field a neighbor sum. For a grain's own Darcy
    63	    // probe, include its occupied volume so an isolated or surface grain still carries a finite
    64	    // packed-bed resistance in the symmetric harmonic pair rate.
    65	    if (ph_i == PHASE_GRAIN) {
    66	        a = a + grain_eff_volume(pred[i].w) * w_poly6(0.0, params.coupling_h);
    67	    }
    68	    return min(a, 0.95);
    69	}
    70	
    71	fn darcy_beta_from_alpha(a_s: f32) -> f32 {
    72	    let eps = clamp(1.0 - a_s, 0.35, 0.999);
    73	    let solid = 1.0 - eps;
    74	    let d2 = max(params.grain_diameter * params.grain_diameter, 1.0e-8);
    75	    return params.drag_scale * 150.0 * solid * solid / max(eps * eps * eps * d2, 1.0e-12);
    76	}
    77	
    78	fn harmonic_pair(a: f32, b: f32) -> f32 {
    79	    return (2.0 * a * b) / max(a + b, 1.0e-12);
    80	}
    81	
    82	fn particle_volume(ph: u32, w: f32) -> f32 {
    83	    if (ph == PHASE_GRAIN) { return grain_eff_volume(w); }
    84	    return max(water_eff_mass(w) / max(params.rest_density, 1.0e-12), 0.0);
    85	}
