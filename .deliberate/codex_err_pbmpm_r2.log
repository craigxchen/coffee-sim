    92	fn gate_cfg() -> Config {
    93	    Config {
    94	        solid_dynamics: true,
    95	        tf_filter_floor: true,
    96	        nozzle_radius: 1.5,
    97	        tf_wet_cohesion: 4.0,
    98	        tf_cohesion_speak: 0.4,
