   139	struct Measured {
   140	    n_water: u32,
   141	    n_solid: u32,
   142	    substeps: u32,
   143	    dispatches: u32,
   144	    median_ms: f32,
   145	    per_kpart: f32,
   146	    breakdown: Vec<(String, f32)>,
   147	}
