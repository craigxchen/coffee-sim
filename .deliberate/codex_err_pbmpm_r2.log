    66	/// Total number of `TILE_SIZE^3` tiles covering the cell grid (partial edge
    67	/// tiles included).
    68	pub(crate) fn tile_count(grid_dims: [u32; 3]) -> u32 {
    69	    let [tx, ty, tz] = tile_dims(grid_dims);
    70	    tx * ty * tz
    71	}
