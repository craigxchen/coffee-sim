    38	}
    39	
    40	/// The contract every complete coffee+water method implements, so `engine`, `ui`, and
    41	/// `profiling` drive any solver uniformly.
    42	///
    43	/// Contract:
    44	/// - `step()` advances a **whole frame**; internal substepping, coupling, and extraction
    45	///   are the solver's business.
    46	/// - `step()` must be **deterministic** given identical state + input + seed.
    47	/// - `step()` must never leave the sim in a non-finite state.
    48	/// - `particles()`/`metrics()`/`profile()` are read-only and cheap; they must not trigger
    49	///   a GPU sync that stalls the frame (read the prior frame's resolved results).
    50	pub trait Solver {
    51	    /// Build the solver for a scene. Not callable on a trait object (`Self: Sized`); the
    52	    /// registry dispatches per `SolverId`.
    53	    fn build(scene: &Scene, mats: &Materials, cfg: &Config, gpu: &GpuContext) -> Self
    54	    where
    55	        Self: Sized;
    56	
    57	    /// Reset to the scene's initial state without rebuilding GPU resources.
    58	    fn reset(&mut self, scene: &Scene);
    59	
    60	    /// Advance one frame.
    61	    fn step(&mut self, dt: f32, input: &EmissionInput);
    62	
    63	    /// Canonical particle buffers for rendering.
    64	    fn particles(&self) -> ParticleBuffers;
    65	
    66	    /// Brew-outcome metrics (yield, TDS, drawdown, evenness).
    67	    fn metrics(&self) -> Metrics;
    68	
    69	    /// Per-pass GPU timestamps + dispatches-per-frame.
    70	    fn profile(&self) -> Profile;
    71	}
