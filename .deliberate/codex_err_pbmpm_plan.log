    14	
    15	/// Numerical family of a solver. Data only — drives no behavior in the seam.
    16	#[derive(Deserialize, Clone, Copy, Debug, PartialEq, Eq)]
    17	pub enum Paradigm {
    18	    PositionBased,
    19	    ForceBased,
