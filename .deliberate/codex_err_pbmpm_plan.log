   139	struct Measured {
   140	    n_water: u32,
   141	    n_solid: u32,
   142	    substeps: u32,
   143	    dispatches: u32,
   144	    median_ms: f32,
   145	    per_kpart: f32,
   146	    breakdown: Vec<(String, f32)>,
   147	}
   148	
   149	/// Build the fixed-composition scene at `edge`, warm up into the pour, and return the median
   150	/// per-frame GPU cost (`substeps × substep-0 timestamp sum`) over the measure window.
   151	fn measure(gpu: &GpuContext, edge: f32) -> Measured {
   152	    let scene = build_scene(edge);
   153	    let mats = gate_mats();
   154	    let cfg = gate_cfg();
   155	    let mut solver = TwofieldSolver::build(&scene, &mats, &cfg, gpu);
   156	    let (_, n_solid) = solver.phase_counts();
   157	    let bed_top = scene.regions[0].max[1];
   158	    saturate_bed(&mut solver, edge, bed_top);
   159	    let n_water = solver.active_count() - n_solid;
   160	
   161	    let axis = (edge / 2.0, edge / 2.0);
   162	    let water_hi = scene.regions[1].max[1];
   163	    let quiet = EmissionInput::default();
   164	    let pour = EmissionInput {
   165	        kettle_pos: [axis.0, water_hi + 6.0, axis.1],
   166	        flow_rate: 70.0,
   167	        pour_angle: 0.0,
   168	        ..EmissionInput::default()
   169	    };
   170	    for f in 0..WARMUP_FRAMES {
   171	        let drive = if f < WARMUP_FRAMES / 3 { &quiet } else { &pour };
   172	        solver.step(DT, drive);
   173	    }
   174	
   175	    let substeps = solver.substeps_for_dt(DT);
   176	    let mut samples: Vec<f32> = Vec::new();
   177	    let mut agg: std::collections::HashMap<String, f32> = std::collections::HashMap::new();
   178	    let mut dispatches = 0u32;
   179	    for _ in 0..MEASURE_FRAMES {
   180	        solver.step(DT, &pour);
   181	        solver.sample_diagnostics();
   182	        let prof = solver.profile();
   183	        dispatches = prof.dispatches_per_frame;
   184	        let sub = prof.total_micros();
   185	        if sub > 0.0 {
   186	            samples.push(sub * substeps as f32);
   187	            for (label, us) in &prof.passes {
   188	                *agg.entry(label.clone()).or_insert(0.0) += us * substeps as f32;
   189	            }
   190	        }
   191	    }
   192	    samples.sort_by(|a, b| a.partial_cmp(b).unwrap());
   193	    let median_us = if samples.is_empty() {
   194	        0.0
   195	    } else {
   196	        samples[samples.len() / 2]
   197	    };
   198	    let n = (n_water + n_solid).max(1);
   199	    let denom = samples.len().max(1) as f32;
   200	    let mut breakdown: Vec<(String, f32)> = agg.into_iter().map(|(k, v)| (k, v / denom)).collect();
   201	    breakdown.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
   202	
   203	    Measured {
   204	        n_water,
   205	        n_solid,
   206	        substeps,
   207	        dispatches,
   208	        median_ms: median_us / 1000.0,
   209	        per_kpart: median_us / (n as f32 / 1000.0),
   210	        breakdown,
   211	    }
   212	}
