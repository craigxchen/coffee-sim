     1	//! Shared uniform-grid spatial hash, binned once per step for all particle species.
     2	//!
     3	//! Phase 0 ships a minimal, correct **CPU** implementation (build + neighbor query),
     4	//! verified against brute force. The GPU radix-sort version (cell-start/cell-count
     5	//! arrays) lands when a solver needs it; this keeps the cross-solver neighbor contract
     6	//! pinned now.
     7	
     8	use std::collections::HashMap;
     9	
    10	/// Uniform-grid neighbor structure over 3D points. Cell size should be the neighbor
    11	/// search radius (e.g. the SPH support radius), so the 3×3×3 block around a query cell is
    12	/// a superset of all points within one cell size.
    13	pub struct SpatialHash {
    14	    cell_size: f32,
    15	    cells: HashMap<(i32, i32, i32), Vec<u32>>,
    16	}
    17	
    18	impl SpatialHash {
    19	    pub fn new(cell_size: f32) -> Self {
    20	        assert!(cell_size > 0.0, "cell_size must be positive");
    21	        Self {
    22	            cell_size,
    23	            cells: HashMap::new(),
    24	        }
    25	    }
    26	
    27	    fn cell_of(&self, p: [f32; 3]) -> (i32, i32, i32) {
    28	        (
    29	            (p[0] / self.cell_size).floor() as i32,
    30	            (p[1] / self.cell_size).floor() as i32,
    31	            (p[2] / self.cell_size).floor() as i32,
    32	        )
    33	    }
    34	
    35	    /// Rebuild the hash from a fresh set of points; the returned indices match `points`.
    36	    pub fn rebuild(&mut self, points: &[[f32; 3]]) {
    37	        self.cells.clear();
    38	        for (i, &p) in points.iter().enumerate() {
    39	            self.cells
    40	                .entry(self.cell_of(p))
    41	                .or_default()
    42	                .push(i as u32);
    43	        }
    44	    }
    45	
    46	    /// Candidate neighbor indices: everything in the 3×3×3 block of cells around `p`.
    47	    /// This is a superset of points within `cell_size`; callers apply the exact radius
    48	    /// test. Order is unspecified.
    49	    pub fn neighbors(&self, p: [f32; 3]) -> Vec<u32> {
    50	        let (cx, cy, cz) = self.cell_of(p);
    51	        let mut out = Vec::new();
    52	        for dx in -1..=1 {
    53	            for dy in -1..=1 {
    54	                for dz in -1..=1 {
    55	                    if let Some(bucket) = self.cells.get(&(cx + dx, cy + dy, cz + dz)) {
    56	                        out.extend_from_slice(bucket);
    57	                    }
    58	                }
    59	            }
    60	        }
    61	        out
    62	    }
    63	}
    64	
    65	#[cfg(test)]
    66	mod tests {
    67	    use super::*;
    68	    use crate::utils::rng::Rng;
    69	
    70	    fn dist2(a: [f32; 3], b: [f32; 3]) -> f32 {
    71	        let d = [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    72	        d[0] * d[0] + d[1] * d[1] + d[2] * d[2]
    73	    }
    74	
    75	    #[test]
    76	    fn candidates_superset_of_true_neighbors() {
    77	        let mut rng = Rng::new(42);
    78	        let cell = 0.25_f32;
    79	        let points: Vec<[f32; 3]> = (0..400)
    80	            .map(|_| {
    81	                [
    82	                    rng.next_f32() * 2.0 - 1.0,
    83	                    rng.next_f32() * 2.0 - 1.0,
    84	                    rng.next_f32() * 2.0 - 1.0,
    85	                ]
    86	            })
    87	            .collect();
    88	
    89	        let mut hash = SpatialHash::new(cell);
    90	        hash.rebuild(&points);
    91	
    92	        // Every brute-force neighbor within `cell` must appear in the candidate set.
    93	        for (i, &q) in points.iter().enumerate() {
