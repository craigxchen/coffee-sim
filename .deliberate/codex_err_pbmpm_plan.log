    35	/// The scenes the web UI exposes. The first two are the main "Scenes" tab; the rest are the
    36	/// "Debug Scenes" catalog, ported by intent from the `main` MPM branch's `DebugScene` enum (plus the
    37	/// new `SandWall`). Kebab ids match `main`'s debug-scene ids (with `sand-wall` added).
    38	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
    39	pub enum WebScene {
