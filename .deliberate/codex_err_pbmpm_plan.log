   347	/// Scene + calibrated materials/config for each web scene. Center Pour mirrors the native viewer's
   348	/// `v60pour` setup at a browser-friendly resolution; Water Only is the default dam.
   349	///
   350	/// `solver_id` lets the coffee scene turn on the two-field coupling gates when the two-field solver
   351	/// is active. Those `tf_*`/`solid_dynamics` flags are opt-in (default OFF) and the XPBD solver
   352	/// ignores them, so they are applied only for `SolverId::Twofield` — keeping the XPBD path's config
   353	/// byte-identical to before.
   354	fn setup_for(kind: WebScene, solver_id: SolverId) -> (Scene, Materials, Config) {
   355	    let scene = kind.build();
   356	    let twofield = solver_id == SolverId::Twofield;
   357	    match kind {
   358	        // --- main "Scenes" tab + filter/bed debug scenes (full V60 dripper, bed present) ---
   359	        // All run the calibrated V60-with-bed materials/config; twofield turns on the coupling gates.
   360	        WebScene::CenterPour
   361	        | WebScene::FilterWaterBlock
   362	        | WebScene::OffCenterFilterWallPour
   363	        | WebScene::UniformBedSaturation
   364	        | WebScene::PermeabilityComparison
   365	        | WebScene::ParticleCapacityStress => {
   366	            let (mats, mut cfg) = v60_bed_setup(twofield);
   367	            if matches!(kind, WebScene::PermeabilityComparison) {
   368	                // Tighter bed → lower permeability: stiffen the Darcy drag so water ponds and drains
   369	                // slowly (the rewrite analogue of main's finer-grind Kozeny–Carman bed).
   370	                cfg.drag_scale = 0.55;
   371	                cfg.drag_beta_max = 0.97;
   372	                cfg.drag_subiters = 8;
   373	            }
   374	            (scene, mats, cfg)
   375	        }
   376	
   377	        // --- V60 water-only debug scenes (full dripper, NO bed): pours + still cup-water cases ---
   378	        WebScene::WaterOnly
   379	        | WebScene::SeededPaperWallSheet
   380	        | WebScene::FilterApexDrain
   381	        | WebScene::CupWallFloorCornerContact
   382	        | WebScene::AsymmetricCupMoundSettle
   383	        | WebScene::HydrostaticColumn
   384	        | WebScene::DamBreakSlosh
   385	        | WebScene::SparseFreeJet
   386	        | WebScene::HighVelocityJetImpact => {
   387	            let (mats, cfg) = v60_water_setup(twofield);
   388	            (scene, mats, cfg)
   389	        }
