   310	/// the frame runs `substeps × (DISPATCHES_PER_FRAME + U5 increment)`. We pin that the count is
   311	/// EXACTLY the recorded formula (no hidden growth) on the gate scene.
   312	#[test]
   313	fn dispatch_budget_within_recorded_formula() {
   314	    let Some(gpu) = GpuContext::new_headless() else {
   315	        eprintln!("twofield_perf: no GPU adapter; skipping.");
   316	        return;
