   324	        kettle_pos: [axis.0, water_hi + 6.0, axis.1],
   325	        flow_rate: 70.0,
   326	        ..EmissionInput::default()
   327	    };
   328	    // A few frames so the pour activates (water present → the full water+solid pipeline runs).
