    95	                hash.neighbors(q).into_iter().collect();
    96	            for (j, &p) in points.iter().enumerate() {
    97	                if i != j && dist2(q, p) <= cell * cell {
    98	                    assert!(
    99	                        candidates.contains(&(j as u32)),
   100	                        "true neighbor {j} of {i} missing from candidate set",
   101	                    );
   102	                }
   103	            }
   104	        }
