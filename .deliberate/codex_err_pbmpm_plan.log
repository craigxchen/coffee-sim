     1	//! The solver registry + the embedded solver-description catalog.
     2	//!
     3	//! Adding a solver is three small, local edits: one row in `solvers.json`, one `SolverId`
     4	//! variant, and one arm in [`build_solver`] — never a new fork. This is the seam that
     5	//! prevents the per-solver branch sprawl that forced v1's modular rewrite.
     6	
     7	use std::collections::HashMap;
     8	
     9	use crate::engine::scene::Scene;
    10	use crate::models::Materials;
    11	use crate::solvers::base::{Solver, SolverInfo};
    12	use crate::solvers::noop::{NoopSolverA, NoopSolverB};
    13	use crate::solvers::twofield::TwofieldSolver;
    14	use crate::solvers::xpbd::XpbdSolver;
    15	use crate::utils::config::Config;
    16	use crate::utils::gpu::GpuContext;
    17	
    18	/// Solver-description catalog, embedded at build time.
    19	const SOLVERS_JSON: &str = include_str!("solvers.json");
    20	
    21	/// Identifies a registered solver. `id()` is its key in `solvers.json`.
    22	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
    23	pub enum SolverId {
    24	    NoopA,
    25	    NoopB,
    26	    Xpbd,
    27	    Twofield,
    28	}
    29	
    30	impl SolverId {
    31	    pub fn id(self) -> &'static str {
    32	        match self {
    33	            SolverId::NoopA => "noop_a",
    34	            SolverId::NoopB => "noop_b",
    35	            SolverId::Xpbd => "xpbd",
    36	            SolverId::Twofield => "twofield",
    37	        }
    38	    }
    39	
    40	    /// Every registered solver, for UI dropdowns and comparison sweeps.
    41	    pub fn all() -> &'static [SolverId] {
    42	        &[
    43	            SolverId::NoopA,
    44	            SolverId::NoopB,
    45	            SolverId::Xpbd,
    46	            SolverId::Twofield,
    47	        ]
    48	    }
    49	}
    50	
    51	/// Parsed solver descriptions keyed by `SolverId::id()`.
    52	pub struct Catalog {
    53	    entries: HashMap<String, SolverInfo>,
    54	}
    55	
    56	impl Catalog {
    57	    /// Parse the embedded catalog. Panics on malformed JSON — a build-time invariant.
    58	    pub fn load() -> Self {
    59	        let entries: HashMap<String, SolverInfo> =
    60	            serde_json::from_str(SOLVERS_JSON).expect("engine/solvers.json is valid JSON");
    61	        Self { entries }
    62	    }
    63	
    64	    /// Look up a solver's description. Panics if a `SolverId` has no catalog row — a
    65	    /// startup invariant (every registered solver must be described).
    66	    pub fn info(&self, id: SolverId) -> SolverInfo {
    67	        self.entries
    68	            .get(id.id())
    69	            .unwrap_or_else(|| panic!("solvers.json missing an entry for {:?} ({})", id, id.id()))
    70	            .clone()
    71	    }
    72	}
    73	
    74	/// Look up a solver's description without building it.
    75	pub fn info_for(id: SolverId) -> SolverInfo {
    76	    Catalog::load().info(id)
    77	}
    78	
    79	/// Build the active solver for `id` on the given scene (powers the runtime solver-switch).
    80	pub fn build_solver(
    81	    id: SolverId,
    82	    scene: &Scene,
    83	    mats: &Materials,
    84	    cfg: &Config,
    85	    gpu: &GpuContext,
    86	) -> Box<dyn Solver> {
    87	    match id {
    88	        SolverId::NoopA => Box::new(NoopSolverA::build(scene, mats, cfg, gpu)),
    89	        SolverId::NoopB => Box::new(NoopSolverB::build(scene, mats, cfg, gpu)),
    90	        SolverId::Xpbd => Box::new(XpbdSolver::build(scene, mats, cfg, gpu)),
    91	        SolverId::Twofield => Box::new(TwofieldSolver::build(scene, mats, cfg, gpu)),
    92	    }
    93	}
    94	
    95	#[cfg(test)]
    96	mod tests {
    97	    use super::*;
    98	    use crate::solvers::base::Paradigm;
    99	
   100	    #[test]
   101	    fn catalog_parses_and_every_solver_id_resolves() {
   102	        let catalog = Catalog::load();
   103	        for &id in SolverId::all() {
   104	            // Panics if any registered solver is missing a catalog row.
   105	            let info = catalog.info(id);
   106	            assert!(!info.name.is_empty(), "{id:?} has an empty name");
   107	        }
   108	    }
   109	
   110	    #[test]
   111	    fn noop_variants_have_distinct_descriptions() {
   112	        // The runtime switch must observe a real difference between the two variants.
   113	        let a = info_for(SolverId::NoopA);
   114	        let b = info_for(SolverId::NoopB);
   115	        assert_eq!(a.paradigm, Paradigm::PositionBased);
   116	        assert_eq!(b.paradigm, Paradigm::ForceBased);
   117	        assert_ne!(a.paradigm, b.paradigm);
   118	        assert_ne!(a.owns_grid, b.owns_grid);
   119	    }
   120	}

