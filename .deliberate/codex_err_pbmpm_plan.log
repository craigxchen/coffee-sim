     1	//! Pure control-mapping helpers for the web UI (compiled on every target so they are unit-tested
     2	//! natively; the wasm handle in `web.rs` calls them). These translate the original v1 frontend's
     3	//! controls — water-velocity slider, 2D spout pad, scene buttons — into the rewrite's canonical
     4	//! `EmissionInput`/`Scene` inputs. Keeping them here (not in the wasm-only module) means the
     5	//! conversions are exercised by `cargo test` on native, where the GPU/browser parts can't run.
     6	
     7	use crate::engine::Scene;
     8	
     9	/// Sim length units per physical metre (KEEP.md §2: V60 paper ≈ 10 cm ≈ 5.77 sim units → ≈ 27.7).
    10	pub const SIM_UNITS_PER_METER: f32 = 27.7;
    11	
    12	/// Convert the v1 water-velocity slider (metres/second) to the rewrite's volumetric
    13	/// `EmissionInput.flow_rate` (sim-units³/s). The emitter derives the stream exit speed as
    14	/// `flow / A_eff` with `A_eff = π·nozzle_radius²·discharge_coeff`, so this is the inverse: a slider
    15	/// of `v` m/s reproduces an exit speed of `v·SIM_UNITS_PER_METER` sim-units/s. `ML_PER_SIM_UNIT3` is
    16	/// **not** involved (that scale is for mL display/capping only).
    17	#[inline]
    18	pub fn flow_rate_for_velocity(speed_m_s: f32, nozzle_radius: f32, discharge_coeff: f32) -> f32 {
    19	    let a_eff = std::f32::consts::PI * nozzle_radius * nozzle_radius * discharge_coeff;
    20	    a_eff * (speed_m_s.max(0.0) * SIM_UNITS_PER_METER)
    21	}
    22	
    23	/// Map the v1 spout pad (normalized `(u, v) ∈ [-1, 1]`, with a separate height) to a world kettle
    24	/// position. `half_extent` is the in-plane half-width the pad spans (the scene's x/z bound). Out-of-
    25	/// range pad values clamp to the pad edge.
    26	#[inline]
    27	pub fn kettle_pos_for_pad(u: f32, v: f32, height: f32, half_extent: f32) -> [f32; 3] {
    28	    [
    29	        u.clamp(-1.0, 1.0) * half_extent,
    30	        height,
    31	        v.clamp(-1.0, 1.0) * half_extent,
    32	    ]
    33	}
