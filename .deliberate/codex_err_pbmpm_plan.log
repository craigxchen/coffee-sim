   124	// --- fixed-point encoding (KEEP.md §3 pattern, headroom re-validated for U2) -----------------
   125	//
   126	// FP_SCALE = 2^18. i32 range is ±2^31, so an encoded node lane overflows at |value| ≥ 2^13 = 8192.
   127	//   mass lane:      Σ_p m·w per node. Unit-mass water at rest loads an interior node with
   128	//                   Σ m·w ≈ (particles per cell volume) = (h/spacing)³ = 8 → overflow needs
   129	//                   ≈ 1000× rest packing on one node. Unreachable.
   130	//   momentum lanes: every scattered contribution is magnitude-clamped to max_speed (50 by
   131	//                   default — Config::max_speed, the same cap G2P enforces), so |Σ m·w·v_aff| ≤
   132	//                   (Σ m·w)·max_speed → overflow needs Σ m·w ≥ 8192/50 ≈ 164 mass units on one
   133	//                   node ≈ 20× rest compression with EVERY particle at the cap. The overflow
   134	//                   probe gate (tests/twofield_water.rs) exercises a capped, pancaked worst case.
   135	// COUPLED to the velocity cap: raising max_speed shrinks the momentum headroom linearly —
   136	// change one, re-derive the other. fp_encode also saturates (clamp before convert) as a
   137	// backstop so a pathological state degrades bounded instead of wrapping.
   138	const FP_SCALE: f32 = 262144.0; // 2^18
   139	// Largest f32 ≤ i32::MAX (2^31 − 1 = 2147483647 is not representable; nearest-below is 2147483520).
   140	const FP_CLAMP: f32 = 2147483520.0;
   141	
   142	fn fp_encode(x: f32) -> i32 {
   143	    return i32(clamp(round(x * FP_SCALE), -FP_CLAMP, FP_CLAMP));
   144	}
   145	fn fp_decode(c: i32) -> f32 {
   146	    return f32(c) / FP_SCALE;
   147	}
   148	
   149	// --- quadratic B-spline weights (KEEP.md §3 validated math) -----------------------------------
   150	// Per axis, around base = floor(x/h − 0.5) with fx = x/h − base ∈ [0.5, 1.5]; node offset
   151	// k ∈ {0,1,2} gets w[k]. Weights sum to 1 and Σ_k w[k]·(base+k) = x/h (linear consistency —
   152	// what makes the free-fall recurrence exact and keeps APIC's C zero in a uniform field).
   153	fn bspline_w(fx: vec3<f32>) -> array<vec3<f32>, 3> {
   154	    var w: array<vec3<f32>, 3>;
   155	    w[0] = 0.5 * (1.5 - fx) * (1.5 - fx);
   156	    w[1] = 0.75 - (fx - 1.0) * (fx - 1.0);
   157	    w[2] = 0.5 * (fx - 0.5) * (fx - 0.5);
   158	    return w;
   159	}
   160	
   161	// Analytic d/dfx of bspline_w (per axis), so ∂w/∂x = dw/h (the 1/h chain-rule scale is applied
   162	// by the caller). Used by g2p_water's mass-gradient gather (U2 surface-weighted dissipation):
   163	// ∇w_3d = (dw.x·w.y·w.z, w.x·dw.y·w.z, w.x·w.y·dw.z)/h. NOT reusable from APIC's B (which uses the
   164	// d-offset form, not ∇w) — a few extra ALU ops, no new binding.
   165	//   d/dfx [0.5·(1.5−fx)²] = −(1.5 − fx)
   166	//   d/dfx [0.75 − (fx−1)²] = −2·(fx − 1)
   167	//   d/dfx [0.5·(fx−0.5)²]  =  (fx − 0.5)
   168	fn bspline_dw(fx: vec3<f32>) -> array<vec3<f32>, 3> {
   169	    var dw: array<vec3<f32>, 3>;
   170	    dw[0] = -(1.5 - fx);
   171	    dw[1] = -2.0 * (fx - 1.0);
   172	    dw[2] = fx - 0.5;
   173	    return dw;
   174	}
   175	
   176	// --- grid indexing -----------------------------------------------------------------------------
   177	// Flat node index, x-fastest. Node world position = grid_origin + (i,j,k)·h.
   178	fn node_index(n: vec3<i32>) -> u32 {
   179	    return u32(n.x) + params.grid_dims.x * (u32(n.y) + params.grid_dims.y * u32(n.z));
   180	}

