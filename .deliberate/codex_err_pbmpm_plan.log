   330	impl CoffeeSimApp {
   331	    /// Rebuild the solver + camera for a new scene (drop-and-rebuild — GPU resources are RAII).
   332	    /// Used both by the scene-change path and `set_solver` (same drop-and-rebuild on the current
   333	    /// scene/mats/cfg for the active `solver_id`).
   334	    fn rebuild(&mut self, kind: WebScene) {
   335	        let (scene, mats, cfg) = setup_for(kind, self.solver_id);
   336	        self.solver = build_solver(self.solver_id, &scene, &mats, &cfg, &self.gpu);
   337	        configure_renderer(&mut self.renderer, &mats);
   338	        self.renderer.set_solids(&scene.solids); // refresh the cone / cup wireframe for the new scene
   339	        self.camera = OrbitCamera::framing(Vec3::from(scene.box_min), Vec3::from(scene.box_max));
   340	        self.scene_kind = kind;
   341	        self.scene = scene;
   342	        self.mats = mats;
   343	        self.cfg = cfg;
   344	    }
   345	}
