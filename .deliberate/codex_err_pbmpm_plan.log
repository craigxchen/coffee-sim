   479	            "  GCI refine h={:.2} (fine_sweeps {fs}, N={}): water COM height = {:.4}",
   480	            2.0 * s,
   481	            counts[i],
   482	            qoi[i]
   483	        );
   484	    }
   485	
   486	    // Richardson extrapolation on the 2:1:1 triple (r = 2). Observed order
   487	    //   p = ln(|f1 − f2| / |f2 − f3|) / ln(r),
   488	    // extrapolated value f_exact ≈ f3 + (f3 − f2)/(r^p − 1), GCI band on the finest pair.
   489	    let (f1, f2, f3) = (qoi[0], qoi[1], qoi[2]);
