   407	/// grid-normalized across resolutions and would diverge for non-spatial reasons).
   408	/// The fine-sweep budget SCALES with resolution so iterative error stays subdominant to
   409	/// truncation (a fixed absolute sweep count fails the asymptotic-range check for non-spatial
   410	/// reasons — KTD-2 / Roache). We compute the observed order p and the Richardson-extrapolated
   411	/// value, store it as a regression band, and check p is a finite positive order (the asymptotic-
   412	/// range sanity check). The fixed real-time sweep budget is gated separately by U3's tolerance.
   413	#[test]
   414	fn offline_gci_refinement_settled_height() {
   415	    let Some(gpu) = GpuContext::new_headless() else {
   416	        eprintln!("twofield_perf: no GPU adapter; skipping.");
   417	        return;
   418	    };
   419	    // Three 2:1 refinements via the particle spacing (cell size h = 2·spacing tracks it): a
   420	    // fixed physical column (a short saturated bed), QoI = settled water COM height at rest.
   421	    // Coarse → fine spacing halves; the fine-sweep budget DOUBLES per refinement so iterative
   422	    // error decays faster than truncation.
   423	    let spacings = [2.0f32, 1.0, 0.5];
   424	    let fine_sweeps = [8u32, 16, 32]; // scales with resolution (KTD-2)
   425	    let mut qoi = [0.0f64; 3];
   426	    let mut counts = [0u32; 3];
   427	    for (i, (&s, &fs)) in spacings.iter().zip(&fine_sweeps).enumerate() {
   428	        let scene = Scene {
   429	            gravity: [0.0, -20.0, 0.0],
   430	            box_min: [0.0, 0.0, 0.0],
   431	            box_max: [8.0, 16.0, 8.0],
   432	            pour_water_ml: 0.0,
   433	            solids: Vec::new(),
   434	            regions: vec![
   435	                SeedRegion {
   436	                    min: [0.5, 0.5, 0.5],
   437	                    max: [7.5, 6.0, 7.5],
   438	                    species: Species::Grain,
   439	                },
   440	                SeedRegion {
   441	                    min: [0.7, 6.5, 0.7],
   442	                    max: [7.3, 12.0, 7.3],
   443	                    species: Species::Water,
   444	                },
   445	            ],
   446	            ..Scene::default()
   447	        };
   448	        let mats = Materials {
   449	            particle_spacing: s,
   450	            support_radius: 2.0 * s,
   451	            grain_diameter: s,
   452	            ..Materials::default()
   453	        };
   454	        let cfg = Config::default(); // frozen skeleton: a clean hydrostatic column (no plasticity noise)
   455	        let mut solver = TwofieldSolver::build(&scene, &mats, &cfg, &gpu);
   456	        solver.set_pressure_budget_for_test(4, 8, fs);
   457	        for _ in 0..120 {
   458	            solver.step(DT, &EmissionInput::default());
   459	        }
   460	        // QoI: the settled water-column center-of-mass height — a PHYSICAL length (scene units),
   461	        // grid-INDEPENDENT by construction, that converges to the incompressible-equilibrium fill
   462	        // height as the grid refines. (The raw pressure field is NOT grid-normalized across
   463	        // resolutions, so it is not a valid Richardson QoI — it would diverge for non-spatial
   464	        // reasons; the settled height is the clean truncation-error probe.)
   465	        let pos = solver.read_positions();
   466	        let phase = solver.read_phases();
   467	        let live = solver.active_count() as usize;
   468	        let mut sum = 0.0f64;
   469	        let mut cnt = 0u32;
   470	        for k in 0..live.min(pos.len()).min(phase.len()) {
   471	            if phase[k] == 0 && pos[k][3] > 0.0 {
   472	                sum += pos[k][1] as f64;
   473	                cnt += 1;
   474	            }
   475	        }
   476	        qoi[i] = if cnt > 0 { sum / cnt as f64 } else { 0.0 };
   477	        counts[i] = solver.active_count();
