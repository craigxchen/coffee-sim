    41	    /// live inflow, as in v1).
    42	    CenterPour,
    43	    /// "Water Only" — a water dam with no bed (the original's free-stream).
    44	    WaterOnly,
    45	
    46	    // --- Debug catalog ---
    47	    /// `filter-water-block` — a still water block in the filter cone over the bed, no pour.
    48	    FilterWaterBlock,
    49	    /// `off-center-filter-wall-pour` — V60 pour with the spout parked toward the filter wall.
    50	    OffCenterFilterWallPour,
    51	    /// `seeded-paper-wall-sheet` — a thin water sheet clinging to the filter wall, no pour.
    52	    SeededPaperWallSheet,
    53	    /// `filter-apex-drain` — water low in the filter cone, no bed, draining through the apex.
    54	    FilterApexDrain,
    55	    /// `cup-wall-floor-corner-contact` — cup-only water in a wall/floor corner wedge.
    56	    CupWallFloorCornerContact,
    57	    /// `asymmetric-cup-mound-settle` — cup-only off-center water mound settling level.
    58	    AsymmetricCupMoundSettle,
    59	    /// `hydrostatic-column` — cup-only tall narrow on-axis water column.
    60	    HydrostaticColumn,
    61	    /// `dam-break-slosh` — cup-only half-fill released to slosh.
    62	    DamBreakSlosh,
    63	    /// `sparse-free-jet` — a thin slow pour into the empty cup.
    64	    SparseFreeJet,
    65	    /// `high-velocity-jet-impact` — a fast pour plunging onto a shallow cup pool.
    66	    HighVelocityJetImpact,
    67	    /// `uniform-bed-saturation` — the V60 bed pre-saturated with water, no pour.
    68	    UniformBedSaturation,
    69	    /// `permeability-comparison` — V60 pour with a tighter (lower-permeability) bed.
    70	    PermeabilityComparison,
    71	    /// `particle-capacity-stress` — V60 pour driven at a high flow rate.
