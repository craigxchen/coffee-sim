    29	
    30	/// A solver's description, deserialized from `engine/solvers.json`. Never returned by the
    31	/// trait — so the catalog is the single place solver metadata lives.
    32	#[derive(Deserialize, Clone, Debug)]
    33	pub struct SolverInfo {
    34	    pub name: String,
