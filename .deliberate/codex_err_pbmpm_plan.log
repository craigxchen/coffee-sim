   330	        solver.step(DT, &pour);
   331	    }
   332	    let substeps = solver.substeps_for_dt(DT);
   333	    let (_, _, dims) = solver.grid_spec();
   334	    // Water-present dynamic budget per the U5 doc: substeps × (dispatches_per_frame + the U5
   335	    // plasticity increment of 2: solid_update + g2p_solid each substep; p2g_solid_dyn replaces
   336	    // p2g_solid 1:1). The frame budget is scene-derived through the U4 flood stack. U9 absorption
   337	    // is OFF on this scene (tf_absorb_rate default 0).
   338	    let expected = substeps * (dispatches_per_frame_for(dims) + 2);
   339	    println!(
   340	        "twofield U8 dispatch budget: substeps {substeps}, dispatches/frame {} (expected {expected})",
   341	        solver.profile().dispatches_per_frame
