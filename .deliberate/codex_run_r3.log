    let m_old = params.grain_mass + params.rest_density * v_abs;
    let dm = params.rest_density * d_v;
    vel[i] = vec4<f32>((m_old * vel[i].xyz + p_abs) / (m_old + dm), 0.0);
    pos[i] = vec4<f32>(pos[i].xyz, v_abs + d_v);
