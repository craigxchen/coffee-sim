    }

    var rho = m * f_i * w_poly6(0.0, h);
    var sum_g = vec3<f32>(0.0);
    var sum_g2 = 0.0;

    let base = cell_coord(xi);
    for (var dz = -1; dz <= 1; dz = dz + 1) {
