    var geom_blocked = false;
    if (any(center < params.box_min.xyz) || any(center > params.box_max.xyz)) {
        f = 0.0;
        geom_blocked = true;
    }
    if (!geom_blocked && params.num_solids > 0u) {
        let hit = solid_union(center, PHASE_WATER);
