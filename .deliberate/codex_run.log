                }

                pass(&mut enc, &p.finalize, &b.finalize, "finalize", np);

                // XSPH viscosity is a fluid term; runs only when water is present.
                if self.has_water {
                    pass(&mut enc, &p.xsph, &b.xsph, "xsph", np);
                    enc.copy_buffer_to_buffer(
                        &self.vel_smoothed,
