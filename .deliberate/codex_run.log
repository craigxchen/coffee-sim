                                &p.exclude_water,
                                &b.exclude_water,
                                "exclude_water",
                                np,
                            );
                            pass(
                                &mut enc,
                                &p.exclude_grain,
                                &b.exclude_grain,
                                "exclude_grain",
                                np,
                            );
                        }
