    57	
    58	    /// Request the device/queue (shared by both constructors). NOTE: `pollster::block_on` is
    59	    /// native-only; under WASM this step awaits the JS event loop instead.
    60	    fn from_adapter(instance: Instance, adapter: Adapter) -> Option<Self> {
    61	        let timestamps_supported = adapter.features().contains(wgpu::Features::TIMESTAMP_QUERY);
    62	        let required_features = if timestamps_supported {
    63	            wgpu::Features::TIMESTAMP_QUERY
    64	        } else {
    65	            wgpu::Features::empty()
    66	        };
