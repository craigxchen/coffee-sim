    68	        let (device, queue) = pollster::block_on(adapter.request_device(&wgpu::DeviceDescriptor {
    69	            label: Some("coffee-sim device"),
    70	            required_features,
    71	            // WebGPU baseline. Do NOT raise max_storage_buffers_per_shader_stage above 8
    72	            // (v1's mistake) — it must stay portable to the browser.
    73	            required_limits: wgpu::Limits::default(),
    74	            memory_hints: wgpu::MemoryHints::Performance,
    75	            trace: wgpu::Trace::default(),
    76	            experimental_features: wgpu::ExperimentalFeatures::disabled(),
    77	        }))
    78	        .ok()?;
    79	
    80	        Some(Self {
    81	            instance,
    82	            adapter,
    83	            device,
    84	            queue,
