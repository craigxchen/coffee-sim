     1	//! GPU device/queue context shared by every block.
     2	
     3	use std::sync::Arc;
     4	
     5	use wgpu::{Adapter, Device, Instance, Queue};
     6	
     7	/// Wraps the `wgpu` device + queue and the data needed to create resources.
     8	///
     9	/// Targets the **WebGPU-guaranteed baseline limits** (`wgpu::Limits::default()`) even on
    10	/// native, so the storage-buffer binding ceiling (8 per stage) that broke v1's DFSPH path
    11	/// on the browser bites here first — we never silently exceed what WebGPU guarantees (v1
    12	/// raised `max_storage_buffers_per_shader_stage` to 10). Requests `TIMESTAMP_QUERY` only
    13	/// when the adapter advertises it. Headless for now: no surface (rendering arrives with
    14	/// `ui`). The same code path compiles to WASM + WebGPU later — only the async init below
    15	/// is native-specific (`pollster::block_on`).
    16	pub struct GpuContext {
    17	    pub instance: Instance,
    18	    pub adapter: Adapter,
    19	    pub device: Device,
    20	    pub queue: Queue,
    21	    /// Whether per-pass `timestamp-query` profiling is available on this device.
    22	    pub timestamps_supported: bool,
    23	}
    24	
    25	impl GpuContext {
    26	    /// Build a headless context. Returns `None` when no adapter is available (e.g. CI
    27	    /// without a GPU) so callers can skip GPU work gracefully instead of failing.
    28	    pub fn new_headless() -> Option<Self> {
    29	        let instance = Instance::default();
    30	        let adapter = pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
    31	            power_preference: wgpu::PowerPreference::HighPerformance,
    32	            force_fallback_adapter: false,
    33	            compatible_surface: None,
    34	        }))
    35	        .ok()?;
    36	        Self::from_adapter(instance, adapter)
    37	    }
    38	
    39	    /// Build a context for an on-screen window and return the matching surface. The adapter
    40	    /// is chosen as surface-compatible; the **solver and renderer share this one context** so
    41	    /// the renderer can read the solver's particle buffers. The caller owns the surface (it
    42	    /// configures/presents). Returns `None` if no adapter/device is available.
    43	    pub fn new_windowed(
    44	        window: Arc<winit::window::Window>,
    45	    ) -> Option<(Self, wgpu::Surface<'static>)> {
    46	        let instance = Instance::default();
    47	        let surface = instance.create_surface(window).ok()?;
    48	        let adapter = pollster::block_on(instance.request_adapter(&wgpu::RequestAdapterOptions {
    49	            power_preference: wgpu::PowerPreference::HighPerformance,
    50	            force_fallback_adapter: false,
    51	            compatible_surface: Some(&surface),
    52	        }))
    53	        .ok()?;
    54	        let ctx = Self::from_adapter(instance, adapter)?;
