+#[test]
+fn brew_populates_finite_yield_and_tds() {
+    let Some(gpu) = GpuContext::new_headless() else {
+        eprintln!("xpbd_extraction: no GPU adapter; skipping.");
+        return;
+    };
+    // Calibrated permeable V60 bed (SDF phase) + wetting + extraction on.
