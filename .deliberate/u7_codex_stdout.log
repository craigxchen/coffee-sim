+    let phase = solver.read_phases();
+    for _ in 0..150 {
+        solver.step(DT, &EmissionInput::default());
+    }
+    solver.sample_diagnostics();
+    let m = solver.metrics();
+
+    assert!(
+        m.extraction_yield.is_finite() && m.extraction_yield > 0.0,
+        "yield not populated: {}",
