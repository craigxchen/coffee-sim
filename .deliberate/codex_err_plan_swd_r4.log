    74	    // scatters proportionally less mass/volume (models::wetting::water_eff_mass), so the bed
    75	    // pore volume falls exactly as water is absorbed — the projection sees the real remaining
    76	    // fluid. With absorption off f_w ≡ 1 and this is bit-identical to the U2 constant mass.
    77	    let m = params.particle_mass * clamp(pos[p].w, 0.0, 1.0);
    78	
    79	    // Particle-presence census for the surface classification (see cell_cnt in common.wgsl).
    80	    let ci = clamp(
    81	        vec3<i32>(floor(xl)),
    82	        vec3<i32>(0),
    83	        vec3<i32>(params.grid_dims.xyz) - vec3<i32>(2),
    84	    );
    85	    atomicAdd(&cell_cnt[cell_index(ci)], 1u);
    86	
    87	    for (var k = 0; k < 3; k = k + 1) {
    88	        for (var j = 0; j < 3; j = j + 1) {
    89	            for (var i = 0; i < 3; i = i + 1) {
    90	                let wijk = w[i].x * w[j].y * w[k].z;
    91	                let node = base + vec3<i32>(i, j, k);
    92	                let d = (vec3<f32>(node) - xl) * h; // x_i − x_p (world units)
    93	                var vaff = v + vec3<f32>(dot(c0, d), dot(c1, d), dot(c2, d));
    94	                // Clamp the scattered magnitude to the velocity cap — this is what makes the
    95	                // FP_SCALE momentum-headroom bound in common.wgsl hold by construction.
    96	                let s = length(vaff);
    97	                if (s > params.max_speed) {
    98	                    vaff = vaff * (params.max_speed / s);
    99	                }
   100	                let idx = node_index(node) * 4u;
   101	                atomicAdd(&grid_fp[idx + 0u], fp_encode(m * wijk));
   102	                atomicAdd(&grid_fp[idx + 1u], fp_encode(m * wijk * vaff.x));
   103	                atomicAdd(&grid_fp[idx + 2u], fp_encode(m * wijk * vaff.y));
   104	                atomicAdd(&grid_fp[idx + 3u], fp_encode(m * wijk * vaff.z));
   105	            }
   106	        }
   107	    }
   108	}
   109	
   110	// Convert fixed-point mass/momentum to velocity. Gravity, the U6 drag fold, the grid-node
   111	// boundary treatment, and the speed-cap backstop all live in drag_fold (coupling.wgsl) —
   112	// the exponential fold must integrate the gravity source itself and the BCs must follow
   113	// every velocity update, so this pass is decode-only. Empty nodes get zero velocity.
   114	@compute @workgroup_size(256)
   115	fn grid_update(@builtin(global_invocation_id) gid: vec3<u32>) {
   116	    let n = gid.x;
   117	    if (n >= params.grid_dims.w) {
   118	        return;
   119	    }
   120	    let mc = atomicLoad(&grid_fp[n * 4u + 0u]);
   121	    var v = vec3<f32>(0.0);
   122	    // Mass gate (couples to drag_fold's cap backstop): nodes below mass_eps (params.extra.z,
   123	    // ~26 fixed-point counts) decode a quantization-noise velocity AND are exactly the nodes
   124	    // the U3 projection cannot correct (M̃⁻¹ = 0 below the same eps in node_setup) — giving
   125	    // them gravity every frame injects uncorrectable free-fall the surface particles gather
   126	    // via G2P. They are treated as empty here (v = 0), consistently with the whole pressure
   127	    // family (cell fractions, M̃⁻¹). The decoded mass is still written for diagnostics.
   128	    if (fp_decode(mc) > params.extra.z) {
   129	        let inv = 1.0 / f32(mc);
   130	        v = vec3<f32>(
   131	            f32(atomicLoad(&grid_fp[n * 4u + 1u])),
   132	            f32(atomicLoad(&grid_fp[n * 4u + 2u])),
   133	            f32(atomicLoad(&grid_fp[n * 4u + 3u]))
   134	        ) * inv;
   135	    }
   136	    grid_vel[n] = vec4<f32>(v, fp_decode(mc));
   137	}
   138	
   139	// APIC gather: new particle velocity + new affine C from the grid field, then advection and the
   140	// particle-resolution boundary backstop. C = B·D⁻¹ with B = Σ w·v_i·dᵀ and D = (h²/4)·I for the
   141	// quadratic B-spline (Jiang et al. APIC) — equivalent to a weight-gradient velocity-derivative
   142	// reconstruction, in the cheap D⁻¹ form.
   143	// --- PROTOTYPE: state-dependent ballistic/FLIP preservation (best-of-main+xpbd) -------------
   144	// Free/airborne water keeps its own momentum (splash); water merging into the dense pool defers
   145	// to the grid (dissipate → no cup blow-up). Keyed on LOCAL GRID DENSITY (pool-merging), NOT
   146	// main's support_ratio (which mis-fires on sparse drips). Exploratory consts; the shipped
   147	// version moves these to Params behind a Config knob.
   148	const FLIP_PROTO: bool = true;
   149	const PRESERVE_MAX: f32 = 0.9; // max ballistic fraction for fully-free water
   150	const DENS_LO: f32 = 0.15;     // local cell-fill below this ⇒ fully free (max preserve)
   151	const DENS_HI: f32 = 0.55;     // above this ⇒ pooled/dense: defer to grid (no preserve)
   152	
   153	@compute @workgroup_size(256)
   154	fn g2p_water(@builtin(global_invocation_id) gid: vec3<u32>) {
   155	    let p = gid.x;
   156	    if (p >= params.water_count) {
   157	        return;
   158	    }
   159	    let h = params.grid_origin.w;
   160	    var x = pos[p].xyz;
   161	
   162	    // Open base (U6 drained-flux mode): escaped particles fall ballistically — they no
   163	    // longer scatter (p2g guard), so gathering from the empty grid would freeze them.
   164	    let open_base = params.coupling.w > 0.5;
   165	    if (open_base && x.y < params.box_min.y) {
   166	        var v = vel[p].xyz + params.gravity.xyz * params.dt;
   167	        x = x + v * params.dt;
   168	        pos[p] = vec4<f32>(x, pos[p].w);
   169	        vel[p] = vec4<f32>(v, vel[p].w);
   170	        cmat[3u * p + 0u] = vec4<f32>(0.0);
   171	        cmat[3u * p + 1u] = vec4<f32>(0.0);
   172	        cmat[3u * p + 2u] = vec4<f32>(0.0);
   173	        return;
   174	    }
   175	
   176	    let xl = (x - params.grid_origin.xyz) / h;
   177	    var base = vec3<i32>(floor(xl - vec3<f32>(0.5)));
   178	    base = clamp(base, vec3<i32>(0), vec3<i32>(params.grid_dims.xyz) - vec3<i32>(3));
   179	    let fx = xl - vec3<f32>(base);
   180	    var w = bspline_w(fx);
   181	
   182	    var v = vec3<f32>(0.0);
   183	    var m_local = 0.0; // PROTOTYPE: local grid (water) mass support → density signal
   184	    var b0 = vec3<f32>(0.0); // rows of B = Σ w·v_i·dᵀ
   185	    var b1 = vec3<f32>(0.0);
   186	    var b2 = vec3<f32>(0.0);
   187	    for (var k = 0; k < 3; k = k + 1) {
   188	        for (var j = 0; j < 3; j = j + 1) {
   189	            for (var i = 0; i < 3; i = i + 1) {
   190	                let wijk = w[i].x * w[j].y * w[k].z;
   191	                let node = base + vec3<i32>(i, j, k);
   192	                let d = (vec3<f32>(node) - xl) * h;
   193	                let gvw = grid_vel[node_index(node)];
   194	                let gv = gvw.xyz;
   195	                v = v + wijk * gv;
   196	                m_local = m_local + wijk * gvw.w;
   197	                b0 = b0 + (wijk * gv.x) * d;
   198	                b1 = b1 + (wijk * gv.y) * d;
   199	                b2 = b2 + (wijk * gv.z) * d;
   200	            }
   201	        }
   202	    }
   203	    let dinv = 4.0 / (h * h);
   204	    // APIC↔PIC blend knob: scale the affine C by (1 − pic_blend) each transfer (the gathered
   205	    // velocity stays full APIC; the FLIP/PIC distinction lives entirely in C). A small blend (the
   206	    // production default) is the SHIPPED settled-pool stirring fix — it bleeds off the spurious
   207	    // affine ringing that re-energizes a settled pool. It is safe to apply globally because the
   208	    // crater gate now asserts the wet bed HOLDS its poured crater (wet-sand plasticity), so the
   209	    // blend "freezing" the crater is the correct outcome, not a regression (see PIC_BLEND_DEFAULT /
   210	    // twofield_full.rs). pic_blend = 1 ⇒ pure PIC (the APIC-vs-PIC discrimination gate).
   211	    let apic_keep = 1.0 - params.pic_blend;
   212	    var c0 = b0 * (dinv * apic_keep);
   213	    var c1 = b1 * (dinv * apic_keep);
   214	    var c2 = b2 * (dinv * apic_keep);
   215	
   216	    // PROTOTYPE: blend the grid-gathered (PIC) velocity toward the particle's own ballistic
   217	    // momentum where water is free/sparse; defer fully to the grid where it's pooled/dense.
   218	    if (FLIP_PROTO) {
   219	        let v_bal = vel[p].xyz + params.gravity.xyz * params.dt;
   220	        let m_ref = params.particle_mass * 8.0; // ~rest-packed cell (8 ppc)
   221	        let dens = clamp(m_local / max(m_ref, 1e-8), 0.0, 1.0);
   222	        let preserve = PRESERVE_MAX * (1.0 - smoothstep(DENS_LO, DENS_HI, dens));
   223	        v = mix(v, v_bal, preserve);
   224	        let affine_damp = 1.0 - preserve * 0.75;
   225	        c0 = c0 * affine_damp;
   226	        c1 = c1 * affine_damp;
   227	        c2 = c2 * affine_damp;
   228	    }
   229	
   230	    // Velocity cap backstop (anti-blow-up; the other half of the FP headroom contract).
   231	    let s = length(v);
   232	    if (s > params.max_speed) {
   233	        v = v * (params.max_speed / s);
   234	    }
   235	
   236	    x = x + v * params.dt;
   237	
   238	    // Particle-resolution boundary backstop (mirrors the xpbd finalize conventions: box clamp +
   239	    // SDF push-out along the cavity gradient; SDF math mirrors utils/sdf.rs). The grid-node BC
   240	    // above is the momentum treatment, but on its own it bounds penetration only at node
   241	    // resolution (h = 2·spacing): a particle between a constrained node layer and a live one
   242	    // keeps a weighted inward velocity fraction and creeps through. The push-out enforces the
   243	    // non-penetration gate at particle resolution; only the into-wall velocity component is
   244	    // removed (separating, free slip).
   245	    if (x.x < params.box_min.x) { x.x = params.box_min.x; if (v.x < 0.0) { v.x = 0.0; } }
   246	    if (x.y < params.box_min.y && !open_base) { x.y = params.box_min.y; if (v.y < 0.0) { v.y = 0.0; } }
   247	    if (x.z < params.box_min.z) { x.z = params.box_min.z; if (v.z < 0.0) { v.z = 0.0; } }
   248	    if (x.x > params.box_max.x) { x.x = params.box_max.x; if (v.x > 0.0) { v.x = 0.0; } }
   249	    if (x.y > params.box_max.y) { x.y = params.box_max.y; if (v.y > 0.0) { v.y = 0.0; } }
   250	    if (x.z > params.box_max.z) { x.z = params.box_max.z; if (v.z > 0.0) { v.z = 0.0; } }

