    25	mod common;
    26	
    27	use coffee_sim::engine::scene::{SeedRegion, Species};
    28	use coffee_sim::engine::Scene;
    29	use coffee_sim::models::Materials;
    30	use coffee_sim::solvers::base::Solver;
    31	use coffee_sim::solvers::twofield::{TwofieldSolver, FP_SCALE};
    32	use coffee_sim::utils::config::Config;
    33	use coffee_sim::utils::gpu::GpuContext;
    34	use coffee_sim::utils::rng::Rng;
    35	use coffee_sim::utils::sdf;
    36	use coffee_sim::EmissionInput;
    37	
    38	use common::{assert_close3, continuous_reference, freefall_reference};
    39	
    40	const DT: f32 = 1.0 / 60.0;
    41	const SPACING: f32 = 1.0; // Materials::default().particle_spacing
    42	
    43	// Round-off budgets for the free-fall gate (NOT physics bands). Error sources per frame:
    44	// fixed-point quantization of the node momentum/mass (≤ 0.5 counts per contribution against
    45	// node masses of ~10⁵ counts → per-step velocity error ~1e-5) and f32 round-off in the
    46	// transfers. Accumulated linearly over 120 frames that stays ≤ ~2e-3; the budgets carry ~10×
    47	// headroom and sit ~10× below the ≈0.33 discrete-vs-continuous discrimination gap.
