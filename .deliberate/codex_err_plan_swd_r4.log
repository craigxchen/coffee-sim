   272	/// APIC vs PIC discrimination: a rigidly rotating blob (v = ω × r with the matching affine C)
   273	/// retains its angular momentum materially better under APIC than under the PIC variant
   274	/// (C zeroed each step). The gate asserts the GAP, not absolutes.
   275	#[test]
   276	fn apic_retains_angular_momentum_better_than_pic() {
   277	    let Some(gpu) = GpuContext::new_headless() else {
   278	        eprintln!("twofield_water: no GPU adapter; skipping.");
   279	        return;
   280	    };
   281	    const OMEGA: f32 = 1.5; // about +y; edge speed ≈ 6.6 ≪ the cap
   282	    const STEPS: u32 = 60;
   283	    let scene = water_scene([0.0; 3], [32.0; 3], [0.0; 3], [13.0; 3], [19.0; 3]); // 7³ blob
   284	    let cfg = Config::default();
   285	    let mut solver = TwofieldSolver::build(&scene, &Materials::default(), &cfg, &gpu);
   286	    let seed = solver.read_positions();
   287	    let n = seed.len();
   288	    let center = mass_center(&seed);
   289	
   290	    let seed_rotation = |solver: &TwofieldSolver| {
   291	        let mut vels = Vec::with_capacity(n);
   292	        let mut rows = Vec::with_capacity(3 * n);
   293	        for p in &seed {
   294	            let r = [p[0] - center[0], p[2] - center[2]];
   295	            vels.push([OMEGA * r[1], 0.0, -OMEGA * r[0], 0.0]);
   296	        }
   297	        for _ in 0..n {
   298	            // C = ∂v/∂x for v = ω×r about y: rows (0,0,ω), (0,0,0), (−ω,0,0).
   299	            rows.push([0.0, 0.0, OMEGA, 0.0]);
   300	            rows.push([0.0, 0.0, 0.0, 0.0]);
   301	            rows.push([-OMEGA, 0.0, 0.0, 0.0]);
   302	        }
   303	        solver.write_velocities_for_test(&vels);
   304	        solver.write_affine_for_test(&rows);
   305	    };
   306	    let run = |solver: &mut TwofieldSolver| -> f64 {
   307	        seed_rotation(solver);
   308	        let l0 = angular_momentum_y(&solver.read_positions(), &solver.read_velocities());
   309	        assert!(l0 > 1.0, "seeded rotation has angular momentum");
   310	        for _ in 0..STEPS {
   311	            solver.step(DT, &EmissionInput::default());
   312	        }
   313	        angular_momentum_y(&solver.read_positions(), &solver.read_velocities()) / l0
   314	    };
   315	
   316	    solver.set_pic_for_test(false); // pure APIC arm (override the small production PIC blend)
   317	    let apic_retention = run(&mut solver);
   318	    solver.reset(&scene);
   319	    solver.set_pic_for_test(true);
   320	    let pic_retention = run(&mut solver);
   321	    println!(
   322	        "twofield U2 APIC gate: L_y retention over {STEPS} steps — APIC {apic_retention:.3}, PIC {pic_retention:.3}"
   323	    );
   324	    // Measured on Apple M5: APIC ≈ 1.15, PIC ≈ 0.00. APIC retention slightly ABOVE 1 is the
   325	    // explicit forward-Euler advection spiraling the blob's radius outward per step (×≈1+½(ωdt)²)
   326	    // while the affine field keeps v = ω×r — L grows with r. Bounded (the soak gate covers
   327	    // long-run stability); the gate asserts the APIC-vs-PIC gap, not absolutes.
   328	    assert!(
   329	        apic_retention > pic_retention + 0.2,
   330	        "APIC must retain materially more angular momentum than PIC \
   331	         (APIC {apic_retention:.3} vs PIC {pic_retention:.3})"
   332	    );
   333	}
   334	
   335	/// Fixed-point overflow probe: a pancaked (worst-case clustered) block with every particle at
   336	/// the velocity cap stays finite and bounded, the grid totals show no i32 wrap, and the
   337	/// measured per-lane headroom is reported. Headroom math: see `FP_SCALE` in `common.wgsl` —
   338	/// the scatter clamp bounds momentum counts by (Σ m·w)·max_speed·2^18, overflow needs ≈164
   339	/// mass units on one node (≈20× rest compression at the cap).
   340	#[test]
   341	fn fixed_point_overflow_probe_at_velocity_cap() {
   342	    let Some(gpu) = GpuContext::new_headless() else {
   343	        eprintln!("twofield_water: no GPU adapter; skipping.");
   344	        return;
   345	    };
   346	    let scene = water_scene(
   347	        [0.0; 3],
   348	        [24.0; 3],
   349	        [0.0, -20.0, 0.0],
   350	        [7.0, 1.0, 7.0],
   351	        [16.0, 10.0, 16.0], // 10³ = 1000 particles dropped low
   352	    );
   353	    let cfg = Config::default();
   354	    let mut solver = TwofieldSolver::build(&scene, &Materials::default(), &cfg, &gpu);
   355	    let n = solver.read_positions().len();
   356	    let input = EmissionInput::default();
   357	    // Pancake the block on the floor — pressureless U2 water compacts, which IS the worst-case
   358	    // clustering for a node's mass loading.
   359	    for _ in 0..300 {
   360	        solver.step(DT, &input);
   361	    }
   362	    // Slam every particle at the velocity cap into the cluster.
   363	    let cap = cfg.max_speed;
   364	    solver.write_velocities_for_test(&vec![[0.0, -cap, 0.0, 0.0]; n]);
   365	    for _ in 0..3 {
   366	        solver.step(DT, &input);
   367	    }
   368	
   369	    let pos = solver.read_positions();
   370	    let vel = solver.read_velocities();
   371	    assert!(all_finite(&pos) && all_finite(&vel), "non-finite state");
   372	    for v in &vel {
   373	        let s = (v[0] * v[0] + v[1] * v[1] + v[2] * v[2]).sqrt();
   374	        assert!(s <= cap + 1e-3, "speed {s} above the cap");
   375	    }
   376	    // No wrap: an overflowed lane would corrupt the totals far beyond the rounding bound.
   377	    let (mass, _) = solver.read_grid_mass_momentum();
   378	    let bound = n as f64 * 27.0 * 0.5 / FP_SCALE;
   379	    assert!(
   380	        mass > 0.0,
   381	        "grid carries mass (discriminates the inert scaffold)"
   382	    );
   383	    assert!(
   384	        (mass - n as f64).abs() <= bound,
   385	        "grid mass {mass} vs {n} (bound {bound}) — fixed-point lane wrapped?"
   386	    );
   387	    let max_count = solver.read_grid_max_count();
   388	    let headroom = i32::MAX as f64 / max_count as f64;
   389	    println!(
   390	        "twofield U2 overflow probe: max |lane| {max_count} counts, headroom {headroom:.1}× at the cap"
   391	    );
   392	    assert!(
   393	        headroom >= 2.0,
   394	        "fixed-point headroom collapsed: {headroom:.2}×"
   395	    );
   396	}
