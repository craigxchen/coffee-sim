   821	            mass as f64 / FP_SCALE,
   822	            [
   823	                mom[0] as f64 / FP_SCALE,
   824	                mom[1] as f64 / FP_SCALE,
   825	                mom[2] as f64 / FP_SCALE,
   826	            ],
   827	        )
   828	    }
