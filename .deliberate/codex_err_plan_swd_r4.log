  1061	    /// and `water_count` grows. No-ops when not pouring and no backlog remains.
  1062	    fn emit(&mut self, input: &EmissionInput, dt: f32) {
  1063	        // A Reset event clears the emitter's backlog/credit (the emitter contract; a full
  1064	        // sim restart is `reset()`). Done before the gate so a Reset with zero flow clears.
  1065	        if input.event == crate::emission::PourEvent::Reset {
  1066	            self.inflow.accumulator = 0.0;
  1067	            self.inflow.axial = 0.0;
  1068	            self.inflow.last_exit_speed = 0.0;
  1069	        }
  1070	        let flow = input.flow_rate.max(0.0);
  1071	        // Gate: pour active, or a whole particle of backlog still to drain.
  1072	        if flow <= 0.0 && self.inflow.accumulator < 1.0 {
  1073	            return;
  1074	        }
  1075	        let a_eff = std::f32::consts::PI
  1076	            * self.inflow.nozzle_radius
  1077	            * self.inflow.nozzle_radius
  1078	            * self.inflow.discharge_coeff;
  1079	        let a_eff = a_eff.max(1.0e-9);
  1080	        // Orifice relation: exit speed from flow + effective area. While draining a backlog
  1081	        // at zero flow, keep the last cadence so the stream tail stays correctly spaced.
  1082	        let exit_speed = if flow > 0.0 {
  1083	            let es = flow / a_eff;
  1084	            self.inflow.last_exit_speed = es;
  1085	            self.inflow.accumulator += flow / self.inflow.v_w * dt;
  1086	            es
  1087	        } else {
  1088	            self.inflow.last_exit_speed
  1089	        };
  1090	        if exit_speed <= 0.0 {
  1091	            return;
  1092	        }
  1093	        // Volume-consistent layer capacity (ceil ⇒ throughput ≥ flow/V_w, no backlog).
  1094	        let n_layer = ((a_eff * self.inflow.spacing / self.inflow.v_w).ceil() as u32).max(1);
  1095	
  1096	        // Pour direction (downward, tilted by pour_angle toward +x) + a disc basis.
  1097	        let a = input.pour_angle;
  1098	        let dir = [a.sin(), -a.cos(), 0.0];
  1099	        let (u, w) = disc_basis(dir);
  1100	        let r_eff = self.inflow.nozzle_radius * self.inflow.discharge_coeff.sqrt();
  1101	        const GOLDEN: f32 = 2.399_963_2;
  1102	
  1103	        self.inflow.axial += exit_speed * dt;
  1104	        let kettle = input.kettle_pos;
  1105	        let mut want = self.inflow.accumulator.floor() as u32;
  1106	        let mut new_pos: Vec<[f32; 4]> = Vec::new();
  1107	        let mut new_vel: Vec<[f32; 4]> = Vec::new();
  1108	        let mut new_chem: Vec<[f32; 4]> = Vec::new();
  1109	        let mut clamped = false;
  1110	        while self.inflow.axial >= self.inflow.spacing && want > 0 {
  1111	            // Capacity check BEFORE spending arclength credit, so a full pool doesn't
  1112	            // silently consume a layer's axial.
  1113	            let avail = self.water_capacity - (self.water_count + new_pos.len() as u32);
  1114	            if avail == 0 {
  1115	                clamped = true;
  1116	                break;
  1117	            }
  1118	            self.inflow.axial -= self.inflow.spacing;
  1119	            let depth = self.inflow.axial; // residual stream travel below the nozzle
  1120	            let this_layer = n_layer.min(want).min(avail);
  1121	            for _ in 0..this_layer {
  1122	                // Radial shell cycles with the cursor (mod N_layer) so partial layers still
  1123	                // cover the whole disc over time; golden angle fills it uniformly.
  1124	                let ri = (self.inflow.cursor % n_layer as u64) as f32;
  1125	                let r = r_eff * ((ri + 0.5) / n_layer as f32).sqrt();
  1126	                let theta = self.inflow.cursor as f32 * GOLDEN;
  1127	                self.inflow.cursor += 1;
  1128	                let (ct, st) = (theta.cos(), theta.sin());
  1129	                let off = [
  1130	                    u[0] * r * ct + w[0] * r * st,
  1131	                    u[1] * r * ct + w[1] * r * st,
  1132	                    u[2] * r * ct + w[2] * r * st,
  1133	                ];
  1134	                new_pos.push([
  1135	                    kettle[0] + dir[0] * depth + off[0],
  1136	                    kettle[1] + dir[1] * depth + off[1],
  1137	                    kettle[2] + dir[2] * depth + off[2],
  1138	                    1.0, // moisture lane: full water
  1139	                ]);
  1140	                new_vel.push([
  1141	                    dir[0] * exit_speed,
  1142	                    dir[1] * exit_speed,
  1143	                    dir[2] * exit_speed,
  1144	                    0.0,
  1145	                ]);
  1146	                new_chem.push([0.0, self.inflow.pour_t, 0.0, 0.0]); // c = 0, T = pour temp
  1147	            }
  1148	            want -= this_layer;
  1149	        }
  1150	        if clamped {
  1151	            eprintln!(
  1152	                "twofield pour: water pool {} reached; emission clamped (a recipe scene must \
  1153	                 declare enough pour_water_ml to size the pool to its dose)",
  1154	                self.water_capacity
  1155	            );
  1156	        }
  1157	        let emit_n = new_pos.len() as u32;
  1158	        if emit_n == 0 {
  1159	            return;
  1160	        }
  1161	        // Clamp-before-decrement: subtract only what was actually emitted — unspent budget
  1162	        // stays as backlog rather than being silently burned.
  1163	        self.inflow.accumulator -= emit_n as f32;
  1164	        self.inflow.emitted_mass += emit_n as f32 * self.params.particle_mass;
  1165	        let off_v4 = (self.water_count as u64) * 16;
  1166	        self.queue
  1167	            .write_buffer(&self.pos, off_v4, bytemuck::cast_slice(&new_pos));
  1168	        self.queue
  1169	            .write_buffer(&self.vel, off_v4, bytemuck::cast_slice(&new_vel));
  1170	        self.queue
  1171	            .write_buffer(&self.chem, off_v4, bytemuck::cast_slice(&new_chem));
  1172	        // Phase tags of dormant pool slots are already 0 (water) and the APIC C rows are
  1173	        // zero (each slot is activated at most once per run; reset re-zeroes them).
  1174	        self.water_count += emit_n;
  1175	        self.params.water_count = self.water_count;
  1176	    }
