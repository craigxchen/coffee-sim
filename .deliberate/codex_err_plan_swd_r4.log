    85	/// Free-fall: a small water block far from any wall matches the solver's own discrete
    86	/// recurrence (derived in the header comment) within the documented f32 budget over 120
    87	/// frames, and is discriminably DIFFERENT from the continuous ½gt² form.
    88	#[test]
    89	fn freefall_matches_discrete_recurrence_not_continuous() {
    90	    let Some(gpu) = GpuContext::new_headless() else {
    91	        eprintln!("twofield_water: no GPU adapter; skipping.");
    92	        return;
    93	    };
