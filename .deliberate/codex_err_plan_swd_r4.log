    49	const VEL_ABS_TOL: f64 = 2e-2;
    50	const REL_TOL: f64 = 1e-5;
    51	
    52	fn water_scene(
    53	    box_min: [f32; 3],
    54	    box_max: [f32; 3],
    55	    gravity: [f32; 3],
    56	    rmin: [f32; 3],
    57	    rmax: [f32; 3],
    58	) -> Scene {
    59	    Scene {
    60	        gravity,
    61	        box_min,
    62	        box_max,
    63	        regions: vec![SeedRegion {
    64	            min: rmin,
    65	            max: rmax,
    66	            species: Species::Water,
    67	        }],
