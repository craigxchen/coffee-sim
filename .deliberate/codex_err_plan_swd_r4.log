   799	    /// Raw fixed-point grid totals `(mass_counts, momentum_counts)` summed in i64 — exact
   800	    /// integer sums, so two scatters of the same state are bit-identical (dev/test only).
   801	    /// Valid after `step()`: the grid holds that frame's P2G result until the next frame's
   802	    /// `grid_clear`.
   803	    pub fn read_grid_counts(&self) -> (i64, [i64; 3]) {
   804	        let bytes = (self.num_nodes as u64) * 16;
   805	        let raw: Vec<i32> = bytemuck::cast_slice(&self.read_bytes(&self.grid_fp, bytes)).to_vec();
   806	        let mut mass = 0i64;
   807	        let mut mom = [0i64; 3];
   808	        for n in raw.chunks_exact(4) {
   809	            mass += n[0] as i64;
   810	            mom[0] += n[1] as i64;
   811	            mom[1] += n[2] as i64;
   812	            mom[2] += n[3] as i64;
   813	        }
   814	        (mass, mom)
   815	    }
