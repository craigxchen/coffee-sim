    // ρ₀·(1−min(α_s, 1−ε_floor)), so pore water fills only the available pore fraction while a
    // packed-bed floor prevents over-packing into solid volume.
    let pore = 1.0 - min(alpha_s[i], 1.0 - params.min_pore_fraction);
